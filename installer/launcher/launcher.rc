// Resources of the release launcher "Project Pyrrhus.exe" (from Project Helghast installer/launcher/launcher.rc).
// The icon is generated by tools/release/installer_art.py into installer/art/; build_launcher.sh passes that folder
// with --include-dir. Version strings are plain text (no game names beyond the port's title).
// launcher_version.h is written by build_launcher.sh from installer/VERSION (tools/release/release_version.py): the
// one version of the release.
#include <winver.h>
#include "launcher_version.h"

1 ICON "kz2-launcher.ico"

1 VERSIONINFO
FILEVERSION KZ2_VER_COMMA
PRODUCTVERSION KZ2_VER_COMMA
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Project Pyrrhus contributors"
      VALUE "FileDescription", "Project Pyrrhus launcher (Killzone 2 PC port)"
      VALUE "FileVersion", KZ2_VER_STR
      VALUE "InternalName", "launcher"
      VALUE "OriginalFilename", "Project Pyrrhus.exe"
      VALUE "ProductName", "Project Pyrrhus"
      VALUE "ProductVersion", KZ2_VER_STR
      VALUE "Comments", "https://github.com/undecuple/project-pyrrhus"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

+/* KZ3 patch 2045: srv_table memo. A draw's 16-slot SRV table was copied into the shader-visible ring
+ * (CopyDescriptors) for every draw; consecutive draws of one material carry the same slots. The memo keeps the
+ * last LD_SRVTBL_MEMO tables (slots -> ring base) and hands the GPU handle back when the slots and the
+ * descriptor generation match. g_srv_desc_gen advances whenever any SRV descriptor is (re)written
+ * (ld_create_srv: a texture re-decoded into a new resource, a surface or zeta view recreated) and whenever the
+ * ring is reset (its bases are reused), so a memo hit always names a table whose 16 copied descriptors are
+ * the ones srv_cpu(slot) holds now. LD_NO_SRVTBL_MEMO=1 turns it off (A/B). */
+/* KZ3 patch 2045: per-list render-state memo. Every draw re-issued OMSetRenderTargets, SetDescriptorHeaps,
+ * SetGraphicsRootSignature and SetPipelineState; with the same arguments D3D12 makes them no-ops, so the walker
+ * skips them when nothing changed since the last draw on this command list. g_ld_sm_gen advances at every list
+ * Reset, at the compute paths that bind their own PSO/heaps (depth snapshot, host AA) and whenever an RTV/DSV
+ * descriptor is rewritten (OMSetRenderTargets consumes the descriptor at call time). LD_NO_STATE_MEMO=1 off. */
+static struct { u32 gen; ID3D12PipelineState* pso; ID3D12DescriptorHeap* h0; ID3D12DescriptorHeap* h1; int rootsig;
+                u32 n_mrt; SIZE_T rtv[4]; SIZE_T dsv; int have_dsv; } g_ld_sm;
+static u32 g_ld_sm_gen = 1;
+#define LD_SM_INVALIDATE() ((void)g_ld_sm_gen++)
+static int ld_state_memo_on(void)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("LD_NO_STATE_MEMO") ? 0 : 1;
+    return on;
+}
+/* KZ3 patch 2045: texture units the current fragment program never samples (patch 2042's mask) get no SRV and

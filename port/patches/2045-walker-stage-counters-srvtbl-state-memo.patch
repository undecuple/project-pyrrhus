+/* KZ3 patch 2045 diagnostic (RSX_PERF window only): which textures get re-decoded, by source. */
+#define LD_RD_N 128
+typedef struct { u32 location, offset, w, h, fmt, span; u64 n, bytes; } ld_rd_t;
+static ld_rd_t g_ld_rd[3][LD_RD_N];   /* 0 = re-decodes, 1 = hashes, 2 = new cache entries */
+static u32 g_ld_rd_n[3];
+static void ld_redecode_note(int which, const rsx_dsp_texture* t, u32 span)
+{
+    if (!rsx_perf_walk_on()) return;
+    ld_rd_t* r = g_ld_rd[which]; u32* n = &g_ld_rd_n[which];
+    for (u32 i = 0; i < *n; i++)
+        if (r[i].location == t->location && r[i].offset == t->offset) { r[i].n++; r[i].bytes += span; return; }
+    if (*n < LD_RD_N) {
+        r[*n].location = t->location; r[*n].offset = t->offset; r[*n].w = t->width; r[*n].h = t->height;
+        r[*n].fmt = t->format; r[*n].span = span; r[*n].n = 1; r[*n].bytes = span; (*n)++;
+    }
+}
+void rsx_live_draw_perf_dump(void)   /* the reporter, when the RSX_PERF_PROF window closes */
+{
+    for (int which = 0; which < 3; which++) {
+        ld_rd_t* r = g_ld_rd[which]; const u32 n = g_ld_rd_n[which];
+        const char* tag = which == 0 ? "redecode" : which == 1 ? "hash" : "newtex";
+        u64 total = 0, bytes = 0;
+        for (u32 i = 0; i < n; i++) { total += r[i].n; bytes += r[i].bytes; }
+        fprintf(stderr, "[perf-%s] sources=%u%s n=%llu bytes=%.1fMB (top 16 by bytes)\n", tag, n,
+                n >= LD_RD_N ? "+" : "", (unsigned long long)total, (double)bytes / 1048576.0);
+        for (int k = 0; k < 16; k++) {
+            int b = -1;
+            for (u32 i = 0; i < n; i++) if (r[i].n && (b < 0 || r[i].bytes > r[b].bytes)) b = (int)i;
+            if (b < 0) break;
+            fprintf(stderr, "[perf-%s]   %u:0x%08X %ux%u fmt=0x%02X span=%u n=%llu %.1fMB\n", tag, r[b].location,
+                    r[b].offset, r[b].w, r[b].h, r[b].fmt, r[b].span, (unsigned long long)r[b].n,
+                    (double)r[b].bytes / 1048576.0);
+            r[b].n = 0;
+        }

+/* the walker waits for the pending build of g.psos[idx] and returns its PSO (NULL only when the build
+ * failed). Draws are never skipped while a build is in flight: a skipped draw is lost for good when its target
+ * keeps its content across frames. KZ3's text is such a target: glyphs are rendered once (stencil-then-cover) into
+ * the glyph cache at 0x3A00000 and sampled from there afterwards, so a glyph whose draws were skipped stayed blank
+ * (whole menu lists, capital C/A) or kept the glyph that held its slot before (arrows in "For less"). */
+static ID3D12PipelineState* ld_apso_await(u32 idx)
+{
+    LARGE_INTEGER t0, t1, f; QueryPerformanceCounter(&t0);
+    ld_apso_drain();
+    if (!g.psos[idx].pending) return g.psos[idx].pso;
+    while (g.psos[idx].pending) {
+        EnterCriticalSection(&g_apso.cs);
+        while (!g_apso.done) SleepConditionVariableCS(&g_apso.cv, &g_apso.cs, INFINITE);
+        LeaveCriticalSection(&g_apso.cs);
+        ld_apso_drain();
+    }
+    QueryPerformanceCounter(&t1); QueryPerformanceFrequency(&f);
+    const u64 us = (u64)((t1.QuadPart - t0.QuadPart) * 1000000 / f.QuadPart);
+    g_apso.awaits++; g_apso.await_us += us; if (us > g_apso.max_await_us) g_apso.max_await_us = us;
+    return g.psos[idx].pso;
+}

KZ3 patch 2073: CMP32 attributes take rsx_vertex_fetch_many's block loop, the RE notes.
Patch 2040's attribute-major fetch sent every CMP32 (11/11/10 packed normal) slot through the per-vertex path
(rsx_vertex_fetch_attr_one: element index, mapping test, type switch per vertex). On K4 that path was the largest
vertex-fetch cost: 54.6 of ~110 timed ms per second, 8.15 M slot-vertices at 6.7 ns (coord-fullclk-k4,
`[perf-vtxtype]`). CMP32 now has its own block loop over the attribute's contiguous mapping: one big-endian load,
the fields sign-extended by shifts (the same integers as rsx_vertex_decode_element), the same divisions. Vertices
outside the mapping still take the per-vertex path. Output bytes identical (tools/smoke/test_vtx_batch.sh).
LD_VTX_CMP32=0 = the old path (default on).

From Project Helghast port/patches/2073-vtx-cmp32-block-loop.patch (KZ3's last ps3recomp v0.15.0 stack), imported by KZ2.

Rebased on ps3recomp v0.18.0 (hand-merged): the CMP32 block loop moved into upstream #458's rsx_vertex_fetch_many (its element index honours #547's modulo rule)

diff --git a/libs/video/rsx_vertex_compact.c b/libs/video/rsx_vertex_compact.c
index 69af84f..06467f7 100644
--- a/libs/video/rsx_vertex_compact.c
+++ b/libs/video/rsx_vertex_compact.c
@@ -46,6 +46,17 @@ static float rsx_compact_be_f16(const u8* p)
     return f;
 }
 
+int rsx_vtx_cmp32_batch = -1;   /* KZ3 patch 2073 */
+
+static int rsx_vtx_switch(int* v, const char* name)
+{
+    if (*v < 0) {
+        const char* e = getenv(name);
+        *v = !(e && e[0] == '0' && !e[1]);
+    }
+    return *v;
+}
+
 /* KZ3 patch 2033: the decoder with the type switch hoisted out of the component
  * loop (the walker runs it once per attribute per vertex, ~10^5 times a frame).
  * Same results as before, component by component: the per-component bodies and
@@ -406,6 +417,7 @@ int rsx_vertex_fetch_many(
 {
     if (!plan || (!refs && count) || (!out && plan->layout.stride && count))
         return 0;
+    const int cmp32_batch = rsx_vtx_switch(&rsx_vtx_cmp32_batch, "LD_VTX_CMP32");   /* patch 2073 */
     const u32 stride = plan->layout.stride;
     for (u32 slot = 0; slot < plan->layout.count; slot++) {
         const u32 attr = plan->layout.attrs[slot];
@@ -448,6 +460,33 @@ int rsx_vertex_fetch_many(
             RSX_FETCH_LOOP(v[c] = (float)(s16)((src[c * 2] << 8) | src[c * 2 + 1]))
             break;
         default:   /* RSX_VTX_TYPE_CMP32: one packed word, whatever the size */
+            if (type == RSX_VTX_TYPE_CMP32 && cmp32_batch) {
+                /* KZ3 patch 2073: CMP32 (11/11/10 packed normal) over the contiguous mapping: one big-endian
+                 * load, the fields sign-extended by shifts (the same integers as rsx_vertex_decode_element),
+                 * the same divisions; elements outside the mapping take the per-vertex path. LD_VTX_CMP32=0 = off. */
+                for (u32 i = 0; i < count; i++) {
+                    float* v = (float*)(out + (size_t)i * stride + slot * 16u);
+                    const u32 element = plain
+                        ? ((refs[i].vertex_id + refs[i].base_index) & 0x000FFFFFu)
+                        : rsx_vertex_element_index(refs[i].vertex_id, refs[i].base_index,
+                                                   fetch->desc.frequency, modulo);
+                    if (element - first > span) {
+                        if (!rsx_vertex_fetch_attr_value(plan, attr, &refs[i], v)) return 0;
+                        continue;
+                    }
+                    const u8* src = base + (u64)(element - first) * fstride;
+                    const u32 word = ((u32)src[0] << 24) | ((u32)src[1] << 16) |
+                                     ((u32)src[2] << 8) | (u32)src[3];
+                    const s32 x = (s32)(word << 21) >> 21;
+                    const s32 y = (s32)(word << 10) >> 21;
+                    const s32 z = (s32)word >> 22;
+                    v[0] = (float)x / 1023.0f;
+                    v[1] = (float)y / 1023.0f;
+                    v[2] = (float)z / 511.0f;
+                    v[3] = 1.0f;
+                }
+                break;
+            }
             for (u32 i = 0; i < count; i++)
                 if (!rsx_vertex_fetch_attr_value(plan, attr, &refs[i],
                         (float*)(out + (size_t)i * stride + slot * 16u)))

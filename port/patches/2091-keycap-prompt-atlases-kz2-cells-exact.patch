+/* patch 2091 (KZ3 2039): the key in one slot of a keybinds.ini input ("cross", "ls_up", ...), 0 when unbound or before the
+ * file is read. For keycap prompts (rsx_keycaps.h through port/kz2/kz2_prompts.cpp). */
+int pad_kb_key_for_input(const char* name, int slot)
+{
+    int i = pad_kb_input_by_name(name, strlen(name)), vk = 0;
+    if (i < 0 || slot < 0 || slot >= PKB_SLOTS) return 0;
+    AcquireSRWLockShared(&s_kb_lock);
+    if (s_kb_ready) vk = s_kb.key[i][slot];
+    ReleaseSRWLockShared(&s_kb_lock);
+    return vk;
+}

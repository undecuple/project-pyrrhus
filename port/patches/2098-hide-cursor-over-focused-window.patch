+/* KZ2 patch 2098: hide the mouse pointer over the focused game window's client area (rsx_cursor.h). */
+static int rsx_cursor_keep_arrow(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("RSX_CURSOR"); v = (e && e[0] == '1') ? 1 : 0; }
+    return v;
+}
+static int rsx_cursor_over_client(HWND hwnd)
+{
+    POINT p;
+    RECT rc;
+    if (!GetCursorPos(&p) || !ScreenToClient(hwnd, &p) || !GetClientRect(hwnd, &rc)) return 0;
+    return PtInRect(&rc, p) ? 1 : 0;
+}
+static int rsx_cursor_msg(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp, LRESULT* res)
+{
+    static int s_logged;
+    switch (msg) {
+    case WM_SETCURSOR:
+        if ((HWND)wp == hwnd &&
+            rsx_cursor_hidden(LOWORD(lp) == HTCLIENT, GetForegroundWindow() == hwnd, rsx_cursor_keep_arrow())) {
+            SetCursor(NULL);
+            if (!s_logged) { s_logged = 1; printf("[cursor] pointer hidden over the game window (RSX_CURSOR=1 keeps it)\n"); }
+            *res = TRUE;
+            return 1;
+        }
+        return 0;
+    case WM_ACTIVATE:   /* no WM_SETCURSOR until the mouse moves: apply the new state now */
+        if (LOWORD(wp) != WA_INACTIVE) {
+            if (rsx_cursor_hidden(rsx_cursor_over_client(hwnd), 1, rsx_cursor_keep_arrow())) SetCursor(NULL);
+        } else {
+            SetCursor(LoadCursor(NULL, IDC_ARROW));
+        }
+        return 0;   /* DefWindowProc still runs (focus handling) */
+    case WM_KILLFOCUS:
+        SetCursor(LoadCursor(NULL, IDC_ARROW));
+        return 0;
+    }
+    return 0;
+}
+
+/* KZ2_TEST_DISPLAY steps (patch 2098): `mouse` puts the pointer on the client centre (Wine then sends
+ * WM_SETCURSOR as for a real move), `cursor` logs what this thread's cursor is now (GetCursor: NULL = hidden). */
+static int rsx_cursor_test_step(const char* act)
+{
+    HWND h = s_state.hwnd;
+    if (!strcmp(act, "mouse")) {
+        RECT rc;
+        POINT c;
+        GetClientRect(h, &rc);
+        c.x = (rc.left + rc.right) / 2; c.y = (rc.top + rc.bottom) / 2;
+        ClientToScreen(h, &c);
+        SetCursorPos(c.x, c.y);
+        return 1;
+    }
+    if (!strcmp(act, "cursor")) {
+        HCURSOR cur = GetCursor();
+        printf("[cursor] test: cursor %s (handle %p), game window %s, pointer over the client area %s\n",
+               cur ? "SHOWN" : "HIDDEN", (void*)cur, GetForegroundWindow() == h ? "focused" : "not focused",
+               rsx_cursor_over_client(h) ? "yes" : "no");
+        return 1;
+    }
+    return 0;
+}
+
 static LRESULT CALLBACK null_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
 {
     LRESULT sized;
+    if (rsx_cursor_msg(hwnd, msg, wp, lp, &sized)) return sized;   /* patch 2098 */
     if (rsx_dm_wndmsg(hwnd, msg, wp, lp, &sized)) return sized;   /* patch 2095 */
     /* patch 2062's aspect-keeping drag and maximize: windowed only (patch 2095) */
     if (s_dm_applied == RSX_DM_WINDOWED && rsx_win_size_msg(hwnd, msg, wp, lp, &sized)) return sized;

diff --git a/libs/video/rsx_pso_template.h b/libs/video/rsx_pso_template.h
--- a/libs/video/rsx_pso_template.h
+++ b/libs/video/rsx_pso_template.h
@@ -187,4 +187,53 @@
     return blocks;
 }
 
+/* KZ2 patch 2126: the scout scanned each VirtualQuery region on its own, so the hit got only the
+ * bytes to the end of that region: a program whose first 16 bytes are in one region and whose rest is in the next
+ * (adjacent committed memory) failed the hit's size check and was never found. Regions are now joined into runs:
+ * rsx_pt_run_add(run, b, len, ...) extends the pending run when [b, b+len) starts where it ends, else scans the
+ * pending run (to its end) and starts a new one; len 0 (a gap: an uncommitted or unreadable region, or the end of the
+ * pass) scans the pending run. Returns the blocks scanned. Host test: tools/runtime/test_pt_runs.sh. */
+typedef struct { const uint8_t* base; size_t len; } rsx_pt_run;
+static inline size_t rsx_pt_run_add(rsx_pt_run* run, const uint8_t* b, size_t len, const rsx_pt_qtab* t,
+                                    rsx_pt_hit_fn hit, void* user)
+{
+#ifndef RSX_PT_RUN_SPLIT   /* test-only negative control: every region alone, as before 2126 */
+    if (run->len && len && run->base + run->len == b) { run->len += len; return 0; }
+#endif
+    size_t blocks = 0;
+    if (run->len) blocks = rsx_pt_scan(run->base, run->len & ~(size_t)15, t, hit, user);
+    run->base = len ? b : NULL; run->len = len;
+    return blocks;
+}
+
+/* One scout pass over [p, end): query(quser, p, &r) describes the region holding p (r.base <= p, r.size > 0,
+ * r.readable = committed and readable) or returns 0 to end the pass. Readable regions go through rsx_pt_run_add, any
+ * other one ends the run; the pass ends with a flush unless *stop was set. Returns the bytes scanned (each readable
+ * piece rounded down to 16). ld_pt_scan_pass calls it with VirtualQuery; the host test with a region table. */
+typedef struct { const uint8_t* base; size_t size; int readable; } rsx_pt_region;
+typedef int (*rsx_pt_query_fn)(void* quser, const uint8_t* p, rsx_pt_region* r);
+static inline size_t rsx_pt_scan_regions(const uint8_t* p, const uint8_t* end, rsx_pt_query_fn query, void* quser,
+                                         const volatile int* stop, const rsx_pt_qtab* t, rsx_pt_hit_fn hit, void* user)
+{
+    size_t total = 0;
+    rsx_pt_run run = { NULL, 0 };
+    while (p < end && !*stop) {
+        rsx_pt_region r;
+        if (!query(quser, p, &r) || !r.size) break;
+        size_t rs = r.size;
+        if (r.base + rs > end) rs = (size_t)(end - r.base);
+        if (r.readable) {
+            const uint8_t* s = r.base < p ? p : r.base;
+            const size_t len = (size_t)((r.base + rs) - s);
+            total += len & ~(size_t)15;
+            rsx_pt_run_add(&run, s, len, t, hit, user);
+        } else {
+            rsx_pt_run_add(&run, NULL, 0, t, hit, user);   /* a gap ends the run */
+        }
+        p = r.base + rs;
+    }
+    if (!*stop) rsx_pt_run_add(&run, NULL, 0, t, hit, user);   /* the last run */
+    return total;
+}
+
 #endif /* RSX_PSO_TEMPLATE_H */

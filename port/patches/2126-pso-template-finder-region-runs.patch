+/* KZ2 patch 2126: the region holding p, for rsx_pt_scan_regions (readable = committed, readable, not a guard page). */
+static int ld_pt_query(void* quser, const uint8_t* p, rsx_pt_region* r)
+{
+    MEMORY_BASIC_INFORMATION mi;
+    (void)quser;
+    if (!VirtualQuery(p, &mi, sizeof mi)) return 0;
+    r->base = (const uint8_t*)mi.BaseAddress;
+    r->size = mi.RegionSize;
+    r->readable = mi.State == MEM_COMMIT &&
+                  (mi.Protect & (PAGE_READONLY | PAGE_READWRITE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE | PAGE_WRITECOPY)) &&
+                  !(mi.Protect & (PAGE_GUARD | PAGE_NOACCESS));
+    return 1;
+}

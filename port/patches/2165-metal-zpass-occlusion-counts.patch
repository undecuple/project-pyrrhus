+/* ---- KZ2 patch 2165: ZPASS counting --------------------------------------------------------------------------
+ * The rules follow the author's Resistance 3 macOS port (rsx_draw_engine_zpass_*, MIT, Erik Martins); the result
+ * side never waits for the GPU (that port's waits cost 84 -> 50 fps there): a report the GPU has not finished keeps
+ * its earlier value until it has (cellGcmSys.c). Killzone 2 sizes and fades its light coronas by these counts; the
+ * constant "visible" answer drew every corona at full strength, through walls. */
+int rsx_draw_engine_zpass_supported(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_ENG_ZPASS"); on = !(e && *e && atoi(e) == 0); }
+    return on && g.ready && g.be && g.be->set_occlusion && g.be->occlusion_result;
+}
+
+static u32 eng_zpass_query(void)
+{
+    if (!(rsx_dsp_reg(&g.rsx, 0x17CCu) & 1u) || !rsx_draw_engine_zpass_supported()) return 0;
+    if (!g.zp_query) {
+        g.zp_query = ++g.zp_last;
+        if (!g.zp_query) g.zp_query = g.zp_last = g.zp_first = 1u;   /* wrapped */
+    }
+    return g.zp_query;
+}
+
+u32 rsx_draw_engine_zpass_report(void)
+{
+    if (!rsx_draw_engine_zpass_supported()) return 0;
+    u32 t = ++g.zp_ticket;
+    if (!t) t = g.zp_ticket = 1u;
+    const u32 i = t % 1024u;
+    g.zp_tickets[i].ticket = t;
+    g.zp_tickets[i].first  = g.zp_first ? g.zp_first : 1u;
+    g.zp_tickets[i].last   = g.zp_last;
+    g.zp_query = 0;   /* later draws count into a query of their own; the next report sums both until a clear */
+    return t;
+}
+
+int rsx_draw_engine_zpass_result(u32 ticket, u32* value)
+{
+    if (!ticket || !rsx_draw_engine_zpass_supported()) return -1;
+    const u32 i = ticket % 1024u;
+    if (g.zp_tickets[i].ticket != ticket) return -1;
+    const u32 first = g.zp_tickets[i].first, last = g.zp_tickets[i].last;
+    if (last < first) { *value = 0; return 1; }   /* nothing drawn since the clear */
+    if (last - first >= 256u) return -1;
+    unsigned long long sum = 0;
+    for (u32 q = first; q <= last; q++) {
+        unsigned long long n = 0;
+        const int r = g.be->occlusion_result(g.be->user, q, &n);
+        if (r <= 0) return r;
+        sum += n;
+    }
+    *value = sum > 0xFFFFFFFFull ? 0xFFFFFFFFu : (u32)sum;
+    return 1;
+}

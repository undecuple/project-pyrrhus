+/* ---- KZ2 patch 2165: ZPASS occlusion counting -------------------------------------------------------------------
+ * A draw that counts gets a slot of its own in its commit's visibility-result buffer and is encoded with
+ * MTLVisibilityResultModeCounting at that slot; a query is the sum of its draws' slots. The command buffer's completion
+ * handler adds each slot to its query and lowers the query's outstanding count; eng_occlusion_result only looks, so
+ * nothing here ever waits for the GPU. Slot-per-draw and the result table follow the author's Resistance 3 port (MIT,
+ * Erik Martins); the per-commit buffer and the completion-handler harvest are this port's. */
+#define ENG_VIS_Q 4096u
+typedef struct { u32 query, outstanding, lost; unsigned long long samples; } EngVisQ;
+static EngVisQ s_visq[ENG_VIS_Q];
+static pthread_mutex_t s_visq_lock = PTHREAD_MUTEX_INITIALIZER;
+static id<MTLBuffer> s_vis_buf;          /* this commit's, while it is encoded */
+static u32* s_vis_slot_query;            /* slot -> query, this commit's */
+static u32 s_vis_nslots, s_vis_used;
 
+static void eng_set_occlusion(void* user, u32 query)
+{
+    (void)user;
+    s_eng_pending.vis_query = query;
+    if (!query) return;
+    pthread_mutex_lock(&s_visq_lock);
+    EngVisQ* q = &s_visq[query % ENG_VIS_Q];
+    if (q->query != query) { memset(q, 0, sizeof *q); q->query = query; }
+    pthread_mutex_unlock(&s_visq_lock);
+}
+
+static int eng_occlusion_result(void* user, u32 query, unsigned long long* samples)
+{
+    (void)user;
+    int r;
+    pthread_mutex_lock(&s_visq_lock);
+    const EngVisQ* q = &s_visq[query % ENG_VIS_Q];
+    if (!query || q->query != query || q->lost) r = -1;
+    else if (q->outstanding) r = 0;
+    else { *samples = q->samples; r = 1; }
+    pthread_mutex_unlock(&s_visq_lock);
+    return r;
+}
+
+/* A counted draw recorded, or one that will never reach the GPU (lost = 1). */
+static void eng_vis_note(u32 query, int add, int lost, unsigned long long samples)
+{
+    pthread_mutex_lock(&s_visq_lock);
+    EngVisQ* q = &s_visq[query % ENG_VIS_Q];
+    if (q->query == query) {
+        if (add) q->outstanding++;
+        else { if (q->outstanding) q->outstanding--; q->samples += samples; if (lost) q->lost = 1; }
+    }
+    pthread_mutex_unlock(&s_visq_lock);
+}
+
+/* Before a commit's encoding: a buffer with one zeroed slot per counted draw. */
+static void eng_vis_begin_commit(void)
+{
+    s_vis_buf = nil; s_vis_slot_query = NULL; s_vis_nslots = s_vis_used = 0;
+    u32 n = 0;
+    for (u32 i = 0; i < s_eng_rec_count; i++) {
+        s_eng_rec[i].vis_slot = 0;
+        if (s_eng_rec[i].kind == ENG_REC_DRAW && s_eng_rec[i].vis_query) n++;
+    }
+    if (!n || !s_dev) return;
+    s_vis_buf = [s_dev newBufferWithLength:(NSUInteger)n * sizeof(u64) options:MTLResourceStorageModeShared];
+    s_vis_slot_query = (u32*)calloc(n, sizeof(u32));
+    if (!s_vis_buf || !s_vis_slot_query) { s_vis_buf = nil; free(s_vis_slot_query); s_vis_slot_query = NULL; return; }
+    memset([s_vis_buf contents], 0, (size_t)n * sizeof(u64));
+    s_vis_nslots = n;
+}
+
+/* After encoding: the slots go to the completion handler; counted draws that got no slot are lost. */
+static void eng_vis_end_commit(id<MTLCommandBuffer> cb)
+{
+    for (u32 i = 0; i < s_eng_rec_count; i++) {
+        const EngRecord* r = &s_eng_rec[i];
+        if (r->kind == ENG_REC_DRAW && r->vis_query && !r->vis_slot) eng_vis_note(r->vis_query, 0, 1, 0);
+    }
+    if (!s_vis_buf) return;
+    id<MTLBuffer> buf = s_vis_buf;
+    u32* map = s_vis_slot_query;
+    const u32 used = s_vis_used;
+    s_vis_buf = nil; s_vis_slot_query = NULL; s_vis_nslots = s_vis_used = 0;
+    if (!cb) { for (u32 k = 0; k < used; k++) eng_vis_note(map[k], 0, 1, 0); free(map); return; }
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> done) {
+        const int ok = [done status] == MTLCommandBufferStatusCompleted;
+        const u64* v = (const u64*)[buf contents];
+        for (u32 k = 0; k < used; k++) eng_vis_note(map[k], 0, !ok, ok ? v[k] : 0);
+        free(map);
+    }];
+}

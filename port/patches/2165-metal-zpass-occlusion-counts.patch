@@ -385,6 +385,58 @@
 /* Report data area (256 slots, each 16 bytes) */
 static CellGcmReportData s_report_data[CELL_GCM_MAX_REPORT_COUNT];
 
+/* ---- KZ2 patch 2165: ZPASS reports measured by the Metal draw engine -------------------------------------------
+ * A GET_REPORT(ZPASS) gets a ticket (rsx_draw_engine_zpass_report) and is answered at once with the last count that
+ * report area received (0xFFFF, "visible", before the first); the ticket waits here and, once the engine says its
+ * draws have finished on the GPU (never waiting for it), the real count is written into the report's value word.
+ * The title reads it a frame later, as KZ3 patch 2027 does for the D3D12 path. A ticket older than 2 s is dropped. */
+#define GCM_ZQ_LEN 1024u
+static struct { u32 ticket, off; u64 t_ms; } s_zq[GCM_ZQ_LEN];
+static u32 s_zq_head, s_zq_tail;
+#define GCM_ZLAST 4096u
+static struct { u32 off, val; } s_zlast[GCM_ZLAST];   /* report offset -> last count (val + 1; 0 = none) */
+static u32 gcm_io2ea(u32 io_off);
+static u64 gcm_zq_now_ms(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (u64)t.tv_sec * 1000u + (u64)t.tv_nsec / 1000000u; }
+static u32* gcm_zlast_slot(u32 off)
+{
+    u32 h = (off / 16u) % GCM_ZLAST;
+    for (u32 k = 0; k < 8u; k++, h = (h + 1u) % GCM_ZLAST)
+        if (!s_zlast[h].val || s_zlast[h].off == off) { s_zlast[h].off = off; return &s_zlast[h].val; }
+    s_zlast[(off / 16u) % GCM_ZLAST].off = off;   /* full neighbourhood: take the home slot */
+    s_zlast[(off / 16u) % GCM_ZLAST].val = 0;
+    return &s_zlast[(off / 16u) % GCM_ZLAST].val;
+}
+static u32 gcm_zpass_queue(u32 off, u32 ticket, u32 dflt)
+{
+    u32* last = gcm_zlast_slot(off);
+    if (ticket) {
+        if (s_zq_tail - s_zq_head >= GCM_ZQ_LEN) s_zq_head++;   /* oldest dropped */
+        const u32 i = s_zq_tail++ % GCM_ZQ_LEN;
+        s_zq[i].ticket = ticket; s_zq[i].off = off; s_zq[i].t_ms = gcm_zq_now_ms();
+    }
+    return *last ? *last - 1u : dflt;
+}
+static void gcm_zpass_pump(void)
+{
+    if (s_zq_head == s_zq_tail) return;
+    const u64 now = gcm_zq_now_ms();
+    static int log_n = -1;
+    if (log_n < 0) { const char* e = getenv("GCM_ZPASS_LOG"); log_n = e ? atoi(e) : 0; }
+    while (s_zq_head != s_zq_tail) {
+        const u32 i = s_zq_head % GCM_ZQ_LEN;
+        u32 n = 0;
+        const int r = rsx_draw_engine_zpass_result(s_zq[i].ticket, &n);
+        if (r == 0 && now - s_zq[i].t_ms < 2000u) break;   /* in order: later ones are not done either */
+        if (r == 1) {
+            const u32 ea = gcm_io2ea(s_zq[i].off);
+            if (ea) vm_write32(ea + 8u, n);
+            *gcm_zlast_slot(s_zq[i].off) = n + 1u > n ? n + 1u : n;
+            if (log_n > 0) { log_n--; fprintf(stderr, "[GET_REPORT] zpass off=0x%X ticket %u: %u samples\n", s_zq[i].off, s_zq[i].ticket, n); }
+        }
+        s_zq_head++;
+    }
+}

+/* ---- drawable prefetcher (KZ2 patch 2166) ----------------------------------
+ * CAMetalLayer.nextDrawable blocks until the compositor returns one, and a fully
+ * occluded window gets none: the FIFO walker sat inside the in-drain present for
+ * as long as the window stayed covered (26-56 s in the windowed scripted runs,
+ * the GPU idle the whole time; the same session headless -- no compositor --
+ * never drained longer than 961 ms, run work/macos-runs/20261118-231521). One
+ * host thread stays one drawable ahead, so the walker's present becomes a
+ * try-take: an empty mailbox skips the frame -- the compositor is then owed one
+ * it was not showing anyway -- and the walker never blocks on the window again.
+ * PS3RECOMP_METAL_DRAWABLE_AHEAD=0 restores the inline call of today. */
+static id<CAMetalDrawable> s_drawable_next;      /* the mailbox: 0 or 1 drawable */
+static dispatch_semaphore_t s_drawable_ready;   /* its count is the mailbox state */
+static dispatch_semaphore_t s_drawable_free;    /* the presenter may refill it */
+static volatile int s_presenter_running;
+static pthread_t s_presenter_thread;
+
+static int eng_drawable_ahead_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_METAL_DRAWABLE_AHEAD");
+                  on = (e && e[0] == '0' && !e[1]) ? 0 : 1; }
+    return on;
+}
+
+static void* eng_drawable_presenter_main(void* arg)
+{
+    (void)arg;
+    for (;;) {
+        dispatch_semaphore_wait(s_drawable_free, DISPATCH_TIME_FOREVER);
+        if (!s_presenter_running) break;
+        @autoreleasepool {
+            /* The blocking call lives here, off the walker: while the window is
+             * occluded this thread alone waits; the game runs on. */
+            id<CAMetalDrawable> d = [s_layer nextDrawable];
+            if (!d) {   /* Metal gave up (a very long occlusion): try again shortly */
+                dispatch_semaphore_signal(s_drawable_free);
+                usleep(10000);
+                continue;
+            }
+            s_drawable_next = d;
+            dispatch_semaphore_signal(s_drawable_ready);
+        }
+    }
+    return NULL;
+}
+
+static void eng_drawable_presenter_start(void)
+{
+    if (!s_layer || !eng_drawable_ahead_on()) return;
+    s_drawable_ready = dispatch_semaphore_create(0);
+    s_drawable_free  = dispatch_semaphore_create(1);   /* the mailbox is empty: prefetch now */
+    s_drawable_next  = nil;
+    s_presenter_running = 1;
+    if (pthread_create(&s_presenter_thread, NULL, eng_drawable_presenter_main, NULL) != 0) {
+        s_presenter_running = 0;
+        s_drawable_ready = nil;
+        s_drawable_free = nil;
+        fprintf(stderr, "[RSX metal] drawable prefetcher not started; presents wait inline\n");
+    }
+}
+
+static void eng_drawable_presenter_stop(void)
+{
+    if (!s_presenter_running) return;
+    s_presenter_running = 0;
+    /* Release it wherever it waits -- the mailbox's refill permit, or a drawable
+     * it posted that nobody takes -- then drop whatever is still in the mailbox. */
+    dispatch_semaphore_signal(s_drawable_free);
+    dispatch_semaphore_signal(s_drawable_ready);
+    pthread_join(s_presenter_thread, NULL);
+    s_drawable_next = nil;
+    s_drawable_ready = nil;
+    s_drawable_free = nil;
+}
+
+/* The walker's present takes the prefetched drawable without ever waiting for
+ * the compositor. Returns it, or nil when none is ready (the caller skips the
+ * frame exactly as a failed inline call does). */
+static id<CAMetalDrawable> eng_drawable_take(void)
+{
+    if (!s_presenter_running) return nil;
+    if (dispatch_semaphore_wait(s_drawable_ready, DISPATCH_TIME_NOW) != 0) return nil;
+    id<CAMetalDrawable> d = s_drawable_next;
+    s_drawable_next = nil;
+    dispatch_semaphore_signal(s_drawable_free);   /* prefetch the next one now */
+    return d;
+}
+
 /* Each initialization owns its counters. A drawable callback retained by the
  * compositor can outlive shutdown without writing into a later session. */
 #if !TARGET_OS_IPHONE

KZ2 patch 2167: the walker never builds a pipeline; misses build on a worker.

Written for the Pyrrhus native Mac bring-up; no game code or RPCS3 code used.
Licence: MIT (project LICENSE).

The game's pipeline set varies per session -- SPU timing shifts render states, so
keys differ run to run, and a warm MTLBinaryArchive (patch 2161) still saw 50-150
first-seen pipelines a session, each a synchronous MTLCompiler round-trip on the
FIFO walker; a cluster of them froze the drain for up to 40 s with the GPU idle
(the walker sampler sits in MTLCompilerScheduler buildRequest; runs
work/macos-runs/20261119-001723 and its predecessors).

A serial worker builds the misses. A pending build returns 0; the engine drops
that draw and asks again on its next one -- the engine no longer memoizes a miss
(a memoized miss froze a pipeline at one dropped attempt) -- and the finished
handle lands in the slot table for the frames after. A build that fails hard
stays failed in the backend's table and is answered 0 forever, exactly as a
failed synchronous build is today. PS3RECOMP_METAL_ASYNC_PSO=0 restores the
synchronous build. The worker owns the function and pipeline tables while a
build runs; the engine's draws only read completed slots.

diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -2241,16 +2241,25 @@
                 vi, fi, nconst, (unsigned long long)fp_hash,
                 handle ? "ok" : "FAILED (draw dropped)"); }
 
-    g.pipelines[g.n_pipelines].key = key;
-    g.pipelines[g.n_pipelines].fp_hash = fp_hash;
-    g.pipelines[g.n_pipelines].handle = handle;
-    g.pipelines[g.n_pipelines].fixed = (u8)fixed;
-    g.pipelines[g.n_pipelines].tex_used =
-        (u16)(fixed ? 0xFFFFu : (eng_sampled_units(s_ps_hlsl) | dbz_bit));
-    *out_tex_used = g.pipelines[g.n_pipelines].tex_used;
-    *out_fp_hash = fp_hash;
-    g.pipeline_index[slot] = (u16)(g.n_pipelines + 1u);
-    g.n_pipelines++;
+    /* Patch 2167: a miss is not memoized. The backend answers 0 for a build
+     * still in flight (or one that failed hard, which it answers forever),
+     * and the next draw asks again; memoizing the miss would freeze the
+     * pipeline's draws at one dropped attempt. */
+    if (handle) {
+        g.pipelines[g.n_pipelines].key = key;
+        g.pipelines[g.n_pipelines].fp_hash = fp_hash;
+        g.pipelines[g.n_pipelines].handle = handle;
+        g.pipelines[g.n_pipelines].fixed = (u8)fixed;
+        g.pipelines[g.n_pipelines].tex_used =
+            (u16)(fixed ? 0xFFFFu : (eng_sampled_units(s_ps_hlsl) | dbz_bit));
+        *out_tex_used = g.pipelines[g.n_pipelines].tex_used;
+        *out_fp_hash = fp_hash;
+        g.pipeline_index[slot] = (u16)(g.n_pipelines + 1u);
+        g.n_pipelines++;
+    } else {
+        *out_tex_used = (u16)(fixed ? 0xFFFFu : dbz_bit);
+        *out_fp_hash = fp_hash;
+    }
     *out_fixed = fixed;
     return handle;
 }

diff --git a/libs/video/rsx_metal_backend.m b/libs/video/rsx_metal_backend.m
--- a/libs/video/rsx_metal_backend.m
+++ b/libs/video/rsx_metal_backend.m
@@ -3194,10 +3194,38 @@
 
 /* ---- lifecycle ----------------------------------------------------------- */
 
+/* Patch 2167: the async pipeline-build state. Declared here, before eng_init
+ * uses the queue, because the dispatcher that creates the builds lives with
+ * the pipeline section below. */
+static pthread_mutex_t s_eng_build_lock = PTHREAD_MUTEX_INITIALIZER;
+static dispatch_queue_t s_eng_build_queue;
+/* The translators and their scratch buffers are not reentrant (rsx_live_draw.c's
+ * prewarm solved this with a lock of its own), so the builds parallelize only
+ * from newRenderPipelineState on; four of those overlap usefully. */
+static pthread_mutex_t s_eng_translate_lock = PTHREAD_MUTEX_INITIALIZER;
+enum { ENG_ASYNC_MAX = 4096, ENG_ASYNC_WORKERS = 4 };
+typedef struct {
+    u64 key;
+    u32 result;                 /* 0 while in flight, the handle once done */
+    int done;
+    int inline_building;        /* a retry built it on the walker; the worker skips */
+    uint64_t queued_us;         /* ps3_ft_now() at insert, for the retry age gate */
+    char* vs_hlsl;              /* the worker's own copies; freed on its way out */
+    char* ps_hlsl;
+    rsx_be_render_state rs;
+    rsx_vertex_layout_plan layout;
+    u32 vertex_stride;
+    rsx_be_format rt_fmt;
+    u32 rt_count;
+} eng_async_build;
+static eng_async_build* s_eng_builds[ENG_ASYNC_MAX];
+static u32 s_eng_build_count;
+
 static int eng_init(void* user, u32 width, u32 height)
 {
     (void)user; (void)width; (void)height;
     s_eng_encoding_failed = 0;
+    if (!s_eng_build_queue) s_eng_build_queue = dispatch_queue_create("kz2.pso.build", DISPATCH_QUEUE_CONCURRENT);   /* patch 2167 */
     if (!s_dev) return -1;
     NSError* err = nil;
     s_eng_helper_lib = [s_dev newLibraryWithSource:kEngHelperMSL options:nil error:&err];
@@ -3226,6 +3254,10 @@
 static void eng_shutdown(void* user)
 {
     (void)user;
+    /* Patch 2167: let the build workers finish before the tables they fill
+     * (and read from) are cleared below. A barrier waits out the concurrent
+     * queue's in-flight blocks. */
+    if (s_eng_build_queue) dispatch_barrier_sync(s_eng_build_queue, ^{});
     for (u32 i = 0; i < s_eng_obj_count; i++) s_eng_obj[i] = nil;
     for (u32 i = 0; i < s_eng_pipe_count; i++) {
         s_eng_pipe[i].pso = nil;
@@ -3522,9 +3554,17 @@
                                     const char* what)
 {
     const u64 hash = fnv1a64(hlsl, (u32)strlen(hlsl), 1469598103934665603ull);
+    /* Patch 2167: the build workers call this concurrently; the translators
+     * and their scratch buffers are not reentrant, so one builder at a time.
+     * On the walker's own path the lock is uncontended. */
+    pthread_mutex_lock(&s_eng_translate_lock);
     for (u32 i = 0; i < s_eng_func_count; i++)
-        if (s_eng_func[i].hash == hash) return s_eng_func[i].fn;
-    if (s_eng_func_count >= ENG_MAX_FUNCS) return nil;
+        if (s_eng_func[i].hash == hash) {
+            const id<MTLFunction> hit = s_eng_func[i].fn;
+            pthread_mutex_unlock(&s_eng_translate_lock);
+            return hit;
+        }
+    if (s_eng_func_count >= ENG_MAX_FUNCS) { pthread_mutex_unlock(&s_eng_translate_lock); return nil; }
 
     id<MTLFunction> fn = nil;
     char name[64];
@@ -3542,14 +3582,184 @@
     s_eng_func[s_eng_func_count].hash = hash;
     s_eng_func[s_eng_func_count].fn   = fn;
     s_eng_func_count++;
+    pthread_mutex_unlock(&s_eng_translate_lock);
     return fn;
 }
 
+/* KZ2 patch 2167: the walker never builds a pipeline. The game's pipeline set
+ * varies per session (SPU timing shifts render states, so keys differ run to
+ * run; a warm archive still sees ~50-150 first-seen pipelines, each a
+ * synchronous MTLCompiler round-trip ON THE WALKER, and a cluster froze the
+ * FIFO drain for up to 40 s, GPU idle -- the sampler sits in
+ * MTLCompilerScheduler buildRequest). A serial worker builds the misses now:
+ * a pending build returns 0, the engine drops that draw and asks again on its
+ * next one (the engine no longer memoizes a miss), and the finished handle
+ * lands in the slot table for the frames after. A build that fails hard stays
+ * failed, exactly as a failed synchronous build does today.
+ * PS3RECOMP_METAL_ASYNC_PSO=0 restores the synchronous build. The build state
+ * lives above, before eng_init. */
+static int eng_async_pso_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_METAL_ASYNC_PSO");
+                  /* Off by default until a pending build can draw with something
+                   * instead of dropping: content drawn only during the drop window
+                   * (menu boxes, gameplay elements) never came back. The retry of
+                   * 94dcfc6 recovers re-drawn content, not once-drawn content. */
+                  on = (e && e[0] == '1') ? 1 : 0; }
+    return on && s_eng_build_queue;
+}
+
+static u64 eng_async_key(const char* vs, const char* ps, const rsx_be_render_state* rs,
+                         const rsx_vertex_layout_plan* layout, u32 stride,
+                         rsx_be_format fmt, u32 count)
+{
+    u64 k = fnv1a64((const u8*)vs, (u32)strlen(vs), 1469598103934665603ull);
+    k = fnv1a64((const u8*)ps, (u32)strlen(ps), k);
+    k = fnv1a64((const u8*)rs, (u32)sizeof *rs, k);
+    k = fnv1a64((const u8*)layout, (u32)sizeof *layout, k);
+    u32 tail[3] = { stride, (u32)fmt, count };
+    return fnv1a64((const u8*)tail, (u32)sizeof tail, k);
+}
+
+static u32 eng_pipeline_create_sync(void* user, const char* vs_hlsl, const char* ps_hlsl,
+                                    const rsx_be_render_state* rs,
+                                    const rsx_vertex_layout_plan* layout,
+                                    u32 vertex_stride, rsx_be_format rt_fmt,
+                                    u32 rt_count);
+
 static u32 eng_pipeline_create(void* user, const char* vs_hlsl, const char* ps_hlsl,
                                const rsx_be_render_state* rs,
                                const rsx_vertex_layout_plan* layout,
                                u32 vertex_stride, rsx_be_format rt_fmt,
                                u32 rt_count)
+{
+    (void)user;
+    if (!s_dev || !s_guest_shaders || !vertex_stride) return 0;
+    if (!rt_count) rt_count = 1;
+    if (rt_count > RSX_BE_MAX_COLOR_TARGETS) rt_count = RSX_BE_MAX_COLOR_TARGETS;
+    if (!eng_async_pso_on())
+        return eng_pipeline_create_sync(user, vs_hlsl, ps_hlsl, rs, layout,
+                                        vertex_stride, rt_fmt, rt_count);
+    const u64 key = eng_async_key(vs_hlsl, ps_hlsl, rs, layout, vertex_stride, rt_fmt, rt_count);
+    pthread_mutex_lock(&s_eng_build_lock);
+    for (u32 i = 0; i < s_eng_build_count; i++) {
+        if (s_eng_builds[i]->key != key) continue;
+        eng_async_build* e = s_eng_builds[i];
+        if (e->done) {
+            const u32 result = e->result;
+            pthread_mutex_unlock(&s_eng_build_lock);
+            return result;
+        }
+        if (!e->inline_building) {
+            /* A re-request of a pipeline whose first draw was dropped. The
+             * worker clears the ordinary bursts (four builds at a time), so
+             * inline building is reserved for entries it has still not
+             * reached after ENG_ASYNC_RETRY_S -- content drawn rarely
+             * (static menu text) would otherwise miss its pipeline for as
+             * long as the queue's backlog, because the game stopped drawing
+             * by the time the build landed. This is the R2 SYNC_HIT lesson;
+             * a rate gate bounds the walker's exposure to one build at a
+             * time. */
+            {
+                static uint64_t s_last_inline_us;
+                const uint64_t now = ps3_ft_now();
+                if (now - e->queued_us < 5000000ull ||   /* young: the worker has it */
+                    now - s_last_inline_us < 100000ull) {  /* one at a time */
+                    pthread_mutex_unlock(&s_eng_build_lock);
+                    return 0;
+                }
+                s_last_inline_us = now;
+            }
+            e->inline_building = 1;
+            pthread_mutex_unlock(&s_eng_build_lock);
+            const u32 handle = eng_pipeline_create_sync(NULL, e->vs_hlsl, e->ps_hlsl,
+                                                        &e->rs, &e->layout,
+                                                        e->vertex_stride, e->rt_fmt, e->rt_count);
+            pthread_mutex_lock(&s_eng_build_lock);
+            e->result = handle;
+            e->done = 1;
+            pthread_mutex_unlock(&s_eng_build_lock);
+            { static int n = 0;
+              if (PS3_LOG_FIRST(n, 12))
+                fprintf(stderr, "[rsx engine/metal] async pipeline %016llx built on retry -> %s\n",
+                        (unsigned long long)e->key, handle ? "ok" : "failed"); }
+            return handle;
+        }
+        pthread_mutex_unlock(&s_eng_build_lock);
+        return 0;
+    }
+    if (s_eng_build_count >= ENG_ASYNC_MAX || s_eng_pipe_count >= ENG_MAX_PIPES) {
+        pthread_mutex_unlock(&s_eng_build_lock);
+        return 0;
+    }
+    eng_async_build* b = (eng_async_build*)calloc(1, sizeof *b);
+    char* vs_copy = b ? strdup(vs_hlsl) : NULL;
+    char* ps_copy = b ? strdup(ps_hlsl) : NULL;
+    if (!b || !vs_copy || !ps_copy) {
+        free(b); free(vs_copy); free(ps_copy);
+        pthread_mutex_unlock(&s_eng_build_lock);
+        return 0;
+    }
+    b->key = key;
+    b->queued_us = ps3_ft_now();
+    b->vs_hlsl = vs_copy;
+    b->ps_hlsl = ps_copy;
+    b->rs = *rs;
+    b->layout = *layout;
+    b->vertex_stride = vertex_stride;
+    b->rt_fmt = rt_fmt;
+    b->rt_count = rt_count;
+    s_eng_builds[s_eng_build_count++] = b;
+    pthread_mutex_unlock(&s_eng_build_lock);
+    dispatch_async(s_eng_build_queue, ^{
+        /* Patch 2167: up to four builds at a time; the translation itself
+         * serializes in eng_function's lock, the pipeline creation overlaps. */
+        static dispatch_semaphore_t s_build_slots;
+        if (!s_build_slots) s_build_slots = dispatch_semaphore_create(ENG_ASYNC_WORKERS);
+        dispatch_semaphore_wait(s_build_slots, DISPATCH_TIME_FOREVER);
+        /* A retry may build this entry on the walker (inline_building); wait
+         * for that and skip the duplicate. The normal path (no retry) falls
+         * straight through to the build. */
+        for (;;) {
+            pthread_mutex_lock(&s_eng_build_lock);
+            const int done = b->done;
+            const int inline_bld = b->inline_building;
+            pthread_mutex_unlock(&s_eng_build_lock);
+            if (done) {
+                free(b->vs_hlsl); b->vs_hlsl = NULL;
+                free(b->ps_hlsl); b->ps_hlsl = NULL;
+                dispatch_semaphore_signal(s_build_slots);
+                return;
+            }
+            if (!inline_bld) break;
+            usleep(1000);
+        }
+        const u32 handle = eng_pipeline_create_sync(NULL, b->vs_hlsl, b->ps_hlsl,
+                                                    &b->rs, &b->layout,
+                                                    b->vertex_stride, b->rt_fmt, b->rt_count);
+        dispatch_semaphore_signal(s_build_slots);
+        pthread_mutex_lock(&s_eng_build_lock);
+        b->result = handle;
+        b->done = 1;
+        pthread_mutex_unlock(&s_eng_build_lock);
+        { static int n = 0;
+          if (PS3_LOG_FIRST(n, 24))
+            fprintf(stderr, "[rsx engine/metal] async pipeline %016llx -> %s\n",
+                    (unsigned long long)b->key, handle ? "ok" : "failed"); }
+        /* The functions are deduplicated by their own hashes; the texts are
+         * only for this build. */
+        free(b->vs_hlsl); b->vs_hlsl = NULL;
+        free(b->ps_hlsl); b->ps_hlsl = NULL;
+    });
+    return 0;
+}
+
+static u32 eng_pipeline_create_sync(void* user, const char* vs_hlsl, const char* ps_hlsl,
+                                    const rsx_be_render_state* rs,
+                                    const rsx_vertex_layout_plan* layout,
+                                    u32 vertex_stride, rsx_be_format rt_fmt,
+                                    u32 rt_count)
 {
     (void)user;
     if (!s_dev || !s_guest_shaders || !vertex_stride) return 0;

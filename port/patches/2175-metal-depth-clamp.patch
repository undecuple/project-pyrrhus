KZ2 patch 2175: honour SET_ZMIN_MAX_CONTROL's depth clamp in the draw engine (Metal).

Adapted from commit 53650c7d of Erik Martins's (erikomis) ps3recomp fork, MIT; the test target's CMake block was re-placed by hand after 2174's.
RPCS3 is cited in comments as a behaviour reference only; no RPCS3 code.
The clamp bit of SET_ZMIN_MAX_CONTROL goes into the pipeline key and is applied with
setDepthClipMode, so shadow casters drawn with clipping off and clamping on are pressed onto
the near plane instead of cut ("pancaking"); without it shadows from casters between the
light and the near cascade vanish. The D3D12 path already did this (patch 2068).
Off by default, like 2174: the menu text, in-game text and floor textures broke on the macOS
bring-up with the two on; PS3RECOMP_ENG_DEPTH_CLAMP=1 turns it on. Host test:
tools/runtime/test_metal_lighting.py.

Backends: rsx_dispatch.c seeds SET_ZMIN_MAX_CONTROL's reset value (1) on every platform; the
D3D12 path (rsx_live_draw.c, patch 2068) reads that register only once the title has written it
(rsx->seen), so it is unaffected. The draw engine (Metal and Vulkan) sets rs->depth_clamp only
with PS3RECOMP_ENG_DEPTH_CLAMP=1; Vulkan then also asks for the depthClamp device feature it
already reports. With the default off the pipeline keys differ only by a zero field.

diff --git a/libs/video/rsx_dispatch.c b/libs/video/rsx_dispatch.c
--- a/libs/video/rsx_dispatch.c
+++ b/libs/video/rsx_dispatch.c
@@ -184,6 +184,12 @@
      * clear consumers, mirroring COLOR_MASK/FRONT_FACE above. */
     rsx->regs[0x1D8C >> 2] = RSX_DSP_ZSTENCIL_CLEAR_RESET;
 
+    /* NV40 reset ZMIN_MAX_CONTROL (0x1D78) is 1: clip at the near and far
+     * planes, no depth clamp (RPCS3 rsx_methods.cpp; the GCM default of
+     * cellGcmSetZMinMaxControl(TRUE, FALSE, FALSE)). Seeded so a raw 0 means
+     * a title that turned clipping off. */
+    rsx->regs[0x1D78 >> 2] = 0x00000001u;
+
     /* Execution methods */
     mark_class(rsx, M_VERTEX_BEGIN_END,  1, RSX_DSP_CLASS_EXEC);
     mark_class(rsx, M_VB_VERTEX_BATCH,   1, RSX_DSP_CLASS_EXEC);
diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -95,6 +95,7 @@
 #define M_POLY_OFFSET_FILL    0x0A68
 #define M_POLY_OFFSET_FACTOR  0x0A78
 #define M_POLY_OFFSET_BIAS    0x0A7C
+#define M_ZMIN_MAX_CONTROL    0x1D78
 
 /* ---- module state -------------------------------------------------------- */
 
@@ -316,6 +317,18 @@
 }
 
 /* ---- render state -------------------------------------------------------- */
+
+/* Off unless PS3RECOMP_ENG_DEPTH_CLAMP=1: always clip at the near and far
+ * planes, as before SET_ZMIN_MAX_CONTROL was honoured. */
+static int eng_depth_clamp_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("PS3RECOMP_ENG_DEPTH_CLAMP");
+        on = e && *e && atoi(e) != 0;   /* off by default (see the header) */
+    }
+    return on;
+}
 
 void rsx_draw_engine_decode_render_state(const rsx_dispatch* rsx,
                                          rsx_be_render_state* rs)
@@ -360,6 +373,17 @@
     rs->bs_zfail     = rsx_dsp_reg(rsx, M_BACK_STENCIL_OP_ZFAIL);
     rs->bs_zpass     = rsx_dsp_reg(rsx, M_BACK_STENCIL_OP_ZPASS);
     rs->depth_bounds_test = rsx_dsp_reg(rsx, M_DEPTH_BOUNDS_ENABLE) & 1;
+    /* SET_ZMIN_MAX_CONTROL (cellGcmSetZMinMaxControl): bits 0-3 clip at the
+     * near and far planes, 4-7 clamp the depth, 8-11 clip ignoring W; reset
+     * value 1 (rsx_dispatch_init). As RPCS3's Vulkan renderer: clamp when the
+     * clamp is on or near/far clipping is off. Shadow-map passes draw their
+     * casters this way ("pancaking"): a caster between the light and the
+     * cascade's near plane lands on depth 0 instead of being cut away, so
+     * clipped, the shadows of tall objects vanish from the near cascade. */
+    {
+        const u32 z = rsx_dsp_reg(rsx, M_ZMIN_MAX_CONTROL);
+        rs->depth_clamp = eng_depth_clamp_on() && ((z & 0xF0u) != 0 || (z & 0x0Fu) == 0);
+    }
 }
 
 u64 rsx_draw_engine_hash_render_state(const rsx_be_render_state* rs, u64 hash)
@@ -402,6 +426,7 @@
     ENG_HASH_FIELD(bs_zfail);
     ENG_HASH_FIELD(bs_zpass);
     ENG_HASH_FIELD(depth_bounds_test);
+    ENG_HASH_FIELD(depth_clamp);
 #undef ENG_HASH_FIELD
     return hash;
 }
diff --git a/libs/video/rsx_draw_engine.h b/libs/video/rsx_draw_engine.h
--- a/libs/video/rsx_draw_engine.h
+++ b/libs/video/rsx_draw_engine.h
@@ -94,6 +94,10 @@
     u32 rt_fp16;                    /* the target is an FP16 HDR surface */
     u32 stencil_enable, stencil_two_sided;
     u32 depth_bounds_test;          /* SET_DEPTH_BOUNDS_TEST_ENABLE */
+    /* 1: clamp the depth to [0, 1] instead of clipping at the near and far
+     * planes (SET_ZMIN_MAX_CONTROL 0x1D78: clamp set, or near/far clipping
+     * off). A backend without depth clamping draws it clipped. */
+    u32 depth_clamp;
     u32 s_func, s_func_mask, s_write_mask, s_fail, s_zfail, s_zpass;
     u32 bs_func, bs_fail, bs_zfail, bs_zpass;
 } rsx_be_render_state;

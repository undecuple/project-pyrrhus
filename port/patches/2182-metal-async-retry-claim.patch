+            if (!inline_bld) { b->worker_building = 1; pthread_mutex_unlock(&s_eng_build_lock); break; }
+            pthread_mutex_unlock(&s_eng_build_lock);
             usleep(1000);
         }
         const u32 handle = eng_pipeline_create_sync(NULL, b->vs_hlsl, b->ps_hlsl,
@@ -3896,7 +3901,7 @@ static u32 eng_pipeline_create(void* user, const char* vs_hlsl, const char* ps_h
             pthread_mutex_unlock(&s_eng_build_lock);
             return result;
         }

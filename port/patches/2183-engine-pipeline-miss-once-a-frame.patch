     if (rt_count > RSX_BE_MAX_COLOR_TARGETS) rt_count = RSX_BE_MAX_COLOR_TARGETS;
@@ -3921,6 +3928,7 @@ static u32 eng_pipeline_create(void* user, const char* vs_hlsl, const char* ps_h
                 if (now - e->queued_us < 5000000ull ||   /* young: the worker has it */
                     now - s_last_inline_us < 100000ull) {  /* one at a time */
                     pthread_mutex_unlock(&s_eng_build_lock);
+                    s_eng_last_pending = 1;
                     return 0;
                 }
                 s_last_inline_us = now;
@@ -3941,6 +3949,7 @@ static u32 eng_pipeline_create(void* user, const char* vs_hlsl, const char* ps_h
             return handle;
         }
         pthread_mutex_unlock(&s_eng_build_lock);
+        s_eng_last_pending = 1;   /* a worker or an inline retry has it */
         return 0;
     }
     if (s_eng_build_count >= ENG_ASYNC_MAX || s_eng_pipe_count >= ENG_MAX_PIPES) {
@@ -3950,6 +3959,7 @@ static u32 eng_pipeline_create(void* user, const char* vs_hlsl, const char* ps_h
     /* Patch 2181: the record happened above (sync or async alike); hand the
      * build to a worker. The lock is eng_async_insert's contract. */
     eng_async_insert(key, vs_hlsl, ps_hlsl, rs, layout, vertex_stride, rt_fmt, rt_count);
+    s_eng_last_pending = 1;
     return 0;
 }
 

KZ2 patch 2183: a pipeline whose background build is still in flight is asked
for once a frame; a pipeline that failed to build is remembered, as before 2179.

Written for the Pyrrhus native Mac bring-up; no game code or RPCS3 code used.
Licence: MIT (project LICENSE).

Patch 2179 stopped memoizing a 0 from pipeline_create, so a pipeline still
building in the background is picked up as soon as it lands. But each ask
decompiles the vertex and fragment programs to HLSL, applies the text passes
and hashes both texts -- for every draw of that pipeline, hundreds a frame, on
the FIFO walker that bounds the frame rate (a Metal gameplay profile had the
walker 78 % busy, its largest items strstr 14 %, snprintf 12 % and fnv1a64 9 %
from that path) -- and a pipeline that failed for good paid it, and logged it,
on every draw for the rest of the session.

The backend now says which 0 it gave: the optional pipeline_pending query
(rsx_draw_engine.h) is 1 while a build of that pipeline is in flight. Such a
key is asked again once a frame (a small lossy table of keys and frames); any
other 0 is memoized as before 2179, so a failed pipeline is neither rebuilt nor
logged again. The log names the two cases ("building" / "FAILED").

Backends: only Metal implements pipeline_pending (only it builds in the
background). On Vulkan, the other user of the draw engine, the query is NULL,
every 0 is final and the engine behaves as before patch 2179. D3D12 does not use
the draw engine.

diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
index 753563d..a398f2d 100644
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -1946,6 +1946,20 @@ static u32 eng_user_clip_key(void)
  * RSX_FP_DEBUG matches in the decompiler. Unlike a backend pipeline handle it
  * does not depend on the order programs are first drawn in, so a program
  * found in one run is named the same in the next. 0 for the built-in one. */
+/* Patch 2183: pipelines whose build is still in flight (pipeline_pending), with
+ * the frame they were last asked for. Patch 2179 stopped memoizing a 0 so a
+ * background build is picked up when it lands, but each ask decompiles both
+ * programs to text and hashes them, for every draw of the pipeline -- hundreds
+ * a frame on the FIFO walker that bounds the frame rate (strstr, snprintf and
+ * fnv1a64 were its largest items in a Metal gameplay profile). A pending key
+ * is asked again once a frame; a final 0 is memoized as before 2179, so a
+ * pipeline that fails to build is neither retried nor logged per draw. On a
+ * backend without pipeline_pending (Vulkan) every 0 is final, as before 2179.
+ * Lossy: a collision only costs an ask. */
+#define ENG_MISS_SLOTS 1024u
+static struct { u64 key; u32 frame; u32 used; } s_eng_miss[ENG_MISS_SLOTS];
+static u32 eng_miss_slot(u64 key) { return (u32)(key ^ (key >> 32) ^ (key >> 17)) & (ENG_MISS_SLOTS - 1u); }
+
 static u64 eng_fp_debug_hash(const u8* fp_uc, u32 fp_size)
 {
     return fp_uc && fp_size
@@ -2150,6 +2164,15 @@ static u32 eng_pipeline_get(const rsx_vertex_layout_plan* layout,
         }
     }
     if (g.n_pipelines >= ENG_MAX_PIPELINES) return 0;
+    {
+        const u32 ms = eng_miss_slot(key);
+        if (s_eng_miss[ms].used && s_eng_miss[ms].key == key && s_eng_miss[ms].frame == g.frames) {
+            *out_tex_used = fixed ? 0xFFFFu : 0u;
+            *out_fp_hash = fixed ? 0 : eng_fp_debug_hash(fp_uc, fp_size);
+            *out_fixed = fixed;
+            return 0;   /* still building, asked this frame already: the draw drops as it would */
+        }
+    }
 
     u32 handle = 0;
     int vi = 1, fi = 1;
@@ -2234,18 +2257,23 @@ static u32 eng_pipeline_get(const rsx_vertex_layout_plan* layout,
             }
         }
     }
+    const int pending = !handle && vi > 0 && fi > 0 && g.be->pipeline_pending &&
+                        g.be->pipeline_pending(g.be->user);   /* patch 2183 */
     { static u32 logs = 0; if (PS3_LOG_FIRST(logs, 32))
         fprintf(stderr, "[rsx engine] pipeline %016llx: %s vp %d, fp %d,"
                         " %u constants, fp %016llx -> %s\n",
                 (unsigned long long)key, fixed ? "built-in" : "guest",
                 vi, fi, nconst, (unsigned long long)fp_hash,
-                handle ? "ok" : "FAILED (draw dropped)"); }
+                handle ? "ok" : pending ? "building (draw dropped)" : "FAILED (draw dropped)"); }
 
     /* Patch 2179: a miss is not memoized. The backend answers 0 for a build
      * still in flight (or one that failed hard, which it answers forever),
      * and the next draw asks again; memoizing the miss would freeze the
-     * pipeline's draws at one dropped attempt. */
-    if (handle) {
+     * pipeline's draws at one dropped attempt. Patch 2183: that holds only
+     * while pipeline_pending says a build is in flight; a final 0 (a failed
+     * build, or any 0 from a backend without the query) is memoized, as before
+     * patch 2179, so it is neither rebuilt nor logged again. */
+    if (!pending) {
         g.pipelines[g.n_pipelines].key = key;
         g.pipelines[g.n_pipelines].fp_hash = fp_hash;
         g.pipelines[g.n_pipelines].handle = handle;
@@ -2259,6 +2287,8 @@ static u32 eng_pipeline_get(const rsx_vertex_layout_plan* layout,
     } else {
         *out_tex_used = (u16)(fixed ? 0xFFFFu : dbz_bit);
         *out_fp_hash = fp_hash;
+        const u32 ms = eng_miss_slot(key);
+        s_eng_miss[ms].key = key; s_eng_miss[ms].frame = g.frames; s_eng_miss[ms].used = 1;
     }
     *out_fixed = fixed;
     return handle;

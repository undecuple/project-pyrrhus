                             u32 vertex_stride, rsx_be_format rt_fmt,
                             u32 rt_count);
     void (*pipeline_release)(void* user, u32 pipeline);
+    /* Optional (KZ2 patch 2183; NULL = never pending). After pipeline_create
+     * returned 0: 1 when a build of it is still in flight, so the engine asks
+     * again on a later frame; 0 when the 0 is final, so the engine remembers
+     * the failure and drops that pipeline's draws without asking again. Only
+     * the Metal backend builds in the background (patch 2179). */
+    int  (*pipeline_pending)(void* user);
 
     /* Per-draw binding. The backend owns every ring the D3D12 engine used to
      * own itself, so the engine hands over CPU-side arrays and never mentions
diff --git a/libs/video/rsx_metal_backend.m b/libs/video/rsx_metal_backend.m

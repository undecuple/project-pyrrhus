     static unsigned logs;
     if (logs < 16) { logs++; fprintf(stderr, "[iscale] %s: mapping refused (status %d, %u, %u)\n", where, st, a, b); }
 }
+/* KZ2 patch 2301, ENHANCEMENT: RSX_INTERNAL_SCALE, the internal resolution scale the player asks for (issue #55).
+ * Default (unset or empty): 1, the PS3's own resolution. Accepted: 1 or 2, optionally written 1x or 2x
+ * (rsx_iscale_parse_switch); any other value is refused with one log line and the game renders at 1x. Read once, when
+ * live-draw starts, and logged once under [iscale]. EXPERIMENTAL: 2 is accepted but not active in this patch;
+ * ld_iscale() stays native until the scaled allocation and the native-size guards at every guest-visible boundary
+ * (write-back, NV0039 copies, reports) are in. The game always sees its own resolution. */
+static rsx_iscale_grid ld_iscale_requested(void)
+{
+    static int read;
+    static rsx_iscale_grid req;
+    if (!read) {
+        read = 1;
+        const char* e = getenv("RSX_INTERNAL_SCALE");
+        const rsx_iscale_status st = rsx_iscale_parse_switch(e, &req);
+        if (st != RSX_ISCALE_OK)
+            fprintf(stderr, "[iscale] RSX_INTERNAL_SCALE=\"%s\" is not 1 or 2: rendering at 1x\n", e);
+        else if (!rsx_iscale_grid_is_native(req))
+            fprintf(stderr, "[iscale] RSX_INTERNAL_SCALE=%u requested; the scaled path is not in this build yet: "
+                            "rendering at 1x\n", (unsigned)req.x);
+        else
+            fprintf(stderr, "[iscale] internal scale 1x\n");
+    }
+    return req;
+}
 
 typedef struct {
     u32 location, offset;
@@ -15444,6 +15468,7 @@
     sink.report = sink_report;   /* patch 2025 */
     rsx_dispatch_init(&g.rsx, &sink);
 
+    (void)ld_iscale_requested();   /* KZ2 patch 2301: read and log RSX_INTERNAL_SCALE once, at start */
     g.ready = 1;
     g.enabled = 1;
     return 0;

+/* A count of covered physical texels (an occlusion / ZPASS report) -> the count at the guest's resolution: divided by
+ * the texels per guest sample (g.x * g.y), rounded up, so any coverage still counts at least 1 and a zero stays zero.
+ * A count above UINT32_MAX saturates first. An invalid grid returns the count unchanged (the identity is the only
+ * answer that never hides a draw). */
+static inline uint32_t rsx_iscale_count_to_guest(uint64_t physical, rsx_iscale_grid g)
+{
+    const uint32_t v = physical > 0xFFFFFFFFull ? 0xFFFFFFFFu : (uint32_t)physical;
+    if (!rsx_iscale_grid_ok(g)) return v;
+    const uint32_t k = g.x * g.y;   /* <= 16 * 16 */
+    return v / k + (v % k != 0u);
+}

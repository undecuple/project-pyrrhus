+/* ===== KZ2 patch 2302: the guest-visible boundary of a scaled surface (issue #55, the maintainer's condition: the game
+ * only ever sees its own resolution). A scaled colour surface gets a companion at its guest size (w x h, same format,
+ * RENDER_TARGET like the surface, made on first need and replaced with the surface):
+ *  - colour leaving the GPU (write-back, NV0039 copies through it, readbacks): ld_is_down refreshes the companion from
+ *    the surface (one pass, scale x scale texels per guest texel) and the existing copy then reads the companion;
+ *  - guest bytes entering the surface (ld_gv_upload_rows): the rows land in the companion as before, then
+ *    ld_is_up_rows expands them nearest-neighbour into the surface.
+ * The pass averages the texels of a colour surface (R8G8B8A8_UNORM, R16G16B16A16_FLOAT) and takes the top-left one of
+ * a data surface (R32_FLOAT), so data values are never blended. ASSUMPTION: an RGBA8 or FP16 surface that reaches the
+ * guest holds colour (Killzone 2's scene copy for the SPU post chain); a byte-packed RGBA8 data target written back
+ * would be averaged. Native scale: none of this runs and every caller uses the surface itself. Written for this port;
+ * RPCS3 was not consulted. */
+/* One SRV per surface for its companion, after the CPU heap's other slots (the heap is made that much larger); their
+ * RTVs follow the surfaces'. */
+#define SRV_ISNAT_BASE     SRV_CPU_HEAP_SLOTS
+#define LD_RTV_ISNAT_BASE  (LD_SWAP_BUFFERS + MAX_SURFACES)
+static ID3D12RootSignature* g_is_rs;
+static struct { DXGI_FORMAT fmt; ID3D12PipelineState* pso; } g_is_pso[4];
+static int g_is_failed;
+static u64 g_is_downs, g_is_ups;
+
+static ID3D12PipelineState* ld_is_pso(DXGI_FORMAT fmt)
+{
+    for (int i = 0; i < 4; i++)
+        if (g_is_pso[i].pso && g_is_pso[i].fmt == fmt) return g_is_pso[i].pso;
+    if (g_is_failed) return NULL;
+    static const char src[] =
+        "Texture2D<float4> s : register(t0);\n"
+        "cbuffer c : register(b0) { int sx; int sy; int mode; };\n"
+        "float4 vs(uint id : SV_VertexID) : SV_Position {\n"
+        "    float2 t = float2((id << 1) & 2, id & 2);\n"
+        "    return float4(t * float2(2, -2) + float2(-1, 1), 0, 1);\n"
+        "}\n"
+        "float4 ps(float4 p : SV_Position) : SV_Target {\n"
+        "    int2 q = int2(p.xy);\n"
+        "    if (mode == 0) return s.Load(int3(q.x / sx, q.y / sy, 0));\n"   /* expand: nearest */
+        "    int2 b = q * int2(sx, sy);\n"
+        "    if (mode == 2) return s.Load(int3(b, 0));\n"                     /* data: one texel */
+        "    float4 a = 0;\n"
+        "    for (int y = 0; y < sy; y++)\n"
+        "        for (int x = 0; x < sx; x++) a += s.Load(int3(b + int2(x, y), 0));\n"
+        "    return a / (float)(sx * sy);\n"
+        "}\n";
+    HRESULT hr = S_OK;
+    if (!g_is_rs) {
+        D3D12_DESCRIPTOR_RANGE range = {0};
+        range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+        range.NumDescriptors = 1;
+        D3D12_ROOT_PARAMETER rp[2] = {0};
+        rp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+        rp[0].Constants.Num32BitValues = 3;
+        rp[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+        rp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        rp[1].DescriptorTable.NumDescriptorRanges = 1;
+        rp[1].DescriptorTable.pDescriptorRanges = &range;
+        rp[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+        D3D12_ROOT_SIGNATURE_DESC rsd = {0};
+        rsd.NumParameters = 2; rsd.pParameters = rp;
+        ID3DBlob* sig = NULL; ID3DBlob* err = NULL;
+        hr = D3D12SerializeRootSignature(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err);
+        if (err) err->lpVtbl->Release(err);
+        if (SUCCEEDED(hr)) {
+            hr = g.dev->lpVtbl->CreateRootSignature(g.dev, 0, sig->lpVtbl->GetBufferPointer(sig),
+                    sig->lpVtbl->GetBufferSize(sig), &IID_ID3D12RootSignature, (void**)&g_is_rs);
+            sig->lpVtbl->Release(sig);
+        }
+        if (FAILED(hr)) g_is_rs = NULL;
+    }
+    ID3DBlob *vsb = NULL, *psb = NULL, *err = NULL;
+    if (SUCCEEDED(hr) && g_is_rs)
+        hr = D3DCompile(src, sizeof(src) - 1u, "iscale_resample", NULL, NULL, "vs", "vs_5_0",
+                        D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &vsb, &err);
+    if (err) { if (FAILED(hr)) fprintf(stderr, "[iscale] VS: %s\n", (const char*)err->lpVtbl->GetBufferPointer(err));
+               err->lpVtbl->Release(err); err = NULL; }
+    if (SUCCEEDED(hr) && vsb)
+        hr = D3DCompile(src, sizeof(src) - 1u, "iscale_resample", NULL, NULL, "ps", "ps_5_0",
+                        D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &psb, &err);
+    if (err) { if (FAILED(hr)) fprintf(stderr, "[iscale] PS: %s\n", (const char*)err->lpVtbl->GetBufferPointer(err));
+               err->lpVtbl->Release(err); err = NULL; }
+    ID3D12PipelineState* pso = NULL;
+    if (SUCCEEDED(hr) && vsb && psb) {
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = {0};
+        pd.pRootSignature = g_is_rs;
+        pd.VS.pShaderBytecode = vsb->lpVtbl->GetBufferPointer(vsb);
+        pd.VS.BytecodeLength = vsb->lpVtbl->GetBufferSize(vsb);
+        pd.PS.pShaderBytecode = psb->lpVtbl->GetBufferPointer(psb);
+        pd.PS.BytecodeLength = psb->lpVtbl->GetBufferSize(psb);
+        pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+        pd.SampleMask = 0xFFFFFFFFu;
+        pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+        pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+        pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+        pd.NumRenderTargets = 1;
+        pd.RTVFormats[0] = fmt;
+        pd.SampleDesc.Count = 1;
+        hr = g.dev->lpVtbl->CreateGraphicsPipelineState(g.dev, &pd, &IID_ID3D12PipelineState, (void**)&pso);
+    }
+    if (vsb) vsb->lpVtbl->Release(vsb);
+    if (psb) psb->lpVtbl->Release(psb);
+    if (FAILED(hr) || !pso) {
+        fprintf(stderr, "[iscale] resample pipeline for format %u failed hr=0x%08lX: scaled surfaces of that format "
+                        "are not written back\n", (unsigned)fmt, (unsigned long)hr);
+        if (!g_is_rs) g_is_failed = 1;
+        return NULL;
+    }
+    for (int i = 0; i < 4; i++)
+        if (!g_is_pso[i].pso) { g_is_pso[i].fmt = fmt; g_is_pso[i].pso = pso; return pso; }
+    pso->lpVtbl->Release(pso);   /* more formats than live-draw makes (ld_color_dxgi): refuse */
+    return NULL;
+}
+
+/* One resample pass: src (SRV slot src_srv; RENDER_TARGET, restored) drawn into the render target dst_rtv of fmt,
+ * dst_w x dst_h, rows [y0, y1) only. mode 0 = expand by the scale (nearest), 1 = box, 2 = top-left texel. */
+static int ld_is_pass(ID3D12Resource* src, u32 src_srv, D3D12_CPU_DESCRIPTOR_HANDLE dst_rtv, DXGI_FORMAT fmt,
+                      u32 mode, u32 dst_w, u32 dst_h, u32 y0, u32 y1)
+{
+    ID3D12PipelineState* pso = ld_is_pso(fmt);
+    if (!pso || !src || y0 >= y1 || y1 > dst_h) return 0;
+    u32 slots[SRV_TABLE_SIZE];
+    for (u32 i = 0; i < SRV_TABLE_SIZE; i++) slots[i] = SRV_WHITE;
+    slots[0] = src_srv;
+    D3D12_GPU_DESCRIPTOR_HANDLE table = srv_table(slots);
+    if (!table.ptr) {   /* ring full: as the draw path, submit and reuse the ring */
+        ld_flush(LD_FLUSH_DESCRIPTOR_RING);
+        if (!g.ready) return 0;
+        g.srv_ring_used = 0; g_srv_desc_gen++;
+        g.smp_ring_used = 0;
+        table = srv_table(slots);
+        if (!table.ptr) return 0;
+    }
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = src;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+    g.list->lpVtbl->OMSetRenderTargets(g.list, 1, &dst_rtv, FALSE, NULL);
+    ID3D12DescriptorHeap* heaps[] = {g.srv_heap, g.smp_heap};
+    g.list->lpVtbl->SetDescriptorHeaps(g.list, 2, heaps);
+    g.list->lpVtbl->SetPipelineState(g.list, pso);
+    g.list->lpVtbl->SetGraphicsRootSignature(g.list, g_is_rs);
+    LD_SM_INVALIDATE();   /* own PSO, root signature, heaps, RT, viewport: the next draw re-records all */
+    const u32 c[3] = { g_ld_iscale.x, g_ld_iscale.y, mode };
+    g.list->lpVtbl->SetGraphicsRoot32BitConstants(g.list, 0, 3, c, 0);
+    g.list->lpVtbl->SetGraphicsRootDescriptorTable(g.list, 1, table);
+    const D3D12_VIEWPORT vp = { 0.0f, 0.0f, (float)dst_w, (float)dst_h, 0.0f, 1.0f };
+    const D3D12_RECT sc = { 0, (LONG)y0, (LONG)dst_w, (LONG)y1 };
+    g.list->lpVtbl->RSSetViewports(g.list, 1, &vp);
+    g.list->lpVtbl->RSSetScissorRects(g.list, 1, &sc);
+    g.list->lpVtbl->IASetPrimitiveTopology(g.list, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    g.list->lpVtbl->DrawInstanced(g.list, 3, 1, 0, 0);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+    return 1;
+}
+
+/* The companion of surface si (made or remade for its current resource), RENDER_TARGET; NULL if it cannot be made. */
+static ID3D12Resource* ld_is_nat(u32 si)
+{
+    surface_t* s = &g.surfaces[si];
+    if (!s->tex) return NULL;
+    if (s->nat && s->nat_src == s->tex) return s->nat;
+    if (s->nat) { retire_texture(s->nat); s->nat = NULL; s->nat_src = NULL; }
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC rd = {0};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    rd.Width = s->w; rd.Height = s->h; rd.DepthOrArraySize = 1;
+    rd.MipLevels = 1; rd.Format = s->fmt; rd.SampleDesc.Count = 1;
+    rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    D3D12_CLEAR_VALUE cv = {0}; cv.Format = s->fmt;
+    ID3D12Resource* nat = NULL;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+            D3D12_RESOURCE_STATE_RENDER_TARGET, &cv, &IID_ID3D12Resource, (void**)&nat))) {
+        static u32 n_fail;
+        if (n_fail++ < 8)
+            fprintf(stderr, "[iscale] native companion %u:0x%X %ux%u failed: not written back\n", s->location, s->offset,
+                    s->w, s->h);
+        return NULL;
+    }
+    LD_SM_INVALIDATE(), g.dev->lpVtbl->CreateRenderTargetView(g.dev, nat, NULL, rtv_handle(LD_RTV_ISNAT_BASE + si));
+    srv_write(SRV_ISNAT_BASE + si, nat);
+    s->nat = nat; s->nat_src = s->tex;
+    static u32 n_log;
+    if (n_log++ < 16)
+        fprintf(stderr, "[iscale] surface %u:0x%X %ux%u (host %ux%u): native companion for the guest's view (slot %u)\n",
+                s->location, s->offset, s->w, s->h, s->phys_w, s->phys_h, si);
+    return nat;
+}
+
+/* The resource that holds surface si at its guest size, RENDER_TARGET: the surface itself at the native scale, else
+ * its companion, refreshed from the surface now (recorded into the open list). NULL = no native-size image: the
+ * caller copies nothing (a copy of the scaled resource would not fit the guest's footprint). */
+static ID3D12Resource* ld_is_down(u32 si)
+{
+    surface_t* s = &g.surfaces[si];
+    if (!ld_iscale_on()) return s->tex;
+    ID3D12Resource* nat = ld_is_nat(si);
+    if (!nat) return NULL;
+    const u32 mode = s->fmt == DXGI_FORMAT_R8G8B8A8_UNORM || s->fmt == DXGI_FORMAT_R16G16B16A16_FLOAT ? 1u : 2u;
+    if (!ld_is_pass(s->tex, SRV_SURFACE_BASE + si, rtv_handle(LD_RTV_ISNAT_BASE + si), s->fmt, mode, s->w, s->h, 0u,
+                    s->h)) return NULL;
+    if (g_is_downs++ < 4 || !(g_is_downs & 0xFFFu))
+        fprintf(stderr, "[iscale] down #%llu: surface %u:0x%X %ux%u -> %ux%u (%s) frame %u\n",
+                (unsigned long long)g_is_downs, s->location, s->offset, s->phys_w, s->phys_h, s->w, s->h,
+                mode == 1u ? "box" : "one texel", g_ld_frames);
+    return nat;
+}
+
+/* After guest rows [y0, y1) were copied into the companion of si: expand them into the surface. */

+/* KZ2 4022: the live stop of an outside-contact diagnostic (Killzone 2's KZ2_NET_LISTEN run). With a stop armed,
+ * the first refusal in strict mode, a destination (connect / sendto) or a host name (gethostbyname, cellHttp, a DNS
+ * query answered locally), prints one "[net] refused ..." line that names no address and no host name (the address
+ * class, the port, the name's length), then calls the stop, which ends the process. NULL disarms (default). A
+ * denied name stops in any mode. */
+typedef void (*ps3_net_policy_stop_fn)(void);
+void ps3_net_policy_set_live_stop(ps3_net_policy_stop_fn fn);
+/* "loopback", "multicast", "private", "special" or "public" for a network-order IPv4 address. */
+const char* ps3_net_policy_addr_class(const uint8_t ip[4]);
+

-    if (!norm_name(name, n)) return s_strict ? 0 : -1;   /* odd names: the host resolver judges them */
-    if (denied(n)) return 0;
+    ps3_net_policy_stop_fn stop = __atomic_load_n(&s_live_stop, __ATOMIC_ACQUIRE);
+    if (!norm_name(name, n)) {                            /* odd names: the host resolver judges them */
+        if (s_strict && stop) live_stop_refused(stop, "a host name the policy cannot read");
+        return s_strict ? 0 : -1;
+    }
+    if (denied(n)) {
+        if (stop) live_stop_refused(stop, "a denied host name");
+        return 0;
+    }
     for (int i = 0; i < s_nmap; i++)
         if (!strcmp(n, s_map[i].name)) { memcpy(ip, s_map[i].ip, 4); return 1; }
-    return s_strict ? 0 : -1;
+    if (s_strict) {
+        if (stop) {
+            char what[64];
+            snprintf(what, sizeof what, "a host name (%u characters, not mapped)", (unsigned)strlen(n));
+            live_stop_refused(stop, what);
+        }
+        return 0;
+    }
+    return -1;
 }
 

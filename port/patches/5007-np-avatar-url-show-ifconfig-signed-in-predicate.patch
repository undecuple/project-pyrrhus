+/* KZ2 patch 5007: sys_net_show_ifconfig (NID 0xB48636C4 = ps3_compute_nid("sys_net_show_ifconfig")), no arguments.
+ * A libnet debug call: the firmware prints its interface table on the console's TTY and returns 0; it changes no
+ * state and opens nothing. Killzone 2 1.29 calls it from two sites (bl @0x00812228 and @0x00A5BE1C, stub 0xBCCC84);
+ * an earlier change's run reached it once, right after the network start dialog. The host's own interfaces are not listed (they are the player's machine, not the console's); one log line,
+ * then 0. RPCS3's sys_net_.cpp also answers CELL_OK (read, not copied). */
+int32_t sys_net_show_ifconfig(void)
+{
+    static int logged = 0;
+    if (!logged) { logged = 1; printf("[sys_net] show_ifconfig() -> 0 (TTY listing not printed)\n"); }
+    return 0;
+}

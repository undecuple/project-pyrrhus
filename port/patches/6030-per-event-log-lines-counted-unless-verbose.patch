diff --git a/runtime/ps3_log.h b/runtime/ps3_log.h
--- a/runtime/ps3_log.h
+++ b/runtime/ps3_log.h
@@ -45,4 +45,24 @@ static __inline int ps3_log_verbose(void)
     return v;
 }
 
+/* KZ2 patch 6030: per-event lines (one per SPURS task created, started, run or ended, one per GCM user handler
+ * set). Killzone 2 makes about 150 such events a second in a level. Printed every time when PS3_LOG_EVENTS=1, or
+ * when it is unset and ps3_log_verbose();
+ * otherwise the first 8, then one count line at each power of two, so a quiet log still says how often:
+ *     static long _n; if (ps3_log_event(&_n, "spurs task created")) printf(...);  */
+#ifdef __cplusplus
+static inline int ps3_log_event(long* ctr, const char* what)
+#else
+static __inline int ps3_log_event(long* ctr, const char* what)
+#endif
+{
+    static int on = -1;   /* PS3_LOG_EVENTS=0|1 decides for these lines alone; unset: ps3_log_verbose() */
+    long n = __atomic_add_fetch(ctr, 1, __ATOMIC_RELAXED);
+    if (on < 0) { const char* e = getenv("PS3_LOG_EVENTS"); on = e ? (e[0] && e[0] != '0') : ps3_log_verbose(); }
+    if (on || n <= 8) return 1;
+    if ((n & (n - 1)) == 0)
+        fprintf(stderr, "[log] %s: %ld so far (PS3_VERBOSE=1 prints each)\n", what, n);
+    return 0;
+}
+
 #endif /* PS3_LOG_H */

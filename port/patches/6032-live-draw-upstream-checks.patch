@@ -13975,6 +14053,15 @@ static void sink_end_impl(void* user, const rsx_dispatch* r)
                         "zslot=%u self=%d\n", g_ld_frames, rsx_dsp_reg(&g.rsx, 0x1D60), g.surfaces[target].location,
                         g.surfaces[target].offset, u, t.offset, sampled, zeta_pref, current_zslot, self_zeta_read);
         }
+        if (ld_upchk_on()) {   /* patch 6032: #508, #501 */

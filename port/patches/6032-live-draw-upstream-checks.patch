         static u32 n_log;
         if (n_log++ < 16)
@@ -10403,6 +10479,8 @@ static int fetch_attr(u32 i, u32 base, u32 vertex_id, u32 base_index,
         if (at + elem_size > dc.inl_bytes) return 0;

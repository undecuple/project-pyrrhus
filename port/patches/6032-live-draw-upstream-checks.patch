-        if (z->win[k].tex) retire_texture(z->win[k].tex);   /* the open command list may still read it */
+        if (z->win[k].tex) { retire_texture(z->win[k].tex); g_upchk_zwin_ret++; }   /* the open command list may still read it */
         z->win[k].tex = NULL;
         D3D12_HEAP_PROPERTIES hp = {0};
         hp.Type = D3D12_HEAP_TYPE_DEFAULT;
@@ -6962,6 +7037,7 @@ static int zdepth_window(u32 i, u32 w, u32 h)
             return -1;
         }
         z->win[k].tex = t; z->win[k].w = w; z->win[k].h = h; z->win[k].gen = z->snap_gen - 1u;
+        g_upchk_zwin_new++;   /* patch 6032 */

+/* KZ2 patch 6032 (diagnostic, LD_UPCHK=1): checks of the live draw against upstream PRs #501, #502, #504 and #508.
+ * #501: every bind of a depth-format texture (DEPTH24_D8/_FLOAT, DEPTH16/_FLOAT) is counted by format, crossbar
+ *       (CONTROL1 remap) and the path that served it: zeta snapshot, zeta window (2063), CPU decode, colour surface.
+ * #502: depth snapshots and zeta windows created and retired, the texture cache size and textures retired, so a
+ *       per-frame leak shows as a live count that keeps growing.
+ * #504: vertex array fetches whose base + offset sum is at or past 0x10000000 (fetch_attr and the compact plan).
+ * #508: binds of a compressed (DXT1/23/45) texture that matched a render target (colour surface or feedback copy).
+ * A summary line every 512 frames ("[upchk]"), first examples as "[upchk] ex". Off: no cost but one cached getenv. */
+static int ld_upchk_on(void)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("LD_UPCHK") ? 1 : 0;
+    return on;
+}
+enum { UPCHK_SNAP = 0, UPCHK_ZWIN, UPCHK_DECODE, UPCHK_SURF, UPCHK_NPATH };
+typedef struct { u32 fmt, remap, path; u64 n; } ld_upchk_row;
+static ld_upchk_row g_upchk_rows[48];
+static u32 g_upchk_nrows;
+static u64 g_upchk_snap_new, g_upchk_snap_ret, g_upchk_zwin_new, g_upchk_zwin_ret, g_upchk_retired;
+static u64 g_upchk_dxt_surf, g_upchk_vtx_hi;
+extern unsigned long long rsx_vc_hi_sum_n;   /* rsx_vertex_compact.c (patch 6032) */
+static void ld_upchk_depth_bind(const rsx_dsp_texture* t, u32 path)
+{
+    const u32 base = t->format & 0x9Fu;
+    if (base < 0x90u || base > 0x93u) return;
+    const u32 rm = (t->remap & 0xFFFFu) ? (t->remap & 0xFFFFu) : 0xAAE4u;
+    for (u32 i = 0; i < g_upchk_nrows; i++)
+        if (g_upchk_rows[i].fmt == base && g_upchk_rows[i].remap == rm && g_upchk_rows[i].path == path) {
+            g_upchk_rows[i].n++; return; }
+    if (g_upchk_nrows < 48) {
+        ld_upchk_row* r = &g_upchk_rows[g_upchk_nrows++];
+        r->fmt = base; r->remap = rm; r->path = path; r->n = 1;
+        fprintf(stderr, "[upchk] ex depth bind fmt=0x%02X remap=0x%04X path=%u %u:0x%08X %ux%u frame=%u\n",
+                base, rm, path, t->location, t->offset, t->width, t->height, g_ld_frames);
+    }
+}
+static void ld_upchk_dxt_surface(const rsx_dsp_texture* t, int surf)
+{
+    const u32 base = t->format & 0x9Fu;
+    if (base != 0x86u && base != 0x87u && base != 0x88u) return;
+    if (g_upchk_dxt_surf++ < 8)
+        fprintf(stderr, "[upchk] ex dxt-as-target fmt=0x%02X %u:0x%08X %ux%u -> surface %d frame=%u\n",
+                base, t->location, t->offset, t->width, t->height, surf, g_ld_frames);
+}
+static void ld_upchk_vtx_hi(u32 loc, u32 base, u32 off)
+{
+    if (g_upchk_vtx_hi++ < 8)
+        fprintf(stderr, "[upchk] ex vertex sum >= 0x10000000 loc=%u base=0x%08X offset=0x%08X frame=%u\n",
+                loc, base, off, g_ld_frames);
+}
+static void ld_upchk_tick(void)
+{
+    static u32 last;
+    if (g_ld_frames / 512u == last) return;
+    last = g_ld_frames / 512u;
+    static const char* pn[UPCHK_NPATH] = {"snap", "zwin", "decode", "surface"};
+    u32 zw_live = 0;
+    for (u32 i = 0; i < g.n_zdepths; i++)
+        for (u32 j = 0; j < LD_ZWIN_PER; j++) if (g.zdepths[i].win[j].tex) zw_live++;
+    u32 snap_live = 0;
+    for (u32 i = 0; i < g.n_zdepths; i++) if (g.zdepths[i].snapshot) snap_live++;
+    fprintf(stderr, "[upchk] frame=%u zetas=%u snap new=%llu ret=%llu live=%u zwin new=%llu ret=%llu live=%u "
+            "texcache=%u retired=%llu dxt-as-target=%llu vtx-hi=%llu+%llu\n", g_ld_frames, g.n_zdepths,
+            (unsigned long long)g_upchk_snap_new, (unsigned long long)g_upchk_snap_ret, snap_live,
+            (unsigned long long)g_upchk_zwin_new, (unsigned long long)g_upchk_zwin_ret, zw_live, g.n_textures,
+            (unsigned long long)g_upchk_retired, (unsigned long long)g_upchk_dxt_surf,
+            (unsigned long long)g_upchk_vtx_hi, (unsigned long long)rsx_vc_hi_sum_n);
+    for (u32 i = 0; i < g_upchk_nrows; i++)
+        fprintf(stderr, "[upchk]   depth fmt=0x%02X remap=0x%04X %s n=%llu\n", g_upchk_rows[i].fmt,
+                g_upchk_rows[i].remap, pn[g_upchk_rows[i].path], (unsigned long long)g_upchk_rows[i].n);
+}
 static void retire_texture(ID3D12Resource* tex)
 {
     if (!tex) return;
+    g_upchk_retired++;   /* patch 6032 */
     if (g.n_retired_textures >= MAX_RETIRED_TEXTURES)
         ld_flush(LD_FLUSH_RETIRE_QUEUE);
     g.retired_textures[g.n_retired_textures++] = tex;
@@ -6666,6 +6738,7 @@ static void zdepth_grow_snapshot(u32 i, u32 rt_w, u32 rt_h)
             z->location, z->offset, z->snapshot_w, z->snapshot_h, nw, nh);

sys_fs / cellFs: a file a FAT32 copy keeps as <name>.66600, <name>.66601, ... is opened, read and stat'ed as one file.

Symptom: a PS3 disc copied to a FAT32 drive keeps every file over 4 GiB as numbered parts; Killzone 2's
data_ps3.psarc (6,998,576,922 bytes) becomes data_ps3.psarc.66600 and .66601, and Killzone 3's public issue 4 came
from such a dump. The game opens data_ps3.psarc twice (lv2 sys_fs_open from guest code, then cellFsOpen for FIOS) and
stats it through cellFsStat; every one of those misses, and sys_fs's USRDIR flattening cannot even find the
PS3_GAME path because its fallbacks test candidates with stat(). Fix: a header-only part-set reader
(include/ps3emu/split_file.h, adapted from the Killzone 3 PC port's port/vfs/kz3_splitfile.h, Project Helghast v0.1.3, same
author, MIT) and the routing:
 - sys_fs.c: the path resolvers (ps3game_layout_fallback, the miss hook test, sys_fs_translate_path's fallbacks)
   count a part set as an existing file (fs_host_exists); a read-only sys_fs_open that misses opens the set
   (sys_fs_fd_info.sf instead of fp); read, lseek, fstat (first part's times, the set's size) and close serve it,
   write answers EBADF; sys_fs_stat answers the set's size.
 - ppu_fs.cpp: a read-only cellFsOpen that misses opens the set (g_split[fd]); cellFsRead/Lseek/Fstat/Close,
   cellFsFGetBlockSize and cellFsAioRead (positional) serve it; cellFsStat is registered through cellFsStat_split,
   which answers a set only after the plain stat missed (a hit costs nothing extra).
A single file is opened exactly as before (the set is only looked for after the plain open missed). A set must
start at .66600 and be contiguous: a missing part with a later one present is refused (ENOENT) and the missing
part is named in the log ("[fs] open FAIL ...: split parts: <name>.66601 is missing ..."). Part sizes come from
the files, so any splitter's part size works. The first read across a part edge is logged once per fd, and close
logs how many reads crossed an edge. Not done: opendir/readdir still list the parts by their own names (KZ2 lists
only patch_data_ps3/). Upstream candidate (general: any title from a FAT32 dump).
Verification: tools/runtime/test_split_file.sh (single file, parts of uneven size, reads across every edge,
positional reads, seeks, the gaps named); kz2.exe booted from staged 2- and 7-part copies of the dump into the
first level, including a read across a part edge.

diff --git a/include/ps3emu/split_file.h b/include/ps3emu/split_file.h
new file mode 100644
index 0000000..2272bed
--- /dev/null
+++ b/include/ps3emu/split_file.h
@@ -0,0 +1,211 @@
+/*
+ * ps3recomp - a read-only file stored as FAT32 split parts, read as one file.
+ *
+ * A PS3 disc copied to a FAT32 drive keeps every file over 4 GiB as parts named <name>.66600, <name>.66601, ...
+ * in order (Killzone 2's data_ps3.psarc is 6,998,576,922 bytes: two parts). The guest opens <name>; on the PS3
+ * the parts are joined when the copy is made. ps3_sf_open(path) opens <path> when it is a file, else the parts
+ * <path>.66600, .66601, ... as one file whose size is the sum of theirs. Part sizes are read from the files, never
+ * assumed, so any splitter's part size works. The set must start at .66600 and be contiguous: a missing part with
+ * a later one present ("a gap") is refused and named (why), so a game never reads a short archive. The same rule as
+ * KZ2's first-run check (tools/release/firstrun_check.py split_parts). Names: the suffix is digits, and the host
+ * file system decides case (Windows and Wine match DATA_PS3.PSARC.66600 for data_ps3.psarc.66600).
+ *
+ * Every part stays open while the handle is. Reads are positional per part (seek + read under the part stream's
+ * lock), so several threads may read one handle; ps3_sf_read/ps3_sf_seek also keep a handle position (cellFs
+ * semantics) under the first part's lock. Header only, plain C (C++ compatible). Host test:
+ * tools/runtime/test_split_file.sh (KZ2).
+ *
+ * Adapted from the Killzone 3 PC port's port/vfs/kz3_splitfile.h (Project Helghast v0.1.3, same author, MIT): the part
+ * names and the size walk are KZ3's; the positional reads, the handle lock, the gap check with the missing part
+ * named, the existence probe for the VFS path resolvers and the edge counter are new here (Killzone 2 port, KZ2
+ * patch 6034).
+ */
+#ifndef PS3EMU_SPLIT_FILE_H
+#define PS3EMU_SPLIT_FILE_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/types.h>
+#include <sys/stat.h>
+
+#define PS3_SF_FIRST_PART    66600   /* the FAT32 splitter's first suffix */
+#define PS3_SF_MAX_PARTS     100     /* .66600 ... .66699 */
+#define PS3_SF_GAP_LOOKAHEAD 4       /* with no .66600: .66601-.66604 looked for (a missing first part named) */
+
+#ifdef _WIN32
+#  define PS3_SF_SEEK(f, o)  _fseeki64((f), (__int64)(o), SEEK_SET)
+#  define PS3_SF_LOCK(f)     _lock_file(f)
+#  define PS3_SF_UNLOCK(f)   _unlock_file(f)
+#else
+#  define PS3_SF_SEEK(f, o)  fseeko((f), (off_t)(o), SEEK_SET)
+#  define PS3_SF_LOCK(f)     flockfile(f)
+#  define PS3_SF_UNLOCK(f)   funlockfile(f)
+#endif
+
+typedef struct ps3_sf {
+    int nparts;
+    FILE** f;               /* nparts open streams */
+    uint64_t* start;        /* nparts + 1 offsets; start[nparts] is the size */
+    uint64_t pos;           /* the handle position (ps3_sf_read / ps3_sf_seek) */
+    uint32_t edge_reads;    /* reads that crossed a part edge (diagnostics) */
+    int new_part;           /* the part a read reached for the first time, -1 when it reached none (diagnostics) */
+    uint8_t seen[PS3_SF_MAX_PARTS];   /* parts read at least once (diagnostics) */
+} ps3_sf;
+
+/* 1 and the size when p is a regular file. */
+static inline int ps3_sf_file_size_(const char* p, uint64_t* out)
+{
+#ifdef _WIN32
+    struct _stat64 st;
+    if (_stat64(p, &st) != 0 || !(st.st_mode & _S_IFREG)) return 0;
+#else
+    struct stat st;
+    if (stat(p, &st) != 0 || !S_ISREG(st.st_mode)) return 0;
+#endif
+    if (out) *out = (uint64_t)st.st_size;
+    return 1;
+}
+
+static inline void ps3_sf_part_name(char* out, size_t cap, const char* path, int i)
+{
+    snprintf(out, cap, "%s.%d", path, PS3_SF_FIRST_PART + i);
+}
+
+/* Cheap existence test for path resolvers: is there a first part beside a missing <path>? One stat. */
+static inline int ps3_sf_has_parts(const char* path)
+{
+    char p[1100];
+    if (!path || strlen(path) + 8 >= sizeof p) return 0;
+    ps3_sf_part_name(p, sizeof p, path, 0);
+    return ps3_sf_file_size_(p, NULL);
+}
+
+/* The part set beside <path> (the plain file is not looked at).
+ *   1  a complete set: *nparts parts, *total bytes (sizes[] filled when given, PS3_SF_MAX_PARTS entries)
+ *   0  no parts at all
+ *  -1  a broken set: a part is missing before a later one; why names the missing part */
+static inline int ps3_sf_scan(const char* path, int* nparts, uint64_t* total, uint64_t* sizes, char* why, size_t whycap)
+{
+    char p[1100];
+    uint64_t sz = 0, sum = 0;
+    int n = 0;
+    if (why && whycap) why[0] = 0;
+    if (!path || strlen(path) + 8 >= sizeof p) return 0;
+    for (; n < PS3_SF_MAX_PARTS; n++) {
+        ps3_sf_part_name(p, sizeof p, path, n);
+        if (!ps3_sf_file_size_(p, &sz)) break;
+        if (sizes) sizes[n] = sz;
+        sum += sz;
+    }
+    /* After a set: every later number (as the first-run check, which lists the folder); before any part: a few,
+     * so a plain missing file costs only a handful of stats. */
+    const int last = n ? PS3_SF_MAX_PARTS - 1 : PS3_SF_GAP_LOOKAHEAD;
+    for (int k = n + 1; k <= last && k < PS3_SF_MAX_PARTS; k++) {
+        ps3_sf_part_name(p, sizeof p, path, k);
+        if (!ps3_sf_file_size_(p, NULL)) continue;
+        if (why && whycap) {
+            if (n) snprintf(why, whycap, "%s.%d is missing (found .%d to .%d, and .%d)", path, PS3_SF_FIRST_PART + n,
+                            PS3_SF_FIRST_PART, PS3_SF_FIRST_PART + n - 1, PS3_SF_FIRST_PART + k);
+            else   snprintf(why, whycap, "%s.%d is missing (found .%d)", path, PS3_SF_FIRST_PART, PS3_SF_FIRST_PART + k);
+        }
+        return -1;
+    }
+    if (n == 0) return 0;
+    if (nparts) *nparts = n;
+    if (total) *total = sum;
+    return 1;
+}
+
+static inline void ps3_sf_close(ps3_sf* s)
+{
+    if (!s) return;
+    for (int i = 0; i < s->nparts; i++) if (s->f && s->f[i]) fclose(s->f[i]);
+    free(s->f); free(s->start); free(s);
+}
+
+/* <path> itself when it is a regular file, else its complete part set. NULL when neither (why names a missing
+ * part of a broken set, else stays empty). */
+static inline ps3_sf* ps3_sf_open(const char* path, char* why, size_t whycap)
+{
+    uint64_t sizes[PS3_SF_MAX_PARTS];
+    int n = 0, plain = 0;
+    uint64_t total = 0;
+    char p[1100];
+    if (why && whycap) why[0] = 0;
+    if (!path || strlen(path) + 8 >= sizeof p) return NULL;
+    if (ps3_sf_file_size_(path, &sizes[0])) n = plain = 1;
+    else if (ps3_sf_scan(path, &n, &total, sizes, why, whycap) != 1) return NULL;
+    ps3_sf* s = (ps3_sf*)calloc(1, sizeof *s);
+    if (!s) return NULL;
+    s->f = (FILE**)calloc((size_t)n, sizeof(FILE*));
+    s->start = (uint64_t*)calloc((size_t)n + 1, sizeof(uint64_t));
+    if (!s->f || !s->start) { ps3_sf_close(s); return NULL; }
+    s->nparts = n;
+    s->new_part = -1;
+    for (int i = 0; i < n; i++) {
+        if (plain) snprintf(p, sizeof p, "%s", path);
+        else ps3_sf_part_name(p, sizeof p, path, i);
+        s->f[i] = fopen(p, "rb");
+        if (!s->f[i]) {
+            if (why && whycap) snprintf(why, whycap, "%s cannot be opened", p);
+            ps3_sf_close(s);
+            return NULL;
+        }
+        s->start[i + 1] = s->start[i] + sizes[i];
+    }
+    return s;
+}
+
+static inline uint64_t ps3_sf_size(const ps3_sf* s) { return s->start[s->nparts]; }
+
+/* pread: up to n bytes at off; short only at the end of the set or on an I/O error. Leaves the handle position. */
+static inline size_t ps3_sf_pread(ps3_sf* s, uint64_t off, void* buf, size_t n)
+{
+    uint8_t* o = (uint8_t*)buf;
+    size_t done = 0;
+    int i = 0, touched = 0;
+    s->new_part = -1;
+    while (i < s->nparts && off >= s->start[i + 1]) i++;
+    while (done < n && i < s->nparts) {
+        const uint64_t in_part = off - s->start[i], left = s->start[i + 1] - off;
+        size_t want = n - done, got = 0;
+        if ((uint64_t)want > left) want = (size_t)left;
+        touched++;
+        if (!s->seen[i]) { s->seen[i] = 1; s->new_part = i; }
+        PS3_SF_LOCK(s->f[i]);
+        if (PS3_SF_SEEK(s->f[i], in_part) == 0) got = fread(o + done, 1, want, s->f[i]);
+        PS3_SF_UNLOCK(s->f[i]);
+        done += got; off += got;
+        if (got != want) break;
+        i++;
+    }
+    if (touched > 1) s->edge_reads++;
+    return done;
+}
+
+/* fread(buf, 1, n, f) on the handle position. */
+static inline size_t ps3_sf_read(ps3_sf* s, void* buf, size_t n)
+{
+    PS3_SF_LOCK(s->f[0]);
+    const size_t got = ps3_sf_pread(s, s->pos, buf, n);
+    s->pos += got;
+    PS3_SF_UNLOCK(s->f[0]);
+    return got;
+}
+
+/* lseek: whence SEEK_SET / SEEK_CUR / SEEK_END. Past the end is allowed (the next read returns 0); a negative
+ * result is refused (-1, position unchanged). */
+static inline int ps3_sf_seek(ps3_sf* s, int64_t off, int whence, uint64_t* newpos)
+{
+    PS3_SF_LOCK(s->f[0]);
+    int64_t base = whence == SEEK_END ? (int64_t)ps3_sf_size(s) : whence == SEEK_CUR ? (int64_t)s->pos : 0;
+    const int ok = base + off >= 0;
+    if (ok) s->pos = (uint64_t)(base + off);
+    if (newpos) *newpos = s->pos;
+    PS3_SF_UNLOCK(s->f[0]);
+    return ok ? 0 : -1;
+}
+
+#endif /* PS3EMU_SPLIT_FILE_H */

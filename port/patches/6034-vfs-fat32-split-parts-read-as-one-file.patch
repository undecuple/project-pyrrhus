+/* ---- FAT32 split parts ------------------------------------------------------
+ *
+ * A disc copied to a FAT32 drive keeps each file over 4 GiB as <name>.66600, <name>.66601, ... (Killzone 2's
+ * data_ps3.psarc, 7.0 GB, is two parts). The guest opens <name>; a read-only open that misses opens the part set
+ * as one file (a single file and a part set read the same), and the fd's read, lseek, fstat, AIO read and close
+ * go to it. A set with a missing part is refused, and the missing part is named in the log. */
+static int fd_alloc_split(ps3_sf* s)
+{
+    std::lock_guard<std::mutex> hold(g_fd_lock);
+    for (int i = 3; i < FS_MAX; i++)
+        if (!g_files[i] && !g_dirs[i] && !g_split[i]) { __atomic_store_n(&g_split[i], s, __ATOMIC_RELEASE); return i; }
+    return -1;
+}
+static ps3_sf* fd_split(int fd)
+{
+    return fd >= 0 && fd < FS_MAX ? __atomic_load_n(&g_split[fd], __ATOMIC_ACQUIRE) : nullptr;
+}
+/* cellFsOpen after the host open missed: 1 when the part set answered (opened, or refused with a reason). */
+static int fs_open_split(ppu_context* ctx, const char* gpath, const char* hpath, uint32_t flags, uint32_t fd_ptr)
+{
+    if ((flags & 0x3) != CELL_FS_O_RDONLY || (flags & (CELL_FS_O_CREAT | CELL_FS_O_TRUNC | CELL_FS_O_APPEND))) return 0;
+    char why[1400];
+    int np = 0;
+    uint64_t total = 0;
+    const int r = ps3_sf_scan(hpath, &np, &total, nullptr, why, sizeof why);
+    if (r == 0) return 0;
+    ps3_sf* s = r > 0 ? ps3_sf_open(hpath, why, sizeof why) : nullptr;
+    if (!s) {
+        fprintf(stderr, "[fs] open FAIL '%s': split parts: %s\n", gpath, why[0] ? why : "cannot be opened");
+        ctx->gpr[3] = (uint64_t)(int64_t)CELL_FS_ENOENT;
+        return 1;
+    }
+    const int fd = fd_alloc_split(s);
+    if (fd < 0) { ps3_sf_close(s); ctx->gpr[3] = (uint64_t)(int64_t)CELL_FS_EIO; return 1; }
+    if (fd_ptr) vm_write32(fd_ptr, (uint32_t)fd);
+    strncpy(g_fd_path[fd], gpath, sizeof g_fd_path[fd] - 1); g_fd_path[fd][sizeof g_fd_path[fd] - 1] = 0;
+    fprintf(stderr, "[fs] open '%s' -> fd %d (%d split parts, %llu bytes)\n", gpath, fd, s->nparts,
+            (unsigned long long)ps3_sf_size(s));
+    ctx->gpr[3] = CELL_OK;
+    return 1;
+}
+static void fs_split_close(int fd)
+{
+    ps3_sf* s = nullptr;
+    if (fd >= 0 && fd < FS_MAX) {
+        std::lock_guard<std::mutex> hold(g_fd_lock);
+        s = g_split[fd];
+        if (s) { __atomic_store_n(&g_split[fd], (ps3_sf*)nullptr, __ATOMIC_RELEASE); g_split_edge_logged[fd] = 0; }
+    }
+    if (!s) return;
+    fprintf(stderr, "[fs] close fd=%d (split parts: %u reads across a part edge)\n", fd, s->edge_reads);
+    ps3_sf_close(s);
+}
+

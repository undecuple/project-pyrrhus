+        fprintf(stderr, "[fs] read fd=%d reaches split part %d of %d (offset %llu, %llu bytes -> %zu)\n", fd,
+                np + 1, s->nparts, (unsigned long long)at, (unsigned long long)nbytes, n);
+    if (s->edge_reads && !g_split_edge_logged[fd]) {

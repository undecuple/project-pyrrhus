+/* cellFsRead / cellFsLseek / cellFsFstat on a split-parts fd: 1 when answered. */
+static int fs_split_read(ppu_context* ctx)
+{
+    const int fd = (int)(uint32_t)ctx->gpr[3];
+    ps3_sf* s = fd_split(fd);
+    if (!s) return 0;

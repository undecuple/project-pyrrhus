diff -ruN a/libs/video/rsx_present_recover.h b/libs/video/rsx_present_recover.h
--- a/libs/video/rsx_present_recover.h
+++ b/libs/video/rsx_present_recover.h
@@ -0,0 +1,50 @@
+/* KZ2 patch 6040: what a failed Present does, and the test switch that forces failures. The pure part (host test
+ * tools/runtime/test_present_recover.c); rsx_live_draw.c does the D3D work. From Killzone 3 PC port patch 2130 (same
+ * author, MIT) in idea: a failed Present must not stop the live renderer for good while the device is alive.
+ *
+ * Rule: a failure with the device removed (GetDeviceRemovedReason != S_OK) stops the renderer, as before. Any other
+ * failure is recovered from (leave exclusive fullscreen, resize the swap chain at the next present) and the renderer
+ * keeps drawing; after RSX_PR_MAX_FAILS failures in a row (a Present that never works again) it stops, so a real
+ * fault ends in the null backend instead of a retry loop. A successful Present clears the count.
+ *
+ * KZ2_TEST_PRESENT_FAIL=N[@F]: N forced failures (DXGI_ERROR_INVALID_CALL in place of the Present result), from live-draw
+ * frame F (default 300), in a row. N <= RSX_PR_MAX_FAILS must recover; more must stop the renderer (tests). */
+#ifndef RSX_PRESENT_RECOVER_H
+#define RSX_PRESENT_RECOVER_H
+#include <stdlib.h>
+
+#define RSX_PR_MAX_FAILS 8u
+enum { RSX_PR_CONTINUE = 1, RSX_PR_STOP = 0 };
+
+/* A Present failed: *consecutive counts it. -> RSX_PR_CONTINUE (recover and keep drawing) or RSX_PR_STOP. */
+static inline int rsx_pr_failed(unsigned* consecutive, int device_removed)
+{
+    (*consecutive)++;
+    if (device_removed) return RSX_PR_STOP;
+    return *consecutive <= RSX_PR_MAX_FAILS ? RSX_PR_CONTINUE : RSX_PR_STOP;
+}
+static inline void rsx_pr_ok(unsigned* consecutive) { *consecutive = 0; }
+
+/* KZ2_TEST_PRESENT_FAIL "N" or "N@F" -> 1 and *n, *from; unset, empty or bad -> 0. */
+static inline int rsx_pr_test_parse(const char* e, unsigned* n, unsigned* from)
+{
+    char* end = NULL;
+    *n = 0; *from = 300u;
+    if (!e || !*e) return 0;
+    const unsigned long v = strtoul(e, &end, 10);
+    if (end == e || v == 0 || v > 1000000ul) return 0;
+    *n = (unsigned)v;
+    if (*end == '@') {
+        char* e2 = NULL;
+        const unsigned long f = strtoul(end + 1, &e2, 10);
+        if (e2 == end + 1 || *e2 || f > 100000000ul) { *n = 0; return 0; }
+        *from = (unsigned)f;
+    } else if (*end) { *n = 0; return 0; }
+    return 1;
+}
+/* Is the Present at live-draw frame `frame` one of the forced failures? */
+static inline int rsx_pr_test_hit(unsigned n, unsigned from, unsigned frame)
+{
+    return n && frame >= from && frame - from < n;
+}
+#endif

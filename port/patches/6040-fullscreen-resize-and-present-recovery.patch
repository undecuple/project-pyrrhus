+/* Patch 6040: a Present failed (hr). Recover and keep drawing unless the device is gone or the failures do not stop:
+ * leave exclusive fullscreen (the backend learns it), have the swap chain resized at the next present. -> 1 = keep
+ * drawing, 0 = stop the renderer (the null backend, as before). Forced failures: KZ2_TEST_PRESENT_FAIL (rsx_present_recover.h). */
+static int ld_dm_present_failed(HRESULT hr, const char* where)
+{
+    const HRESULT removed = g.dev ? g.dev->lpVtbl->GetDeviceRemovedReason(g.dev) : S_OK;
+    const int act = rsx_pr_failed(&g_dm_present_fails, FAILED(removed));
+    BOOL fs = FALSE;
+    if (g.swap) g.swap->lpVtbl->GetFullscreenState(g.swap, &fs, NULL);
+    if (act != RSX_PR_CONTINUE) {
+        fprintf(stderr, "[display] %s Present failed hr=0x%08lX (%u in a row, device removed reason 0x%08lX): the live renderer stops\n",
+                where, (unsigned long)hr, g_dm_present_fails, (unsigned long)removed);
+        return 0;
+    }
+    fprintf(stderr, "[display] %s Present failed hr=0x%08lX (%u of %u): %s, swap chain resized at the next present, drawing continues\n",
+            where, (unsigned long)hr, g_dm_present_fails, RSX_PR_MAX_FAILS,
+            fs ? "leaving exclusive fullscreen (borderless from now)" : "not in exclusive fullscreen");
+    if (fs && g.swap) {
+        g.swap->lpVtbl->SetFullscreenState(g.swap, FALSE, NULL);
+        g_dm_fs = 0;
+        rsx_display_exclusive_lost();
+    }
+    InterlockedExchange(&g_dm_force_resize, 1);
+    return 1;
+}
+/* The Present's result, with KZ2_TEST_PRESENT_FAIL applied (read once). */
+static HRESULT ld_dm_present_result(HRESULT hr)
+{
+    static int init;
+    static unsigned n, from;
+    if (!init) {
+        init = 1;
+        const char* e = getenv("KZ2_TEST_PRESENT_FAIL");
+        if (rsx_pr_test_parse(e, &n, &from))
+            fprintf(stderr, "[display] KZ2_TEST_PRESENT_FAIL: %u forced Present failures from frame %u\n", n, from);
+        else if (e && *e) fprintf(stderr, "[display] KZ2_TEST_PRESENT_FAIL=%s not understood (N or N@FRAME)\n", e);
+    }
+    return SUCCEEDED(hr) && rsx_pr_test_hit(n, from, g_ld_frames) ? (HRESULT)DXGI_ERROR_INVALID_CALL : hr;
+}

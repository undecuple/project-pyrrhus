+/* patch 6048: stage `bytes` in the upload ring at *start; when the ring is too full, submit the list first (the
+ * old code skipped the level silently and the texture kept zeros for good: the Corinth sky). 0 = the level alone is
+ * larger than the ring. src = the guest texture being decoded (for the log). */
+static u32 g_ld_up_src_loc, g_ld_up_src_off;
+static unsigned long long g_ld_up_flush_n, g_ld_up_toobig_n;
+static int ld_upload_take(u64 bytes, u32 w, u32 h, u32* start)
+{
+    u64 s = 0;
+    const int k = rsx_upload_place(g.upload_used, bytes, UPLOAD_SIZE, &s);
+    if (k == RSX_UP_FIT) { *start = (u32)s; return 1; }
+    if (k == RSX_UP_FLUSH) {
+        g_ld_up_flush_n++;
+        if (g_ld_up_flush_n <= 32 || (g_ld_up_flush_n & 255u) == 0)
+            fprintf(stderr, "[tex-upload] ring full (%u of %u KB): list submitted before a %ux%u level (%llu bytes) "
+                            "of src=%u:0x%08X frame=%u n=%llu\n", g.upload_used >> 10, UPLOAD_SIZE >> 10, w, h,
+                    (unsigned long long)bytes, g_ld_up_src_loc, g_ld_up_src_off, g_ld_frames, g_ld_up_flush_n);
+        ld_flush(LD_FLUSH_UPLOAD_RING);
+        *start = 0;
+        return 1;
+    }
+    g_ld_up_toobig_n++;
+    fprintf(stderr, "[tex-upload] level %ux%u (%llu bytes) of src=%u:0x%08X is larger than the upload ring (%u KB): "
+                    "not uploaded n=%llu\n", w, h, (unsigned long long)bytes, g_ld_up_src_loc, g_ld_up_src_off,
+            UPLOAD_SIZE >> 10, g_ld_up_toobig_n);
+    return 0;
+}

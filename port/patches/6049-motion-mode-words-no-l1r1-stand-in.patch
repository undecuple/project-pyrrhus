+ * Killzone 2 turns valves and arms demolition charges by tilting the pad. Patch 4015 tilted the motion words from
+ * the right stick while L1+R1 were held on a pad without sensors. That stand-in is gone: the port now gives the stick
+ * to the game's two tilt readers directly (port/kz2/kz2_motion.h, a hook on the game's motion getter), so the words
+ * here only carry the pad's own sensors, or a still pad:
+ *   - mode off: a still DS3 (X 512, Y 399 = 1 g, Z 512, G 512) whatever the pad has, so nothing reads a real tilt;
+ *   - mode auto/on: the pad's accelerometer words when it has one that reads gravity (|a| between 0.5 and 2 g at least
+ *     once since it appeared), else the still values; the gyro word when the pad has a gyro.
+ * A pad that reports a gyro only, or an accelerometer that reads 0 g (a virtual pad from a mapping tool can do both),
+ * no longer counts as a motion pad: before, any sensor turned the stand-in off and a zero accelerometer read as a
+ * +-90 deg roll (the valve hand pegged at one end).
  *
  * Pure: no SDL, no OS call; tools/runtime/test_motion_stick.c tests it on the host.
  */
 #ifndef PS3RECOMP_PAD_MOTION_STICK_H
 #define PS3RECOMP_PAD_MOTION_STICK_H
 
-#include <math.h>
 #include "cellPad.h"
 
 #define PMS_REST_X 512
@@ -31,30 +25,40 @@
 #define PMS_REST_Z 512
 #define PMS_REST_G 512
 #define PMS_WORDS_PER_G 113.0f
-#define PMS_MAX_DEG 36.0f
 
-/* Stick byte (0..255, 128 centre) to [-1, 1], both ends reachable (PAD_SCRIPT's -1 -> 0, +1 -> 255). */
-static inline float pms_stick_unit(u8 v)
+enum { PAD_MOTION_AUTO = 0, PAD_MOTION_ON = 1, PAD_MOTION_OFF = 2 };   /* = KZ2_MOTION_* (port/kz2/kz2_motion.h) */
+
+static inline const char* pad_motion_mode_name(int m) { return m == PAD_MOTION_ON ? "on" : m == PAD_MOTION_OFF ? "off" : "auto"; }
+
+/* Do the accelerometer words read gravity (0.5..2 g)? A still pad reads 1 g; an accelerometer that is not really
+ * there reads 0 g (all three words at 512). */
+static inline int pad_motion_reads_gravity(u16 x, u16 y, u16 z)
+{
+    const float a = ((float)x - 512.0f) / PMS_WORDS_PER_G, b = ((float)y - 512.0f) / PMS_WORDS_PER_G,
+                c = ((float)z - 512.0f) / PMS_WORDS_PER_G;
+    const float g2 = a * a + b * b + c * c;
+    return g2 >= 0.25f && g2 <= 4.0f;
+}
+
+/* Per-port latch: 1 once the pad's accelerometer has read gravity; back to 0 while the pad has no accelerometer.
+ * Returns the latch. */
+static inline int pad_motion_live_note(int* latch, int has_accel, u16 x, u16 y, u16 z)

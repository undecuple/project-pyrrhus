+static unsigned short     s_kb_roles[16];
+static unsigned long long s_kb_roles_until;
+static SRWLOCK            s_kb_roles_lock = SRWLOCK_INIT;
+void pad_kb_set_roles(const unsigned short out[16], unsigned valid_ms)
+{
+    AcquireSRWLockExclusive(&s_kb_roles_lock);
+    memcpy(s_kb_roles, out, sizeof s_kb_roles);
+    s_kb_roles_until = GetTickCount64() + valid_ms;
+    ReleaseSRWLockExclusive(&s_kb_roles_lock);
+}
+/* 1 and the table when it is in force now. */
+static int pad_kb_roles_now(unsigned short out[16])
+{
+    AcquireSRWLockShared(&s_kb_roles_lock);
+    const int on = GetTickCount64() < s_kb_roles_until;
+    if (on) memcpy(out, s_kb_roles, sizeof s_kb_roles);
+    ReleaseSRWLockShared(&s_kb_roles_lock);
+    return on;
+}

diff -ruN a/libs/input/pad_kb_roles.h b/libs/input/pad_kb_roles.h
--- a/libs/input/pad_kb_roles.h	1969-12-31 18:00:00.000000000 -0600
+++ b/libs/input/pad_kb_roles.h	2026-11-02 17:02:35.507139341 -0600
@@ -0,0 +1,56 @@
+/*
+ * pad_kb_roles.h -- keys keep their action under every pad layout (KZ2 port patch 6050; ENHANCEMENT, a fix of the
+ * keyboard defaults).
+ *
+ * keybinds.ini binds keys to pad buttons, and its labels name what each button does in the game's Standard layout
+ * ("l1 = close combat", "r3 = zoom, flashlight": F and the right mouse button by default). The game decides what a
+ * button does from the player profile's button map, which the in-game controller scheme (Standard 1-4, Alternate 1-2)
+ * and the port's Modern layout rewrite. So under Alternate 2 or Modern (zoom on L1, close combat on R3) F zoomed and
+ * the right mouse button meleed: the keys followed buttons, not actions.
+ * Now, while the player is on foot (the title port says so, with a time limit), each key's button is replaced by the
+ * button the live profile gives that key's Standard action (out[i] for the button bit 1 << i; the title port computes
+ * the table from the profile, port/kz2/kz2_pad_layout.c). Menus, vehicles and mounted guns keep the plain buttons
+ * (menu accept/back are buttons, not actions). Pads are never touched (they follow the scheme, as on the PS3), and
+ * keybinds.ini keeps its meaning and every edit in it.
+ *
+ * Pure: no OS call; tools/runtime/test_pad_layout.c tests it on the host.
+ */
+#ifndef PS3RECOMP_PAD_KB_ROLES_H
+#define PS3RECOMP_PAD_KB_ROLES_H
+
+/* buttons: CELL_PAD_CTRL_* bits (DIGITAL1 | DIGITAL2 << 8) of the keys; out[16]: the mask each bit becomes. */
+static inline unsigned pad_kb_roles_apply(const unsigned short out[16], unsigned buttons)
+{
+    unsigned r = 0;
+    for (int i = 0; i < 16; i++) if (buttons & (1u << i)) r |= out[i];
+    return r;
+}
+
+/* Per key, the button chosen when it went down is kept until it comes up, so a key held while the table lapses (the
+ * game skips its on-foot look update for a moment while zooming in) does not turn into its plain button half-way
+ * (the right mouse button held to zoom became R3 = close combat under Modern: kz2-r65-keys-modern). roles = NULL: the
+ * plain buttons for new presses. */
+typedef struct { unsigned short held[16]; unsigned prev; } PadKbRoleLatch;
+static inline unsigned pad_kb_roles_latch(PadKbRoleLatch* l, const unsigned short* roles, unsigned buttons)
+{
+    unsigned r = 0;
+    for (int i = 0; i < 16; i++) {
+        const unsigned bit = 1u << i;
+        if (!(buttons & bit)) continue;
+        if (!(l->prev & bit)) l->held[i] = roles ? roles[i] : (unsigned short)bit;
+        r |= l->held[i];
+    }
+    l->prev = buttons & 0xFFFFu;
+    return r;
+}
+
+/* The key bit whose role lands on button bit `b` (for the keycap prompts: the game's prompt names the button that now
+ * does the action, the keycap shows the key for that action); b itself when no other key's role lands there. */
+static inline unsigned pad_kb_roles_source(const unsigned short out[16], unsigned b)
+{
+    for (int i = 0; i < 16; i++) if ((1u << i) == b && out[i] == b) return b;   /* b's own key still does b's action */
+    for (int i = 0; i < 16; i++) if (out[i] == b) return 1u << i;
+    return b;
+}
+
+#endif /* PS3RECOMP_PAD_KB_ROLES_H */

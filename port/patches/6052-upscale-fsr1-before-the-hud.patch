+/* ---------------------------------------------------------------------------
+ * Patch 6052: the pre-HUD upscale tap (rsx_upscale_pre_hud, KZ3 patch 2145's design for a game whose HUD is its own pass).
+ * Killzone 2's frame (the RE notes rounds 20 and 67b, gated draw captures): lights and colour grading into the
+ * 2560x720 sample buffer, ONE resolve draw into the display buffer, the half-res chain, the next frame's G-buffer, and
+ * then the HUD draws into the display buffer again, before the flip. So the display buffer's second visit of a frame
+ * (a draw into it after draws into another surface) starts the HUD. There, with FSR on and a window larger than the
+ * display buffer, FSR 1 enlarges the display buffer (the scene, resolved and post-processed, no HUD) into an
+ * output-size target, and every later draw or colour clear of that display buffer in the frame goes to that target
+ * with viewport and scissor scaled and an output-size depth target (cleared at the tap; the HUD's own depth/stencil
+ * use is logged): the HUD is drawn at output resolution. The present then copies the target 1:1 (rsx_upscale_tapped:
+ * no second pass). A frame with no second visit (loading, movies) keeps FSR at present; the front end has two.
+ * The display buffer itself keeps the scene without the HUD for the rest of the frame; ASSUMPTION: nothing reads a
+ * display buffer's HUD back (no draw sampled the display buffer in the captures).
+ * LD_UPSCALE_PRE_HUD=0: no tap (FSR at present on the composed image, patch 6051's behaviour).
+ * -----------------------------------------------------------------------*/
+static struct {
+    rsx_pre_hud v;               /* visits, the tap and the surface it redirects (rsx_pre_hud.h) */
+    float sx, sy;                /* output size / display buffer size */
+    ID3D12Resource *rt, *ds, *gm;   /* output-size HUD target (RT|UAV), its depth, its scan-out gamma copy */
+    u32 w, h;
+    ID3D12DescriptorHeap *rtv_heap, *dsv_heap;
+    int failed;
+    u64 taps, draws, clears, zdraws, wpos;
+    u32 report_frame;
+} g_ph = { .v = { .last = ~0u } };
+
+static int ld_ph_enabled(void)
+{
+    static int en = -1;
+    if (en < 0) { const char* e = getenv("LD_UPSCALE_PRE_HUD"); en = e ? atoi(e) != 0 : 1; }
+    return en && g_up_ab_phase != 2;   /* RSX_UPSCALE_AB phase 2: FSR at present */
+}
+
+static int ld_ph_display_index(u32 target)
+{
+    if (target >= g.n_surfaces) return -1;
+    const surface_t* s = &g.surfaces[target];
+    for (int b = 0; b < 8; b++)
+        if (g.display_buffers[b].valid && g.display_buffers[b].location == s->location &&
+            g.display_buffers[b].offset == s->offset && g.display_buffers[b].width == s->w)
+            return b;
+    return -1;
+}
+
+static void ld_ph_release(void)
+{
+    if (g_ph.rt) { retire_texture(g_ph.rt); g_ph.rt = NULL; }
+    if (g_ph.ds) { retire_texture(g_ph.ds); g_ph.ds = NULL; }
+    if (g_ph.gm) { retire_texture(g_ph.gm); g_ph.gm = NULL; }
+    g_ph.w = g_ph.h = 0;
+}
+
+/* The output-size HUD target, its depth and their views; made once per size. */
+static int ld_ph_targets(u32 w, u32 h)
+{
+    if (g_ph.rt && g_ph.w == w && g_ph.h == h) return 1;
+    if (g_ph.failed) return 0;
+    ld_ph_release();
+    if (!g_ph.rtv_heap) {
+        D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+        hd.NumDescriptors = 1;
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+        if (FAILED(g.dev->lpVtbl->CreateDescriptorHeap(g.dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&g_ph.rtv_heap))) {
+            g_ph.rtv_heap = NULL; g_ph.failed = 1; return 0; }
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_DSV;
+        if (FAILED(g.dev->lpVtbl->CreateDescriptorHeap(g.dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&g_ph.dsv_heap))) {
+            g_ph.dsv_heap = NULL; g_ph.failed = 1; return 0; }
+    }
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC rd = {0};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    rd.Width = w; rd.Height = h; rd.DepthOrArraySize = 1; rd.MipLevels = 1; rd.SampleDesc.Count = 1;
+    rd.Format = DXGI_FORMAT_R8G8B8A8_UNORM;   /* the live draw's colour surfaces (its PSOs' RTV format) */
+    rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET | D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    D3D12_CLEAR_VALUE cv = {0}; cv.Format = rd.Format;
+    HRESULT hr = g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+        D3D12_RESOURCE_STATE_RENDER_TARGET, &cv, &IID_ID3D12Resource, (void**)&g_ph.rt);
+    if (SUCCEEDED(hr)) {
+        rd.Format = DXGI_FORMAT_D32_FLOAT_S8X24_UINT;   /* the PSOs' DSV format */
+        rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL;
+        cv.Format = rd.Format; cv.DepthStencil.Depth = 1.0f; cv.DepthStencil.Stencil = 0;
+        hr = g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+            D3D12_RESOURCE_STATE_DEPTH_WRITE, &cv, &IID_ID3D12Resource, (void**)&g_ph.ds);
+    }
+    if (FAILED(hr)) {
+        fprintf(stderr, "[upscale] pre-HUD target %ux%u failed hr=0x%08lX: FSR at present\n", w, h, (unsigned long)hr);
+        if (g_ph.rt) { g_ph.rt->lpVtbl->Release(g_ph.rt); g_ph.rt = NULL; }
+        g_ph.ds = NULL; g_ph.failed = 1;
+        return 0;
+    }
+    D3D12_CPU_DESCRIPTOR_HANDLE h0;
+    g_ph.rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g_ph.rtv_heap, &h0);
+    g.dev->lpVtbl->CreateRenderTargetView(g.dev, g_ph.rt, NULL, h0);
+    g_ph.dsv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g_ph.dsv_heap, &h0);
+    g.dev->lpVtbl->CreateDepthStencilView(g.dev, g_ph.ds, NULL, h0);
+    g_ph.w = w; g_ph.h = h;
+    fprintf(stderr, "[upscale] pre-HUD target %ux%u (HUD drawn at output size)\n", w, h);
+    return 1;
+}
+
+static void ld_ph_tap(u32 target)
+{
+    float sh = RSX_UPSCALE_SHARPNESS_DEFAULT;
+    rsx_upscale* up = ld_up_get(&sh);
+    surface_t* s = &g.surfaces[target];
+    if (!up || !s->tex || s->fmt != DXGI_FORMAT_R8G8B8A8_UNORM || !g_dm_bb_w || !g_dm_bb_h) return;
+    const rsx_dm_rect r = rsx_dm_rect_for((int)s->w, (int)s->h, (int)g_dm_bb_w, (int)g_dm_bb_h, g_dm_scaling, g_dm_filter);
+    if (!rsx_upscale_wants_pass(up, s->w, s->h, (uint32_t)r.w, (uint32_t)r.h)) return;
+    if (!ld_ph_targets((u32)r.w, (u32)r.h)) return;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.pResource = g_ph.rt;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+    rsx_upscale_eval ev;
+    rsx_upscale_result ur;
+    memset(&ev, 0, sizeof ev);
+    ev.cmd_list = g.list;
+    ev.input.resource = s->tex;
+    ev.input.width = s->w; ev.input.height = s->h;
+    ev.input.format = (uint32_t)s->fmt; ev.input.state = (uint32_t)D3D12_RESOURCE_STATE_RENDER_TARGET;
+    ev.output.resource = g_ph.rt;
+    ev.output.width = (uint32_t)r.w; ev.output.height = (uint32_t)r.h;
+    ev.output.format = (uint32_t)DXGI_FORMAT_R8G8B8A8_UNORM;
+    ev.output_width = (uint32_t)r.w; ev.output_height = (uint32_t)r.h;
+    ev.sharpness = sh;
+    ld_gt_other(LD_GT_DRAW);   /* RSX_PERF_GPU=2: the draws before go to "draw", the passes to "upscale" */
+    const int ok = rsx_upscale_pre_hud(up, &ev, &ur);
+    ld_gt_other(LD_GT_UPSCALE);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+    LD_SM_INVALIDATE();   /* compute pipeline, root signature and heaps changed */
+    if (!ok) return;
+    D3D12_CPU_DESCRIPTOR_HANDLE dsv;
+    g_ph.dsv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g_ph.dsv_heap, &dsv);
+    g.list->lpVtbl->ClearDepthStencilView(g.list, dsv, D3D12_CLEAR_FLAG_DEPTH | D3D12_CLEAR_FLAG_STENCIL, 1.0f, 0, 0, NULL);
+    rsx_pre_hud_tapped(&g_ph.v, target);
+    g_ph.sx = (float)r.w / (float)s->w;
+    g_ph.sy = (float)r.h / (float)s->h;
+    if (g_ph.taps++ == 0)
+        fprintf(stderr, "[upscale] pre-HUD tap: display buffer %u:0x%08X %ux%u -> %dx%d before the HUD (frame %u)\n",
+                s->location, s->offset, s->w, s->h, r.w, r.h, g_ld_frames);
+}
+
+static void ld_ph_note_wpos(void)
+{
+    if (g_ph.wpos++ < 4)
+        fprintf(stderr, "[upscale] pre-HUD: a HUD fragment program reads WPOS (frame %u): it sees output-size pixels\n",
+                g_ld_frames);
+}
+
+static void ld_ph_draw(u32 target)
+{
+    if (target != g_ph.v.last &&
+        rsx_pre_hud_draw(&g_ph.v, target, g_up && ld_ph_enabled() ? ld_ph_display_index(target) : -1))
+        ld_ph_tap(target);
+    g_ph_cur = rsx_pre_hud_redirects(&g_ph.v, target);
+}
+
+static int ld_ph_redirect(u32 target, u32 n_mrt, D3D12_CPU_DESCRIPTOR_HANDLE* rtv, D3D12_CPU_DESCRIPTOR_HANDLE* dsv,
+                          int* have_dsv, float* sx, float* sy)
+{
+    if (!rsx_pre_hud_redirects(&g_ph.v, target) || n_mrt != 1 || !g_ph.rt) return 0;
+    g_ph.rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g_ph.rtv_heap, rtv);
+    g_ph.dsv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g_ph.dsv_heap, dsv);
+    *have_dsv = 1;
+    *sx = g_ph.sx; *sy = g_ph.sy;
+    g_ph.draws++;
+    const int zuse = (rsx_dsp_reg(&g.rsx, 0x0A74) & 1u) || (rsx_dsp_reg(&g.rsx, M_STENCIL_TEST_ENABLE) & 1u);
+    if (zuse && g_ph.zdraws++ == 0)
+        fprintf(stderr, "[upscale] pre-HUD: a HUD draw tests depth/stencil (frame %u; against the HUD's own cleared depth)\n",
+                g_ld_frames);
+    return 1;
+}
+
+static int ld_ph_clear(u32 target, D3D12_CPU_DESCRIPTOR_HANDLE* rtv, D3D12_RECT* crect, UINT n_crect, u32 mask)
+{
+    (void)mask;
+    if (!rsx_pre_hud_redirects(&g_ph.v, target) || !g_ph.rt) return 0;
+    g_ph.rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g_ph.rtv_heap, rtv);
+    if (n_crect) {
+        crect->left = (LONG)((float)crect->left * g_ph.sx + 0.5f); crect->right = (LONG)((float)crect->right * g_ph.sx + 0.5f);
+        crect->top = (LONG)((float)crect->top * g_ph.sy + 0.5f); crect->bottom = (LONG)((float)crect->bottom * g_ph.sy + 0.5f);
+    }
+    g_ph.clears++;
+    return 1;
+}
+
+/* At the present: the image to show for the flipped surface (the HUD target when this frame was tapped for it), its
+ * state, and the frame's end. A tap for another surface than the one presented is dropped (FSR at present). */
+static ID3D12Resource* ld_ph_present_src(u32 target, D3D12_RESOURCE_STATES* state)

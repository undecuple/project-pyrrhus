diff -ruN a/libs/video/rsx_pre_hud.h b/libs/video/rsx_pre_hud.h
--- a/libs/video/rsx_pre_hud.h	1969-12-31 18:00:00.000000000 -0600
+++ b/libs/video/rsx_pre_hud.h	2026-11-02 22:09:44.873880507 -0600
@@ -0,0 +1,43 @@
+/* rsx_pre_hud.h -- where a frame's HUD starts, for the pre-HUD upscale tap (KZ2 patch 6052). Pure; host test
+ * tools/runtime/test_pre_hud.sh.
+ * Killzone 2 draws into its display buffer twice a frame: one resolve draw of the finished scene, then (after the
+ * half-res chain and the next frame's G-buffer) the HUD. A visit is a run of draws into one surface; the second visit
+ * of a display buffer in a frame is the HUD's start. Clears do not count (the caller passes draws only). */
+#ifndef RSX_PRE_HUD_H
+#define RSX_PRE_HUD_H
+
+#include <string.h>
+
+#define RSX_PRE_HUD_BUFFERS 8u   /* display buffers (cellGcmSetDisplayBuffer ids) */
+#define RSX_PRE_HUD_VISIT 2u     /* the visit that starts the HUD */
+
+typedef struct {
+    unsigned char visits[RSX_PRE_HUD_BUFFERS];   /* per display buffer: visits this frame (saturating) */
+    unsigned last;                               /* the previous draw's target; ~0u = none yet */
+    int tapped;                                  /* the caller ran the tap this frame */
+    unsigned target;                             /* the surface it redirects */
+} rsx_pre_hud;
+
+static inline void rsx_pre_hud_reset(rsx_pre_hud* p)   /* at each present */
+{
+    memset(p, 0, sizeof *p);
+    p->last = ~0u;
+}
+
+/* A draw into surface `target`, which is display buffer `buffer` (-1 = not a display buffer). -> 1 when the tap is to
+ * run before this draw (the caller then calls rsx_pre_hud_tapped when it did). */
+static inline int rsx_pre_hud_draw(rsx_pre_hud* p, unsigned target, int buffer)
+{
+    if (target == p->last) return 0;
+    p->last = target;
+    if (p->tapped || buffer < 0 || (unsigned)buffer >= RSX_PRE_HUD_BUFFERS) return 0;
+    if (p->visits[buffer] < 255u) p->visits[buffer]++;
+    return p->visits[buffer] == RSX_PRE_HUD_VISIT;
+}
+
+static inline void rsx_pre_hud_tapped(rsx_pre_hud* p, unsigned target) { p->tapped = 1; p->target = target; }
+
+/* 1 while draws into `target` go to the output-size target (after the tap, until the present). */
+static inline int rsx_pre_hud_redirects(const rsx_pre_hud* p, unsigned target) { return p->tapped && target == p->target; }
+
+#endif /* RSX_PRE_HUD_H */

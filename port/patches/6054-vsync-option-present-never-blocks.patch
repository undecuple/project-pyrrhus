+/* KZ2 patch 6054 (from KZ3 patch 2103, Killzone 3 port "Project Helghast", same author, MIT): VSync. The swap chain is
+ * created with DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING whenever the factory reports DXGI_FEATURE_PRESENT_ALLOW_TEARING
+ * (harmless with vsync on); ResizeBuffers repeats the flags. Off = Present(0, ALLOW_TEARING) in a window or borderless,
+ * Present(0, 0) in exclusive fullscreen; on = Present(1, 0), the old call. Set from the Display page's VSYNC row
+ * (port/kz2/kz2_port_settings.cpp) on the menu bridge thread; read by the present thread (an int, no lock needed). */
+static volatile int g_ld_vsync = 1;
+static int g_ld_tearing_ok;                   /* swap chain has the flag */
+static int g_ld_vsync_logged = -1;
+void rsx_live_draw_set_vsync(int on) { g_ld_vsync = on ? 1 : 0; }
+/* KZ2 patch 6054, second half (from KZ3 patch 2127, same project and licence): a Present never holds the frame thread. That thread
+ * also ticks the guest's vblanks and drains the FIFO (port/kz2/main.cpp frame_clock, the walker), so a blocking Present
+ * stops the guest's clock of frames: KZ3 saw a window the compositor does not show (another screen focused, minimised)
+ * block each Present for ~1 s, and on a real display a full flip queue holds the walker for up to a vblank per frame.
+ * The swap chain has a frame-latency waitable object (maximum latency 2); a Present whose slot is not free within
+ * LD_PRESENT_WAIT_MS (default 16 = one vblank) is skipped (that guest frame is not shown; the guest, its vblanks and
+ * its audio run on). LD_PRESENT_WAIT_MS=-1 = the old blocking Present. "[present] skipped" lines count the skips. */
+static HANDLE g_ld_latency_ev;
+static int ld_present_wait_ms(void)
+{
+    static int ms = -2;
+    if (ms == -2) {
+        const char* e = getenv("LD_PRESENT_WAIT_MS");
+        ms = e && *e ? atoi(e) : 16;
+        if (ms < -1) ms = -1;
+        fprintf(stderr, "[present] %s (LD_PRESENT_WAIT_MS=%d, patch 6054)\n",
+                ms < 0 ? "blocking Present (old path)" : "frame-latency wait, a Present never blocks longer", ms);
+    }
+    return ms;
+}
+static UINT ld_swap_flags(void)
+{
+    return (g_ld_tearing_ok ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0) |
+           (ld_present_wait_ms() >= 0 ? DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT : 0);
+}
+/* 1 = present now; 0 = skip this one (no free slot within the wait). */
+static int ld_present_slot(void)
+{
+    static unsigned s_skip, s_skip_win, s_lines;
+    static ULONGLONG s_t0;
+    const int ms = ld_present_wait_ms();
+    if (ms < 0 || !g_ld_latency_ev) return 1;
+    if (WaitForSingleObject(g_ld_latency_ev, (DWORD)ms) == WAIT_OBJECT_0) {
+        if (s_skip_win) {
+            fprintf(stderr, "[present] presenting again after %u skipped (no free swap-chain slot; %u in all)\n", s_skip_win, s_skip);
+            s_skip_win = 0;
+        }
+        return 1;
+    }
+    s_skip++; s_skip_win++;
+    if (s_lines < 20 || GetTickCount64() - s_t0 > 10000) {
+        s_lines++; s_t0 = GetTickCount64();
+        fprintf(stderr, "[present] skipped: no free swap-chain slot within %d ms (%u in a row, %u in all)\n", ms, s_skip_win, s_skip);
+    }
+    return 0;
+}
+/* Present with the interval and flags the setting asks for (patch 6054); logs "[rsx] vsync ..." once and on each
+ * change. LD_PRESENT_INTERVAL (patch 2007, diagnostic) wins over the setting. A skipped Present (patch 6054) is S_OK. */
+static HRESULT ld_present_swap(void)
+{
+    static int s_env = -2;
+    unsigned tearing = 0, interval;
+    if (s_env == -2) {
+        const char* e = getenv("LD_PRESENT_INTERVAL");
+        s_env = (e && *e >= '0' && *e <= '4') ? *e - '0' : -1;
+    }
+    const int vs = g_ld_vsync;
+    interval = rsx_dm_present_args(vs, g_ld_tearing_ok, g_dm_fs, s_env, &tearing);
+    if (g_ld_vsync_logged != (vs | (int)(tearing << 1) | (s_env >= 0 ? 4 : 0))) {
+        g_ld_vsync_logged = vs | (int)(tearing << 1) | (s_env >= 0 ? 4 : 0);
+        fprintf(stderr, "[rsx] vsync %s (%s%s)\n", rsx_dm_vsync_name(vs),
+                g_ld_tearing_ok ? "tearing allowed" : "tearing not supported",
+                s_env >= 0 ? ", LD_PRESENT_INTERVAL set: interval from the environment" :
+                g_dm_fs && !vs ? ", exclusive fullscreen: interval 0 without the flag" : "");
+    }
+    if (!ld_present_slot()) return S_OK;   /* patch 6054 */
+    return g.swap->lpVtbl->Present(g.swap, interval, tearing ? DXGI_PRESENT_ALLOW_TEARING : 0);
+}

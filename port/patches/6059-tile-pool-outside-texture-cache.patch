+/* KZ2 patch 6059: the small main-memory ARGB8 tiles get their own pool, outside the hashed texture cache.
+ *
+ * Killzone 2 writes per-object 8x8 A8R8G8B8 linear tiles (256 bytes each) into a ring in main memory (io offsets
+ * 0x63680..0x11D3180 in Corinth Sands) and binds ~400-500 of them in a heavy frame; the same addresses are rewritten
+ * with new bytes between binds (99.6 % of the cache's new entries, 70 % of them re-adds). In the
+ * texture cache each such bind paid a key lookup, a content hash, a decode, an upload copy with two barriers in the
+ * middle of the draw list, an SRV write and the eviction of a real texture.
+ *
+ * This pool keys a tile by its address only and compares its 256 bytes exactly (no hash): an unchanged tile is a
+ * hit (no copy); a changed one is copied again. Slots are reused in ring order. Copies are recorded at the end of a
+ * chunk (the caller's batch, executed before the chunk's draws), so a slot that a draw of the current chunk reads is
+ * never overwritten in that chunk: a changed tile already used in this chunk gets a new slot (the next one in ring
+ * order that this chunk does not read), and when every slot is read by this chunk the pick says FULL (the caller
+ * submits the chunk and asks again).
+ *
+ * Pure C, no allocation, no locking (the walker thread owns it). Host test: tools/runtime/test_tile_pool.sh. */
+#ifndef RSX_TILE_POOL_H
+#define RSX_TILE_POOL_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define RSX_TILE_BYTES 256u
+
+typedef struct {
+    uint32_t offset;     /* the tile's io offset (main memory) */
+    uint32_t remap;      /* the remap its descriptor was made for (srv_ok) */
+    uint32_t chunk;      /* the last chunk a draw used it in */
+    uint8_t  used;       /* holds a tile */
+    uint8_t  mapped;     /* the map points at it (the newest copy of its address) */
+    uint8_t  srv_ok;     /* the caller made a descriptor for this slot with `remap` */
+    uint8_t  pad_;
+    uint8_t  bytes[RSX_TILE_BYTES];
+} rsx_tile_slot;
+
+typedef struct {
+    rsx_tile_slot* s;    /* n slots */
+    uint32_t n;
+    uint32_t cur;        /* ring cursor: the next slot to fill */
+    uint32_t chunk;      /* the current chunk (starts at 1; rsx_tile_next_chunk at every submit) */
+    uint32_t* map;       /* open addressing, linear probe: slot + 1, 0 = empty; mask + 1 entries, >= 2 n */
+    uint32_t mask;
+} rsx_tile_pool;
+
+enum { RSX_TILE_HIT = 0, RSX_TILE_COPY = 1, RSX_TILE_FULL = 2 };
+
+static inline uint32_t rsx_tile_home(const rsx_tile_pool* p, uint32_t offset)
+{
+    return ((offset >> 8) * 0x9E3779B1u >> 7) & p->mask;
+}
+
+static inline void rsx_tile_init(rsx_tile_pool* p, rsx_tile_slot* s, uint32_t n, uint32_t* map, uint32_t map_entries)
+{
+    memset(s, 0, (size_t)n * sizeof *s);
+    memset(map, 0, (size_t)map_entries * sizeof *map);
+    p->s = s; p->n = n; p->cur = 0; p->chunk = 1; p->map = map; p->mask = map_entries - 1u;
+}
+
+static inline uint32_t rsx_tile_find(const rsx_tile_pool* p, uint32_t offset)   /* map index, or UINT32_MAX */
+{
+    for (uint32_t i = rsx_tile_home(p, offset);; i = (i + 1u) & p->mask) {
+        const uint32_t v = p->map[i];
+        if (!v) return UINT32_MAX;
+        if (p->s[v - 1u].offset == offset) return i;
+    }
+}
+
+static inline void rsx_tile_map_remove(rsx_tile_pool* p, uint32_t i)   /* backward-shift deletion */
+{
+    p->s[p->map[i] - 1u].mapped = 0;
+    for (uint32_t j = i;;) {
+        j = (j + 1u) & p->mask;
+        const uint32_t v = p->map[j];
+        if (!v) break;
+        const uint32_t k = rsx_tile_home(p, p->s[v - 1u].offset);
+        /* the entry at j may move to i when its home is not in (i, j] (cyclically) */
+        const int stays = i <= j ? (i < k && k <= j) : (i < k || k <= j);
+        if (!stays) { p->map[i] = v; i = j; }
+    }
+    p->map[i] = 0;
+}
+
+static inline void rsx_tile_map_insert(rsx_tile_pool* p, uint32_t slot)
+{
+    uint32_t i = rsx_tile_home(p, p->s[slot].offset);
+    while (p->map[i]) i = (i + 1u) & p->mask;
+    p->map[i] = slot + 1u;
+    p->s[slot].mapped = 1;
+}
+
+/* Which slot a bind of the tile at `offset` (its current 256 bytes, remap) reads. HIT: the slot holds these bytes
+ * already. COPY: the slot now holds them (bytes copied into the slot); the caller uploads them in this chunk's batch.
+ * With either, *srv = 1 asks the caller for the slot's descriptor with `remap` (then it sets srv_ok). FULL: the
+ * slot is read by this chunk: submit the chunk (rsx_tile_next_chunk) and call again. */
+static inline int rsx_tile_pick(rsx_tile_pool* p, uint32_t offset, uint32_t remap, const uint8_t* bytes,
+                                uint32_t* slot, int* srv)
+{
+    *srv = 0;
+    const uint32_t mi = rsx_tile_find(p, offset);
+    if (mi != UINT32_MAX) {
+        const uint32_t k = p->map[mi] - 1u;
+        rsx_tile_slot* e = &p->s[k];
+        if (memcmp(e->bytes, bytes, RSX_TILE_BYTES) == 0) {
+            /* Same texels. Another remap needs only a new descriptor: a draw copies its descriptors into the
+             * shader-visible ring when it is recorded, so earlier draws keep the old one. */
+            *slot = k;
+            if (!e->srv_ok || e->remap != remap) { e->remap = remap; *srv = 1; }
+            e->chunk = p->chunk;
+            return RSX_TILE_HIT;
+        }
+        if (e->chunk != p->chunk) {   /* no draw of this chunk reads it: refresh it in place */
+            memcpy(e->bytes, bytes, RSX_TILE_BYTES);
+            if (!e->srv_ok || e->remap != remap) *srv = 1;
+            e->remap = remap; e->chunk = p->chunk;
+            *slot = k;
+            return RSX_TILE_COPY;
+        }
+        /* read by a draw of this chunk and changed since: the new bytes need another slot */
+    }
+    uint32_t v = p->cur, tries = 0;   /* the next slot in ring order that no draw of this chunk reads */
+    while (p->s[v].used && p->s[v].chunk == p->chunk) {
+        if (++tries == p->n) return RSX_TILE_FULL;
+        v = (v + 1u) % p->n;
+    }
+    rsx_tile_slot* e = &p->s[v];
+    if (mi != UINT32_MAX) rsx_tile_map_remove(p, mi);   /* the old copy stays for this chunk's earlier draws */
+    if (e->mapped) rsx_tile_map_remove(p, rsx_tile_find(p, e->offset));
+    if (!e->srv_ok || e->remap != remap) *srv = 1;
+    e->offset = offset; e->remap = remap; e->chunk = p->chunk; e->used = 1;
+    memcpy(e->bytes, bytes, RSX_TILE_BYTES);
+    rsx_tile_map_insert(p, v);
+    p->cur = (v + 1u) % p->n;
+    *slot = v;
+    return RSX_TILE_COPY;
+}
+
+static inline void rsx_tile_next_chunk(rsx_tile_pool* p)
+{
+    if (++p->chunk == 0) {   /* wrapped (2^32 submits): no slot may look current */
+        for (uint32_t i = 0; i < p->n; i++) p->s[i].chunk = 0;
+        p->chunk = 1;
+    }
+}
+
+#endif /* RSX_TILE_POOL_H */

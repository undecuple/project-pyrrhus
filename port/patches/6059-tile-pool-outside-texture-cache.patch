+        g.queue->lpVtbl->ExecuteCommandLists(g.queue, 1, cl);
+        g_ld_tile_alloc_fence[i] = g.fence_value + 1u;   /* the caller signals ++g.fence_value after the draw list */
+    }
+    rsx_tile_next_chunk(&g_ld_tile);

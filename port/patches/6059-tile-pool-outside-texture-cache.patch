+        g_ld_tile_st.fulls++;   /* every slot is read by this chunk: submit it (the copies go with it) */
+        ld_flush(LD_FLUSH_UPLOAD_RING);
+        if (!g.ready) return UINT32_MAX;
+    }
+    g_ld_tile_st.binds++;
+    rsx_tile_slot* e = &g_ld_tile.s[slot];
+    if (!g_ld_tile_tex[slot]) {
+        D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC rd = {0};
+        rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D; rd.Width = 8; rd.Height = 8; rd.DepthOrArraySize = 1;
+        rd.MipLevels = 1; rd.Format = DXGI_FORMAT_R8G8B8A8_UNORM; rd.SampleDesc.Count = 1;
+        if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+                                                          D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, NULL,
+                                                          &IID_ID3D12Resource, (void**)&g_ld_tile_tex[slot]))) {
+            g_ld_tile_tex[slot] = NULL;
+            e->used = 0; e->chunk = 0;
+            if (e->mapped) rsx_tile_map_remove(&g_ld_tile, rsx_tile_find(&g_ld_tile, e->offset));
+            g_ld_tile_st.fails++;
+            return UINT32_MAX;
+        }
+        e->srv_ok = 0; srv = 1;
+        r = RSX_TILE_COPY;   /* a new resource has no texels yet */
+    }
+    if (srv) {
+        D3D12_SHADER_RESOURCE_VIEW_DESC desc = {0};
+        desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        desc.Shader4ComponentMapping = ld_argb_raw_mapping(remap);   /* patch 2046's mapping */
+        desc.Texture2D.MipLevels = 1;
+        ld_create_srv(g.dev, g_ld_tile_tex[slot], &desc, srv_cpu(SRV_TILE_BASE + slot));
+        e->srv_ok = 1;
+        g_ld_tile_st.srvs++;
+    }
+    if (r == RSX_TILE_COPY) {
+        u32 start;
+        if (!ld_upload_take((u64)LD_TILE_ROW_PITCH * 8u, 8u, 8u, &start)) {   /* cannot happen for 2 KB; be safe */
+            e->used = 0; e->chunk = 0;

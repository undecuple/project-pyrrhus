+static ID3D12Resource** g_ld_tile_tex;
+static struct ld_tile_pend { u32 slot, start; }* g_ld_tile_pend;
+static u32 g_ld_tile_npend;
+static int g_ld_tile_state = -1;   /* -1 not decided, 0 off, 1 on */
+static struct { unsigned long long binds, hits, copies, fulls, srvs, fails, recorded, batches; long long ns; } g_ld_tile_st;
+static double ld_tile_qpc_ms(long long ticks)   /* g_ld_tile_st.ns holds QPC ticks (rsx_perf_now) */
+{
+    LARGE_INTEGER f; QueryPerformanceFrequency(&f);
+    return f.QuadPart ? (double)ticks * 1000.0 / (double)f.QuadPart : 0.0;

+/* KZ2 patch 6059: a bind of an 8x8 pitch-linear A8R8G8B8 texture in main memory goes to the tile pool (see
+ * ld_tile_on). Returns the SRV slot, or UINT32_MAX to take the texture cache's path (not such a tile, pool off,
+ * memory not readable, a resource that could not be made). */
+static int ld_tile_shape(const rsx_dsp_texture* t)
+{
+    const u32 base_fmt = t->format & TEX_FMT_BASE_MASK & ~(u32)TEX_FMT_UNNORM;
+    return t->location == 1u && base_fmt == TEX_FMT_A8R8G8B8 && (t->format & TEX_FMT_LINEAR) && t->width == 8u &&
+           t->height == 8u && !t->cubemap && t->dimension == 2u && (t->pitch == 0u || t->pitch == 32u);
+}
+static u32 ld_tile_bind(const rsx_dsp_texture* t, u32 remap)
+{
+    const u8* src = guest_ptr(1u, t->offset, RSX_TILE_BYTES);
+    if (!src) return UINT32_MAX;
+    const long long t0 = rsx_perf_enabled() ? rsx_perf_now() : 0;
+    u32 slot = 0; int srv = 0, r;

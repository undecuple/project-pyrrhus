+/* Every submit, just before the draw list's ExecuteCommandLists: the chunk's tile copies go first (the queue runs
+ * them before the draws; the submit's fence signal comes after both). The next binds belong to the next chunk. */
+static void ld_tile_submit(void)
+{
+    if (g_ld_tile_state != 1) return;
+    if (g_ld_tile_npend) {
+        const u32 i = g_ld_tile_alloc_i;
+        g_ld_tile_alloc_i = (i + 1u) % LD_TILE_ALLOCS;
+        if (!ld_wait_fence(g_ld_tile_alloc_fence[i])) return;
+        g_ld_tile_alloc[i]->lpVtbl->Reset(g_ld_tile_alloc[i]);
+        g_ld_tile_list->lpVtbl->Reset(g_ld_tile_list, g_ld_tile_alloc[i], NULL);
+        ld_tile_record(g_ld_tile_list);
+        if (FAILED(g_ld_tile_list->lpVtbl->Close(g_ld_tile_list))) {
+            fprintf(stderr, "[d3d-fail] tile copy list Close frame=%u\n", g_ld_frames);
+            g.ready = 0;

+static ID3D12GraphicsCommandList* g_ld_tile_list;
+static ID3D12CommandAllocator* g_ld_tile_alloc[LD_TILE_ALLOCS];
+static u64 g_ld_tile_alloc_fence[LD_TILE_ALLOCS];
+static u32 g_ld_tile_alloc_i;
+#define LD_TILE_SLOTS_DEFAULT 4096u
+#define LD_TILE_ROW_PITCH     256u   /* D3D12_TEXTURE_DATA_PITCH_ALIGNMENT: 8 rows of 32 bytes staged at 256 */

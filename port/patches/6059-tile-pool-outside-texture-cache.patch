+static void ld_tile_barriers(ID3D12GraphicsCommandList* cl, D3D12_RESOURCE_STATES from, D3D12_RESOURCE_STATES to)
+{
+    enum { B = 256 };
+    D3D12_RESOURCE_BARRIER b[B];
+    for (u32 i0 = 0; i0 < g_ld_tile_npend; i0 += B) {
+        const u32 m = g_ld_tile_npend - i0 < B ? g_ld_tile_npend - i0 : B;
+        for (u32 i = 0; i < m; i++) {
+            memset(&b[i], 0, sizeof b[i]);
+            b[i].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+            b[i].Transition.pResource = g_ld_tile_tex[g_ld_tile_pend[i0 + i].slot];
+            b[i].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+            b[i].Transition.StateBefore = from; b[i].Transition.StateAfter = to;
+        }
+        cl->lpVtbl->ResourceBarrier(cl, m, b);
+    }

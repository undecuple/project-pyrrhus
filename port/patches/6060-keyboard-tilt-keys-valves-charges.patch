+/* KZ2 patch 6060 (ENHANCEMENT): the tilt keys. A valve or a demolition charge wants the grab (L1 + R1, the game's
+ * GrabLeftHand/GrabRightHand, which no pad layout moves) held while the pad tilts; without a motion sensor the right
+ * stick X is the tilt (patch 6049). With a keyboard that took four keys at once (the grab's two plus a right-stick
+ * key, which then depended on the layout). A held tilt key now gives both: the grab and the stick at full tilt to its
+ * side, and only while the game's valve or charge controller reads the tilt (`active`; the motion hook notes it),
+ * so the keys never fire or melee anywhere else. Both held: the one pressed last wins (roll from one key to the
+ * other without letting go of the grab, as a charge's two arm windows want). Returns 1 and sets *rx and *buttons
+ * (CELL_PAD_CTRL_L1 | R1 as packed in PadHostState.buttons) when it applies. */
+typedef struct { unsigned short prev; unsigned char side; } PadKbTilt;   /* side: 0 none, 1 left, 2 right */
+static inline int pad_kb_tilt(PadKbTilt* t, unsigned short dirs, int active, unsigned char* rx, unsigned short* buttons)
+{
+    const unsigned short L = (unsigned short)(1u << PKB_TILT_LEFT), R = (unsigned short)(1u << PKB_TILT_RIGHT);
+    const unsigned short now = (unsigned short)(dirs & (L | R)), went = (unsigned short)(now & ~t->prev);
+    t->prev = now;
+    if (went == L) t->side = 1;
+    else if (went == R) t->side = 2;
+    else if (now == L) t->side = 1;
+    else if (now == R) t->side = 2;
+    else if (!now) t->side = 0;
+    if (!active || !now || !t->side) return 0;
+    *rx = t->side == 1 ? 0 : 255;
+    *buttons = PKB_L1 | PKB_R1;
+    return 1;
+}
+

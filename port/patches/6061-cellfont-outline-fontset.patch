diff -ruN a/libs/font/cellFontOutline.c b/libs/font/cellFontOutline.c
--- /dev/null
+++ b/libs/font/cellFontOutline.c
@@ -0,0 +1,524 @@
+/*
+ * KZ2 patch 6061 - cellFont outline API on a bundled font (system fontsets).
+ *
+ * Adapted from Project Helghast patch 5005 (libs/font/cellFontOutline.c; MIT, same author): the font chain per fontset
+ * handle, the cmap lookup per code point, the outline conversion (stb_truetype shapes, cubics split into quadratics),
+ * the size-class glyph pool and the f1/f2 context handler for cellFontSetScalePixel. Changed for Killzone 2: the font
+ * source is the bundled Noto Sans only (no firmware fonts, no CJK order); the pool lives in the file cache the title
+ * gives cellFontInit (no allocation window); a code no font has, and code 0, return CELL_FONT_ERROR_NO_SUPPORT_CODE
+ * instead of an empty glyph; an unopened font returns CELL_FONT_ERROR_INVALID_PARAMETER; Windows paths are wide.
+ *
+ * Killzone 2 (1.29) opens one system font, cellFontOpenFontset type 0x109, for the characters its three embedded
+ * fonts lack (Cyrillic and Greek; issue #39), never renders through the library, and reads glyph OUTLINES
+ * (the RE notes "An earlier change"): cellFontSetScalePixel(font, 2048, 2048) @0x00044598, then
+ * cellFontGetCharGlyphMetrics(font, 'M') @0x000445A8 once (h_bearingY at +0xC normalises the face to the 'M' height),
+ * then per character cellFontGenerateCharGlyph @0x0004467C, the game's converter @0x000438D0, cellFontDeleteGlyph
+ * @0x000446AC. Without these functions the imports took the unresolved-NID path (CELL_OK, out-parameters untouched).
+ *
+ * Font files, tried per code point in this order (the first whose cmap has the character wins), from $KZ2_FONT_DIR,
+ * else <exe dir>/fonts, else ./fonts. Nothing is extracted or decrypted here.
+ *   1. NotoSans-Regular.ttf (SIL OFL 1.1, Latin + Greek + Cyrillic; tools/runtime/mkfont_noto.py makes it from
+ *      nixpkgs' noto-fonts).
+ *   2. An earlier change (D53): NotoSansCJK-Regular.ttc (SIL OFL 1.1; tools/runtime/mkfont_cjk.py: Noto Sans CJK cut to the
+ *      characters of the game's own text, TrueType outlines), a collection of five faces with one glyph set: 0 JP,
+ *      1 KR, 2 SC, 3 TC, 4 HK. Han characters are drawn differently per language, so the face is picked per lookup by
+ *      kz2_cjk_face_index() (weak; port/kz2: the game's current page language), 0 when nothing defines it. The PS3's
+ *      fontset 0x109 (Rodin, New Rodin, YG, DFHEI5) draws every Han character from its Japanese face first.
+ *
+ * Guest layout (the game's reads in 0x438D0; big-endian; matches RPCS3's CellFontGlyph, read, not copied):
+ *   CellFontGlyph (0x40 bytes): +0x08 CellFontGlyphMetrics (8 floats: width, height, h_bearing_x, h_bearing_y,
+ *   h_advance, v_bearing_x, v_bearing_y, v_advance; the game reads only h_advance at +0x18); +0x28 s16 contour count;
+ *   +0x2A s16 point count; +0x2C -> float x,y pairs (y up, baseline 0); +0x30 -> u8 tags (0 = off-curve, 1 = on-curve);
+ *   +0x34 -> u16 index of the last point of each contour. Bytes 0..7 and 0x38..0x3F are zero.
+ * Coordinates are pixels at the font's current scale (units * scale / unitsPerEm).
+ */
+#include "cellFont.h"
+#include "../../runtime/ppu/ppu_memory.h"
+#include "../../runtime/ppu/ppu_context.h"
+#include "../../include/ps3emu/nid.h"
+#include "stb_truetype.h"   /* declarations only; the implementation is compiled in cellFont.c */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#ifdef _WIN32
+#  include <windows.h>
+#else
+#  include <unistd.h>
+#endif
+
+/* The firmware's code (RPCS3 cellFont.h, read, not copied); cellFont.h's error table is not the firmware's. */
+#define KZ2_FONT_ERROR_NO_SUPPORT_CODE 0x80540011u
+
+/* Defined in cellFont.c. */
+s32 kz2_font_set_scale_pixel(u32 font_ea, float w, float h);
+int kz2_font_slot_stb(u32 handle, stbtt_fontinfo* out);
+int kz2_font_handle(u32 font_ea);
+u32 kz2_font_file_cache(u32* size);
+
+/* ---- guest pool ---------------------------------------------------------------------------------------------- */
+/* Glyph records come from the title's file cache (CellFontConfig.FileCache, KZ2: 0x40000 bytes of its BSS at
+ * 0x011B0EB8, set up @0x00044404): guest memory the library owns until cellFontEnd, so nothing else can be handed the
+ * same pages. Power-of-two size classes from 128 bytes with free lists; Killzone 2 deletes each glyph right after
+ * converting it, so one record is live at a time. */
+#define POOL_MIN_BIN 7                 /* 128 bytes */
+#define POOL_BINS 24
+#define POOL_LIVE_MAX 2048
+
+static int      s_lock;
+static u32      s_pool_base, s_pool_size, s_pool_bump;
+static u32      s_free_head[POOL_BINS];   /* guest EA of the first free block of each bin (next pointer in its first word) */
+static struct { u32 ea; int bin; } s_live[POOL_LIVE_MAX];
+static int      s_live_n;
+
+static void lock(void)   { while (__atomic_test_and_set(&s_lock, __ATOMIC_ACQUIRE)) { } }
+static void unlock(void) { __atomic_clear(&s_lock, __ATOMIC_RELEASE); }
+
+static u32 pool_alloc(u32 bytes)
+{
+    int bin = POOL_MIN_BIN;
+    while (bin < POOL_BINS - 1 && (1u << bin) < bytes) bin++;
+    if ((1u << bin) < bytes) return 0;
+    u32 size = 0, raw = kz2_font_file_cache(&size);
+    u32 base = (raw + 127u) & ~127u;
+    if (!raw || size <= base - raw) base = 0, size = 0;
+    else size -= base - raw;
+    lock();
+    if (base != s_pool_base || size != s_pool_size) {   /* first use, or a new cellFontInit: start over there */
+        s_pool_base = base; s_pool_size = size;
+        s_pool_bump = base; s_live_n = 0;
+        memset(s_free_head, 0, sizeof s_free_head);
+    }
+    u32 ea = 0;
+    if (!s_pool_base) { unlock(); return 0; }
+    if (s_free_head[bin]) {
+        ea = s_free_head[bin];
+        s_free_head[bin] = vm_read32(ea);
+    } else if ((u64)s_pool_bump + (1u << bin) <= (u64)s_pool_base + s_pool_size) {
+        ea = s_pool_bump;
+        s_pool_bump += 1u << bin;
+    }
+    if (ea) {
+        if (s_live_n < POOL_LIVE_MAX) { s_live[s_live_n].ea = ea; s_live[s_live_n].bin = bin; s_live_n++; }
+        else { vm_write32(ea, s_free_head[bin]); s_free_head[bin] = ea; ea = 0; }
+    }
+    unlock();
+    return ea;
+}
+
+static int pool_free(u32 ea)
+{
+    int found = 0;
+    lock();
+    for (int i = 0; i < s_live_n; i++) {
+        if (s_live[i].ea == ea) {
+            int bin = s_live[i].bin;
+            s_live[i] = s_live[--s_live_n];
+            vm_write32(ea, s_free_head[bin]);
+            s_free_head[bin] = ea;
+            found = 1;
+            break;
+        }
+    }
+    unlock();
+    return found;
+}
+
+/* ---- faces and chains ---------------------------------------------------------------------------------------- */
+#define MAX_SUBFACES 8   /* faces of a collection (.ttc); a plain font has one */
+typedef struct {
+    char            path[1200];   /* UTF-8 */
+    int             tried, ok;
+    unsigned char*  data;
+    stbtt_fontinfo  info;         /* face 0 */
+    stbtt_fontinfo  sub[MAX_SUBFACES];
+    int             nsub;
+} KzFace;
+
+/* which face of a collection to use (port/kz2 defines it; weak so a host test without it still links). */
+extern __attribute__((weak)) int kz2_cjk_face_index(void);
+static const stbtt_fontinfo* face_info(const KzFace* f)
+{
+    int i = (f->nsub > 1 && kz2_cjk_face_index) ? kz2_cjk_face_index() : 0;
+    if (i < 0 || i >= f->nsub) i = 0;
+    static int last = -1;
+    if (f->nsub > 1 && i != last) {   /* once per change: which language's shapes the next characters get */
+        last = i;
+        printf("[cellFont] fontset: %s face %d of %d\n", f->path, i, f->nsub);
+        fflush(stdout);
+    }
+    return &f->sub[i];
+}
+
+#define MAX_FACES 8
+#define MAX_CHAIN 4
+#define MAX_HANDLES 64
+static KzFace s_faces[MAX_FACES];
+static int    s_nfaces;
+
+typedef struct { KzFace* f[MAX_CHAIN]; int n; unsigned type; int used; } KzChain;
+static KzChain s_chain[MAX_HANDLES];
+
+static FILE* open_utf8(const char* p)
+{
+#ifdef _WIN32
+    wchar_t w[1024];
+    if (!MultiByteToWideChar(CP_UTF8, 0, p, -1, w, 1024)) return NULL;
+    return _wfopen(w, L"rb");
+#else
+    return fopen(p, "rb");
+#endif
+}
+
+static int file_exists(const char* p) { FILE* f = open_utf8(p); if (f) { fclose(f); return 1; } return 0; }
+
+/* First existing dir/base+ext; returns 1 and fills out. */
+static int find_file(const char* dir, const char* base, char* out, size_t cap)
+{
+    static const char* exts[] = { ".ttf", ".TTF", ".otf", ".OTF", ".ttc", ".TTC" };
+    if (!dir || !*dir) return 0;
+    for (int i = 0; i < 6; i++) {
+        snprintf(out, cap, "%s/%s%s", dir, base, exts[i]);
+        if (file_exists(out)) return 1;
+    }
+    return 0;
+}
+
+static KzFace* face_for(const char* path)
+{
+    for (int i = 0; i < s_nfaces; i++) if (!strcmp(s_faces[i].path, path)) return &s_faces[i];
+    if (s_nfaces >= MAX_FACES) return NULL;
+    KzFace* f = &s_faces[s_nfaces++];
+    memset(f, 0, sizeof *f);
+    snprintf(f->path, sizeof f->path, "%s", path);
+    return f;
+}
+
+/* Loads the file on first use. */
+static int face_load(KzFace* f)
+{
+    if (f->tried) return f->ok;
+    f->tried = 1;
+    FILE* fp = open_utf8(f->path);
+    if (!fp) return 0;
+    fseek(fp, 0, SEEK_END); long sz = ftell(fp); fseek(fp, 0, SEEK_SET);
+    if (sz <= 0) { fclose(fp); return 0; }
+    f->data = (unsigned char*)malloc((size_t)sz);
+    if (!f->data || fread(f->data, 1, (size_t)sz, fp) != (size_t)sz) { fclose(fp); free(f->data); f->data = NULL; return 0; }
+    fclose(fp);
+    int nf = stbtt_GetNumberOfFonts(f->data);
+    if (nf < 1) nf = 1;
+    if (nf > MAX_SUBFACES) nf = MAX_SUBFACES;
+    for (f->nsub = 0; f->nsub < nf; f->nsub++) {
+        int off = stbtt_GetFontOffsetForIndex(f->data, f->nsub);
+        if (off < 0 || !stbtt_InitFont(&f->sub[f->nsub], f->data, off)) break;
+    }
+    if (f->nsub == 0) {
+        printf("[cellFont] fontset: cannot parse %s\n", f->path);
+        free(f->data); f->data = NULL; return 0;
+    }
+    f->info = f->sub[0];
+    f->ok = 1;
+    printf("[cellFont] fontset: loaded %s (%ld bytes, %d face(s))\n", f->path, sz, f->nsub);
+    fflush(stdout);
+    return 1;
+}
+
+static void chain_add(KzChain* c, const char* path)
+{
+    KzFace* f = face_for(path);
+    if (!f) return;
+    for (int i = 0; i < c->n; i++) if (c->f[i] == f) return;
+    if (c->n < MAX_CHAIN) c->f[c->n++] = f;
+}
+
+static void env_utf8(const char* name, char* out, size_t cap)
+{
+    out[0] = 0;
+#ifdef _WIN32
+    wchar_t wn[64], w[1024];
+    if (!MultiByteToWideChar(CP_UTF8, 0, name, -1, wn, 64)) return;
+    DWORD n = GetEnvironmentVariableW(wn, w, 1024);
+    if (n > 0 && n < 1024) WideCharToMultiByte(CP_UTF8, 0, w, -1, out, (int)cap, NULL, NULL);
+#else
+    const char* e = getenv(name);
+    if (e) snprintf(out, cap, "%s", e);
+#endif
+}
+
+static void exe_dir(char* out, size_t cap)
+{
+    out[0] = 0;
+#ifdef _WIN32
+    wchar_t p[1024]; DWORD n = GetModuleFileNameW(NULL, p, 1024);
+    if (n > 0 && n < 1024) {
+        while (n > 0 && p[n - 1] != L'\\' && p[n - 1] != L'/') n--;
+        p[n ? n - 1 : 0] = 0;
+        WideCharToMultiByte(CP_UTF8, 0, p, -1, out, (int)cap, NULL, NULL);
+    }
+#else
+    char p[1024]; ssize_t n = readlink("/proc/self/exe", p, sizeof p - 1);
+    if (n > 0) { p[n] = 0; char* s = strrchr(p, '/'); if (s) { *s = 0; snprintf(out, cap, "%s", p); } }
+#endif
+}
+
+static void chain_build(KzChain* c, unsigned type)
+{
+    memset(c, 0, sizeof *c);
+    c->used = 1; c->type = type;
+    /* ASSUMPTION: every system fontset type gets the same face; KZ2 opens only 0x109 (Rodin Latin/Greek/Cyrillic +
+     * CJK sets on the PS3; the CJK part is not backed here). */
+    char dir[1024]; env_utf8("KZ2_FONT_DIR", dir, sizeof dir);
+    if (!dir[0]) { char ed[1000]; exe_dir(ed, sizeof ed); if (ed[0]) snprintf(dir, sizeof dir, "%s/fonts", ed); }
+    static const char* const names[] = { "NotoSans-Regular", "NotoSans", "NotoSansCJK-Regular", NULL };
+    const char* dirs[2] = { dir, "fonts" };
+    char path[1200];
+    for (int d = 0; d < 2 && c->n == 0; d++)   /* ./fonts only when the first dir has none (often the same folder) */
+        for (int i = 0; names[i]; i++)
+            if (find_file(dirs[d], names[i], path, sizeof path)) chain_add(c, path);
+    printf("[cellFont] fontset type=0x%X: %d font file(s) in the chain (dir %s)\n", type, c->n, dir[0] ? dir : "none");
+    if (c->n == 0)
+        printf("[cellFont] fontset: no fonts found. Put NotoSans-Regular.ttf and NotoSansCJK-Regular.ttc in <exe dir>/fonts or set KZ2_FONT_DIR; "
+               "characters the game's own fonts lack stay blank.\n");
+    fflush(stdout);
+}
+
+/* Exported to cellFont.c. */
+void kz2_fontset_open(u32 handle, u32 type)
+{
+    if (handle >= MAX_HANDLES) return;
+    lock(); chain_build(&s_chain[handle], type); unlock();
+}
+void kz2_fontset_close(u32 handle)
+{
+    if (handle < MAX_HANDLES) s_chain[handle].used = 0;
+}
+/* First loadable face of the chain, so the library's bitmap functions have something too. */
+int kz2_fontset_primary(u32 handle, stbtt_fontinfo* out)
+{
+    if (handle >= MAX_HANDLES || !s_chain[handle].used) return 0;
+    lock();
+    int ok = 0;
+    for (int i = 0; i < s_chain[handle].n && !ok; i++)
+        if (face_load(s_chain[handle].f[i])) { *out = s_chain[handle].f[i]->info; ok = 1; }
+    unlock();
+    return ok;
+}
+
+/* The face and glyph index that draw `code` for this font handle (NULL when none has it). */
+static const stbtt_fontinfo* find_glyph(u32 handle, u32 code, int* glyph, stbtt_fontinfo* tmp)
+{
+    *glyph = 0;
+    if (handle >= MAX_HANDLES || code == 0) return NULL;
+    KzChain* c = &s_chain[handle];
+    if (!c->used) {   /* not a fontset slot: the font opened from a file or memory */
+        if (kz2_font_slot_stb(handle, tmp)) { *glyph = stbtt_FindGlyphIndex(tmp, (int)code); return *glyph ? tmp : NULL; }
+        return NULL;
+    }
+    lock();
+    const stbtt_fontinfo* r = NULL;
+    for (int i = 0; i < c->n; i++) {
+        if (!face_load(c->f[i])) continue;
+        const stbtt_fontinfo* fi = face_info(c->f[i]);
+        int g = stbtt_FindGlyphIndex(fi, (int)code);
+        if (g) { *tmp = *fi; *glyph = g; r = tmp; break; }
+    }
+    unlock();
+    return r;
+}
+
+/* ---- outline conversion -------------------------------------------------------------------------------------- */
+typedef struct { float x, y; unsigned char on; } Pt;
+typedef struct { Pt* p; int n, cap; unsigned short* ends; int nc, capc; int oom; } Outline;
+
+static int ol_pt(Outline* o, float x, float y, int on)
+{
+    if (o->n == o->cap) {
+        int nc = o->cap ? o->cap * 2 : 128;
+        Pt* np = (Pt*)realloc(o->p, (size_t)nc * sizeof(Pt));
+        if (!np) { o->oom = 1; return 0; }
+        o->p = np; o->cap = nc;
+    }
+    o->p[o->n].x = x; o->p[o->n].y = y; o->p[o->n].on = (unsigned char)on; o->n++;
+    return 1;
+}
+
+static void ol_close(Outline* o, int start)
+{
+    if (o->n <= start) return;
+    /* stb closes every contour with a segment back to the start; that closing point duplicates the first one. */
+    if (o->n - start > 1 && o->p[o->n - 1].on && fabsf(o->p[o->n - 1].x - o->p[start].x) < 1e-3f &&
+        fabsf(o->p[o->n - 1].y - o->p[start].y) < 1e-3f)
+        o->n--;
+    if (o->nc == o->capc) {
+        int nc = o->capc ? o->capc * 2 : 16;
+        unsigned short* ne = (unsigned short*)realloc(o->ends, (size_t)nc * sizeof(unsigned short));
+        if (!ne) { o->oom = 1; return; }
+        o->ends = ne; o->capc = nc;
+    }
+    o->ends[o->nc++] = (unsigned short)(o->n - 1);
+}
+
+/* Cubic p0,c1,c2,p3 -> quadratics (the game's converter is TrueType-style): split in halves `depth` times, each piece
+ * approximated by one quadratic whose control point is (3(c1+c2) - (p0+p3)) / 4. 4 pieces at depth 2. Only CFF (.otf)
+ * faces have cubics; Noto Sans .ttf has none. */
+static void cubic_to_quads(Outline* o, float x0, float y0, float x1, float y1, float x2, float y2, float x3, float y3,
+                           int depth)
+{
+    if (depth == 0) {
+        ol_pt(o, (3 * (x1 + x2) - (x0 + x3)) / 4, (3 * (y1 + y2) - (y0 + y3)) / 4, 0);
+        ol_pt(o, x3, y3, 1);
+        return;
+    }
+    float ax = (x0 + x1) / 2, ay = (y0 + y1) / 2, bx = (x1 + x2) / 2, by = (y1 + y2) / 2, cx = (x2 + x3) / 2, cy = (y2 + y3) / 2;
+    float dx = (ax + bx) / 2, dy = (ay + by) / 2, ex = (bx + cx) / 2, ey = (by + cy) / 2;
+    float mx = (dx + ex) / 2, my = (dy + ey) / 2;
+    cubic_to_quads(o, x0, y0, ax, ay, dx, dy, mx, my, depth - 1);
+    cubic_to_quads(o, mx, my, ex, ey, cx, cy, x3, y3, depth - 1);
+}
+
+static void shape_to_outline(const stbtt_fontinfo* info, int glyph, float sx, float sy, Outline* o)
+{
+    stbtt_vertex* v = NULL;
+    int nv = stbtt_GetGlyphShape(info, glyph, &v);
+    int start = 0; float px = 0, py = 0;
+    for (int i = 0; i < nv; i++) {
+        float x = v[i].x * sx, y = v[i].y * sy, cx = v[i].cx * sx, cy = v[i].cy * sy, c1x = v[i].cx1 * sx, c1y = v[i].cy1 * sy;
+        switch (v[i].type) {
+        case STBTT_vmove:  ol_close(o, start); start = o->n; ol_pt(o, x, y, 1); break;
+        case STBTT_vline:  ol_pt(o, x, y, 1); break;
+        case STBTT_vcurve: ol_pt(o, cx, cy, 0); ol_pt(o, x, y, 1); break;
+        case STBTT_vcubic: cubic_to_quads(o, px, py, cx, cy, c1x, c1y, x, y, 2); break;
+        }
+        px = x; py = y;
+    }
+    ol_close(o, start);
+    if (v) stbtt_FreeShape(info, v);
+}
+
+/* ---- API ------------------------------------------------------------------------------------------------------ */
+static float rd_f32(u32 ea) { uint32_t b = vm_read32(ea); float f; memcpy(&f, &b, 4); return f; }
+
+/* 0: found (m filled, outline if ol); else the cellFont error to return. */
+static s32 glyph_metrics(u32 font, u32 code, float m[8], Outline* ol)
+{
+    memset(m, 0, 8 * sizeof(float));
+    int handle = kz2_font_handle(font);
+    if (handle == -2) return CELL_FONT_ERROR_UNINITIALIZED;
+    if (handle < 0) return CELL_FONT_ERROR_INVALID_PARAMETER;
+    float w = rd_f32(font + 8), h = rd_f32(font + 12);   /* the scale cellFontSetScalePixel stored (FONT_O_SCALEX/Y) */
+    stbtt_fontinfo tmp; int g;
+    const stbtt_fontinfo* info = find_glyph((u32)handle, code, &g, &tmp);
+    if (!info) return (s32)KZ2_FONT_ERROR_NO_SUPPORT_CODE;
+    float em = stbtt_ScaleForMappingEmToPixels(info, 1.0f);   /* 1 / unitsPerEm */
+    float sx = em * w, sy = em * h;
+    int adv, lsb, x0, y0, x1, y1;
+    stbtt_GetGlyphHMetrics(info, g, &adv, &lsb);
+    if (!stbtt_GetGlyphBox(info, g, &x0, &y0, &x1, &y1)) { x0 = y0 = x1 = y1 = 0; }
+    int asc, desc, gap; stbtt_GetFontVMetrics(info, &asc, &desc, &gap);
+    m[0] = (x1 - x0) * sx;            /* width */
+    m[1] = (y1 - y0) * sy;            /* height */
+    m[2] = x0 * sx;                   /* h_bearing_x */
+    m[3] = y1 * sy;                   /* h_bearing_y: baseline to the top edge */
+    m[4] = adv * sx;                  /* h_advance */
+    m[5] = x0 * sx - adv * sx * 0.5f; /* v_bearing_x (ASSUMPTION: centred on the advance) */
+    m[6] = (asc - y1) * sy;           /* v_bearing_y (ASSUMPTION) */
+    m[7] = (asc - desc) * sy;         /* v_advance (ASSUMPTION) */
+    if (ol) shape_to_outline(info, g, sx, sy, ol);
+    return CELL_OK;
+}
+
+/* cellFontGetCharGlyphMetrics(CellFont*, u32 code, CellFontGlyphMetrics*) */
+s32 cellFontGetCharGlyphMetrics(u32 font, u32 code, u32 metrics)
+{
+    if (!font || !metrics) return CELL_FONT_ERROR_INVALID_PARAMETER;
+    float m[8];
+    s32 r = glyph_metrics(font, code, m, NULL);
+    static int n_log = 0;
+    if (n_log < 4) {
+        n_log++;
+        printf("[cellFont] GetCharGlyphMetrics(U+%04X) -> 0x%X: h_bearingY %.2f h_advance %.2f (scale %.1f x %.1f)\n",
+               code, (unsigned)r, m[3], m[4], rd_f32(font + 8), rd_f32(font + 12));
+        fflush(stdout);
+    }
+    if (r) return r;
+    for (int i = 0; i < 8; i++) vm_write_f32(metrics + 4u * i, m[i]);
+    return CELL_OK;
+}
+
+/* cellFontGenerateCharGlyph(CellFont*, u32 code, CellFontGlyph** out). On success *out is a valid record (the game
+ * reads it unchecked); on any error *out is 0. */
+s32 cellFontGenerateCharGlyph(u32 font, u32 code, u32 glyph_out)
+{
+    if (!font || !glyph_out) return CELL_FONT_ERROR_INVALID_PARAMETER;
+    float m[8]; Outline ol; memset(&ol, 0, sizeof ol);
+    s32 r = glyph_metrics(font, code, m, &ol);
+    u32 n = (u32)ol.n, nc = (u32)ol.nc;
+    if (!r && (ol.oom || n > 0x7FFF || nc > 0x7FFF)) r = CELL_FONT_ERROR_ALLOCATION_FAILED;
+    u32 o_pts = 0x40, o_flags = o_pts + 8 * n, o_ends = (o_flags + n + 1) & ~1u;
+    u32 ea = r ? 0 : pool_alloc(o_ends + 2 * nc);
+    if (!r && !ea) r = CELL_FONT_ERROR_ALLOCATION_FAILED;
+    static int n_log = 0;
+    if (n_log < 8 && (code > 0x7F || r)) {
+        float bx0 = 0, bx1 = 0, by0 = 0, by1 = 0;
+        for (u32 i = 0; i < n; i++) {
+            const Pt* p = &ol.p[i];
+            if (!i || p->x < bx0) bx0 = p->x;
+            if (!i || p->x > bx1) bx1 = p->x;
+            if (!i || p->y < by0) by0 = p->y;
+            if (!i || p->y > by1) by1 = p->y;
+        }
+        n_log++;
+        printf("[cellFont] GenerateCharGlyph(U+%04X) -> 0x%X: %u contour(s), %u point(s), x %.1f..%.1f y %.1f..%.1f, "
+               "h_advance %.1f, record 0x%08X\n", code, (unsigned)r, nc, n, bx0, bx1, by0, by1, m[4], ea);
+        fflush(stdout);
+    }
+    if (r) { free(ol.p); free(ol.ends); vm_write32(glyph_out, 0); return r; }
+    for (u32 o = 0; o < 0x40; o += 4) vm_write32(ea + o, 0);
+    vm_write32(ea + 4, o_ends + 2 * nc);   /* size */
+    for (int i = 0; i < 8; i++) vm_write_f32(ea + 8 + 4u * i, m[i]);
+    vm_write16(ea + 0x28, (uint16_t)nc);
+    vm_write16(ea + 0x2A, (uint16_t)n);
+    vm_write32(ea + 0x2C, n ? ea + o_pts : 0);
+    vm_write32(ea + 0x30, n ? ea + o_flags : 0);
+    vm_write32(ea + 0x34, nc ? ea + o_ends : 0);
+    for (u32 i = 0; i < n; i++) {
+        vm_write_f32(ea + o_pts + 8 * i, ol.p[i].x);
+        vm_write_f32(ea + o_pts + 8 * i + 4, ol.p[i].y);
+        vm_write8(ea + o_flags + i, ol.p[i].on ? 1 : 0);
+    }
+    for (u32 i = 0; i < nc; i++) vm_write16(ea + o_ends + 2 * i, ol.ends[i]);
+    free(ol.p); free(ol.ends);
+    vm_write32(glyph_out, ea);
+    return CELL_OK;
+}
+
+/* cellFontDeleteGlyph(CellFont*, CellFontGlyph*) */
+s32 cellFontDeleteGlyph(u32 font, u32 glyph)
+{
+    (void)font;
+    if (!glyph) return CELL_FONT_ERROR_INVALID_PARAMETER;
+    return pool_free(glyph) ? CELL_OK : CELL_FONT_ERROR_INVALID_PARAMETER;
+}
+
+/* cellFontEndLibrary(const CellFontLibrary*): nothing is held per library (KZ2 calls it at shutdown @0x00044708). */
+s32 cellFontEndLibrary(u32 lib)
+{
+    (void)lib;
+    return CELL_OK;
+}
+
+/* cellFontSetScalePixel(font, float w, float h): the floats arrive in f1/f2, which the flat integer-register HLE
+ * adapter cannot pass, so the flat cellFontSetScalePixel received the host's stale xmm1/xmm2. A context handler
+ * registered under the same NID takes precedence over the flat table. */
+static void hle_set_scale_pixel(ppu_context* ctx)
+{
+    ctx->gpr[3] = (u64)(s64)kz2_font_set_scale_pixel((u32)ctx->gpr[3], (float)ctx->fpr[1], (float)ctx->fpr[2]);
+}
+
+extern void ps3_hle_register_ctx(uint32_t nid, const char* name, void (*fn)(ppu_context*));
+__attribute__((constructor)) static void kz2_font_register(void)
+{
+    ps3_hle_register_ctx(ps3_compute_nid("cellFontSetScalePixel"), "cellFontSetScalePixel", hle_set_scale_pixel);
+    ps3_hle_register_ctx(ps3_compute_nid("cellFontSetupRenderScalePixel"), "cellFontSetupRenderScalePixel", hle_set_scale_pixel);
+}

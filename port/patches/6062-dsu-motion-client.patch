 #include "pad_kb_roles.h"      /* 6050 */
+#include "pad_dsu_io.h"        /* 6062: DSU (cemuhook) motion client, from KZ3 patch 4028 */
 #ifndef _WIN32
 /* 4011: PKB_PROMPTS_* and the value names on every platform (pure header; the Windows keyboard code below includes it

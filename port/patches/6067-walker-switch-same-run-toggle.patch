KZ2 patch 6067: KZ2_WALKER_TOGGLE=<s>, the same-run A/B of the walker's switches. Diagnostic; no
behaviour change unless a switch is set to T.

Written here (the shape of KZ2 patch 7014's KZ2_PARK_WATCH_TOGGLE). gcm_walker_switch(name, default,
&cache) reads a switch once: unset/empty = the default, "T" = toggled, anything else atoi != 0, and logs
`[walker-toggle] NAME = on|off|toggled`. A toggled switch follows g_gcm_walker_toggle_phase: KZ2_WALKER_TOGGLE=<s>
splits the run into phases of <s> seconds of wacct time (patch 1032's clock), even = off, odd = on; the phase moves only
at the FIFO's flip word (after patch 6011's note), so no frame is split, and each move is printed as
`[walker-toggle] t=<wacct s> phase=N on|off wall=<host Unix s>`. KZ2_WALKER_TOGGLE_INVERT=1 (or the SPU's
KZ2_AB_TOGGLE_INVERT=1, patch 7016) starts with an on-phase (numbering from 1, so odd = on still holds): a scripted
route's scene changes then fall in the other phase, and one normal plus one inverted run are pooled. tools/runtime/perf/walker_ab.py pairs the phases (RSX_PERF lines, wacct
windows, flips). Users: LD_CB_REUSE (6064), GCM_FAST_METHODS (6065), GCM_LEGACY_STATE_SKIP (6066); every switch keeps
its own default (all off). A switch that changes mid-run is safe for these three: CB reuse records the slot on every
copying draw either way, the fast path is chosen per method header, and the legacy rsx_state feeds only the null
backend's log lines.

diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index 5c42a93..4a7673a 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -2812,6 +2812,47 @@ static int gcm_get_eq_put(void)
  * drain: the walker hands every data word through these checks, a million a
  * second in God of War HD gameplay, and it used to test each switch on its
  * own for every word. */
+/* KZ2 patch 6067: KZ2_WALKER_TOGGLE=<s>, the same-run A/B of the walker switches. A switch set to T (LD_CB_REUSE=T,
+ * GCM_FAST_METHODS=T, GCM_LEGACY_STATE_SKIP=T, LD_PSO_KEY_MEMO=T, LD_REC_MEMO=T) follows the phase: off in even phases,
+ * on in odd ones, each phase <s> seconds of wacct time. The phase moves only at a flip word, so a frame is never split;
+ * each switch is printed as `[walker-toggle] t=<wacct s> phase=N on|off` (tools/runtime/perf/walker_ab.py). */
+volatile int g_gcm_walker_toggle_phase;   /* the phase parity the T switches read (0 = off) */
+int gcm_walker_toggle_on(void) { return g_gcm_walker_toggle_phase & 1; }
+/* 1 = off/on value of a switch variable: unset/empty = dflt, "T" = the toggle's phase, else atoi != 0. */
+int gcm_walker_switch(const char* name, int dflt, int* cache)
+{
+    if (*cache < 0) {
+        const char* e = getenv(name);
+        *cache = (e && (e[0] == 'T' || e[0] == 't')) ? 2 : (e && *e) ? (atoi(e) != 0) : dflt;
+        fprintf(stderr, "[walker-toggle] %s = %s\n", name, *cache == 2 ? "toggled" : *cache ? "on" : "off");
+    }
+    return *cache == 2 ? (g_gcm_walker_toggle_phase & 1) : *cache;
+}
+static void gcm_walker_toggle_flip(void)
+{
+    static double per = -1; static uint64_t t0; static long s_ph = -1;
+    extern uint64_t kz3_wacct_now(void); extern uint64_t kz3_wacct_base(void);
+    static long inv;   /* KZ2_WALKER_TOGGLE_INVERT=1 (or the SPU's KZ2_AB_TOGGLE_INVERT=1): start "on" */
+    if (per < 0) { const char* e = getenv("KZ2_WALKER_TOGGLE"); per = (e && *e) ? atof(e) : 0; t0 = kz3_wacct_now();
+                   const char* i1 = getenv("KZ2_WALKER_TOGGLE_INVERT"); const char* i2 = getenv("KZ2_AB_TOGGLE_INVERT");
+                   inv = ((i1 && i1[0] == '1') || (i2 && i2[0] == '1')) ? 1 : 0; }
+    if (per <= 0) return;
+    const uint64_t n = kz3_wacct_now();
+    const long ph = (long)((double)(n - t0) / (per * 1e9)) + inv;   /* inverted: numbering starts at 1 (odd = on) */
+    if (ph == s_ph) return;
+    s_ph = ph;
+    g_gcm_walker_toggle_phase = (int)(ph & 1);
+    const uint64_t b = kz3_wacct_base();
+    double wall;   /* host wall clock (Unix s): pairs the switch with KZ2_VIDEO's frame files (their mtimes) */
+#ifdef _WIN32
+    { FILETIME ft; GetSystemTimeAsFileTime(&ft);
+      wall = (double)(((uint64_t)ft.dwHighDateTime << 32) | ft.dwLowDateTime) / 1e7 - 11644473600.0; }
+#else
+    { struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); wall = (double)ts.tv_sec + ts.tv_nsec / 1e9; }
+#endif
+    fprintf(stderr, "[walker-toggle] t=%.3fs phase=%ld %s wall=%.3f\n", b ? (double)(n - b) / 1e9 : (double)n / 1e9, ph,
+            (ph & 1) ? "on" : "off", wall);
+}

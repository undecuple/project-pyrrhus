+    if (g_ld_rm.live && g_ld_rm.ra_ok[i] && g_ld_rm.ra[i] == v) { g_ld_rm_skips++; return 0; }
+    g_ld_rm.ra_ok[i] = 1; g_ld_rm.ra[i] = v;
+    return 1;
+}

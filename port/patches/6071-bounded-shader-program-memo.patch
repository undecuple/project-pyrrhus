+/* Bounded byte-validated shader identity memo. Written for Project Pyrrhus.
+ * Caller owns synchronization and validates mapped bytes before accepting reuse.
+ * No guest write-generation assumptions; eviction is bounded round-robin. */
+#ifndef RSX_PROGRAM_MEMO_H
+#define RSX_PROGRAM_MEMO_H
+#include <stdint.h>
+#include <string.h>
+#define RSX_PM_SLOTS 8u
+#define RSX_PM_BYTES 0x10000u
+#define RSX_PM_HASHES 4u
+typedef struct {
+    uint32_t valid, mode;
+    uint64_t seed, value;
+} rsx_pm_hash;
+typedef struct {
+    uint32_t loc, off, size, n, hvalid, hmode;
+    uint64_t hseed, h;
+    uint32_t scans_valid, units, ddy, wpos, hash_next;
+    rsx_pm_hash hashes[RSX_PM_HASHES];
+    unsigned char bytes[RSX_PM_BYTES];
+} rsx_pm_entry;
+typedef struct {
+    rsx_pm_entry entries[RSX_PM_SLOTS];
+    uint32_t next;
+} rsx_program_memo;
+/* Location/start + offset select the candidate only. The caller must still
+ * compare all size bytes and invalidate derived values after any byte change. */
+static inline rsx_pm_entry* rsx_pm_select(rsx_program_memo* memo, uint32_t loc, uint32_t off)
+{
+    for (uint32_t i = 0; i < RSX_PM_SLOTS; i++) {
+        rsx_pm_entry* e = &memo->entries[i];
+        if (e->size && e->loc == loc && e->off == off) return e;
+    }
+    rsx_pm_entry* e = &memo->entries[memo->next];
+    memo->next = (memo->next + 1u) % RSX_PM_SLOTS;
+    memset(e, 0, sizeof *e);
+    e->loc = loc; e->off = off;
+    return e;
+}
+static inline void rsx_pm_invalidate(rsx_pm_entry* e)
+{
+    e->hvalid = e->scans_valid = e->hash_next = 0;
+    memset(e->hashes, 0, sizeof e->hashes);
+}
+static inline int rsx_pm_hash_get(const rsx_pm_entry* e, uint32_t mode, uint64_t seed, uint64_t* out)
+{
+    for (uint32_t i = 0; i < RSX_PM_HASHES; i++) {
+        const rsx_pm_hash* h = &e->hashes[i];
+        if (h->valid && h->mode == mode && h->seed == seed) { *out = h->value; return 1; }
+    }
+    return 0;
+}
+static inline void rsx_pm_hash_put(rsx_pm_entry* e, uint32_t mode, uint64_t seed, uint64_t value)
+{
+    rsx_pm_hash* h = &e->hashes[e->hash_next];
+    e->hash_next = (e->hash_next + 1u) % RSX_PM_HASHES;
+    h->valid = 1; h->mode = mode; h->seed = seed; h->value = value;
+}
+#endif

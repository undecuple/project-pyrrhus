KZ2: publish wait-accounting readiness after profiler initialization.

A naming thread can otherwise see enabled accounting before prof_init sets s_prof_on,
return from prof_attach without a sampling handle, and never retry its one naming call.
This fixes that source-level initialization race; the historical zero walker samples
have not been reproduced or attributed to it. Acquire/release readiness also publishes
the clock, TLS slot and profiler fields. The flip counter and three GCM/SPU skip-only guards use relaxed atomic readiness
loads; note/job callees acquire readiness themselves. Remaining direct interval reads
are printer-only after its creation, which follows publication. Disabled accounting still publishes zero without starting helpers.

The profiler setup and its sampler use kz3_wacct_now directly and do not reenter the
accounting initializer, so delayed readiness cannot make them wait on themselves.
No attribution to a measured FPS gain. Test: tools/runtime/test_profiler_init.sh.

diff --git a/runtime/diag/kz3_wait_acct.c b/runtime/diag/kz3_wait_acct.c
--- a/runtime/diag/kz3_wait_acct.c
+++ b/runtime/diag/kz3_wait_acct.c
@@ -172,7 +172,7 @@
 
 void kz3_wacct_flip(void)
 {
-    if (g_kz3_wacct > 0) __sync_fetch_and_add(&s_flips, 1);
+    if (__atomic_load_n(&g_kz3_wacct, __ATOMIC_RELAXED) > 0) __sync_fetch_and_add(&s_flips, 1);
     if (g_kz3_wtrace) { const uint64_t n = kz3_wacct_now(); kz3_wacct_trace(KZ3_WT_FLIP, 0, n, n); }   /* patch 1085 */
 }
 
@@ -442,8 +442,9 @@
 {
     static volatile long once = 0;
     if (__sync_val_compare_and_swap(&once, 0, 1) != 0) {
-        while (*(volatile int*)&g_kz3_wacct < 0) { /* another thread is initialising */ }
-        return g_kz3_wacct;
+        int ready;
+        while ((ready = __atomic_load_n(&g_kz3_wacct, __ATOMIC_ACQUIRE)) < 0) { /* another thread is initialising */ }
+        return ready;
     }
     const char* e = getenv("KZ3_WAIT_ACCT");
     int ms = e ? atoi(e) : 0;
@@ -456,13 +457,16 @@
     s_t0 = kz3_wacct_now();
     if (ms) {
         fprintf(stderr, "[wacct] on: %d ms windows (KZ3 patch 1032)\n", ms);
-        g_kz3_wacct = ms;
         prof_init();   /* patch 1033 */
+        /* KZ2: naming must not pass readiness before profiler setup completes.
+         * prof_init/prof_thread use the initialized clock directly, without reentering init.
+         * Publish before starting the printer, which reads the interval immediately. */
+        __atomic_store_n(&g_kz3_wacct, ms, __ATOMIC_RELEASE);
 #ifdef _WIN32
         CreateThread(NULL, 1u << 18, printer, NULL, 0, NULL);
 #else
         pthread_t th; pthread_create(&th, NULL, printer, NULL);
 #endif
-    } else g_kz3_wacct = 0;
-    return g_kz3_wacct;
-}
+    } else __atomic_store_n(&g_kz3_wacct, 0, __ATOMIC_RELEASE);
+    return ms;
+}
diff --git a/runtime/diag/kz3_wait_acct.h b/runtime/diag/kz3_wait_acct.h
--- a/runtime/diag/kz3_wait_acct.h
+++ b/runtime/diag/kz3_wait_acct.h
@@ -51,7 +51,11 @@
 void     kz3_wacct_name(const char* name);  /* name this host thread */
 void     kz3_wacct_flip(void);
 
-static inline int kz3_wacct_on(void) { return g_kz3_wacct < 0 ? kz3_wacct_init() : g_kz3_wacct; }
+static inline int kz3_wacct_on(void)
+{
+    const int ready = __atomic_load_n(&g_kz3_wacct, __ATOMIC_ACQUIRE);
+    return ready < 0 ? kz3_wacct_init() : ready;
+}
 /* Returns 0 when off; kz3_wacct_end ignores t0 == 0. */
 static inline uint64_t kz3_wacct_begin(void) { return kz3_wacct_on() ? kz3_wacct_begin_slow() : 0; }
 

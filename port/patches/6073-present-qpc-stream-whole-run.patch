+/* KZ2 patch 6073: the column line and one CSV row (shared by the shutdown dump and the stream). */
+static void ld_present_write_row(FILE* f, const ld_present_sample* sample)
+{
+    if (g_ld_schedule_diag) {
+        fprintf(f, "%llu,%u,%lld,%llu,%llu,%llu,%llu,%u\n",
+                (unsigned long long)sample->present_id,
+                sample->guest_frame, sample->qpc,
+                (unsigned long long)sample->process_kernel_100ns,
+                (unsigned long long)sample->process_user_100ns,
+                (unsigned long long)sample->present_thread_kernel_100ns,
+                (unsigned long long)sample->present_thread_user_100ns,
+                sample->present_thread_id);
+    } else {
+        fprintf(f, "%llu,%u,%lld\n",
+                (unsigned long long)sample->present_id,
+                sample->guest_frame, sample->qpc);
+    }
+}
+
+static void ld_present_write_columns(FILE* f)
+{
+    if (g_ld_schedule_diag) {
+        fprintf(f, "present_id,guest_frame,qpc,process_kernel_100ns,"
+                   "process_user_100ns,present_thread_kernel_100ns,"
+                   "present_thread_user_100ns,present_thread_id\n");
+    } else {
+        fprintf(f, "present_id,guest_frame,qpc\n");
+    }
+}
+
+/* KZ2 patch 6073: open the stream file at renderer init. A second comment line ties the QPC clock to the
+ * wall clock: '# clock qpc=<ticks> filetime=<100 ns since 1601 UTC>' (the QPC is the midpoint of two reads
+ * around GetSystemTimePreciseAsFileTime), so a window can be chosen by an outside timestamp (the run
+ * driver's settle file) rather than by a fixed guest frame. */
+static void ld_present_stream_open(void)
+{
+    if (g_ld_present_stream || g_ld_qpc_frequency <= 0)
+        return;
+    char path[256];
+    snprintf(path, sizeof(path), "scratch\\present_qpc_%lu.csv",
+             (unsigned long)GetCurrentProcessId());
+    FILE* f = fopen(path, "wb");
+    if (!f) {
+        fprintf(stderr, "[present-qpc] stream: cannot open %s\n", path);
+        return;
+    }
+    LARGE_INTEGER a, b;
+    FILETIME ft;
+    QueryPerformanceCounter(&a);
+    GetSystemTimePreciseAsFileTime(&ft);
+    QueryPerformanceCounter(&b);
+    ULARGE_INTEGER wall;
+    wall.LowPart = ft.dwLowDateTime;
+    wall.HighPart = ft.dwHighDateTime;
+    fprintf(f, "# qpc_frequency=%lld\n", g_ld_qpc_frequency);
+    fprintf(f, "# clock qpc=%lld filetime=%llu\n",
+            a.QuadPart + (b.QuadPart - a.QuadPart) / 2,
+            (unsigned long long)wall.QuadPart);
+    ld_present_write_columns(f);
+    fflush(f);
+    g_ld_present_written = 0;
+    g_ld_present_stream = f;
+    fprintf(stderr, "[present-qpc] streaming every %u presents to %s\n",
+            LD_PRESENT_STREAM_BATCH, path);
+}
+
+/* KZ2 patch 6073: write the samples recorded since the last flush. Called on the present thread after a
+ * sample's QPC was read (so its cost lands in the next interval: one buffered write and one fflush per
+ * batch) and at shutdown. A sample the ring already overwrote is never fabricated: the gap stays visible. */
+static void ld_present_stream_flush(void)
+{
+    AcquireSRWLockExclusive(&g_ld_present_stream_lock);
+    FILE* f = g_ld_present_stream;
+    if (f) {
+        const u64 total = g_ld_present_total;
+        u64 id = g_ld_present_written + 1u;
+        if (total > LD_PRESENT_RING_CAP && id < total - LD_PRESENT_RING_CAP + 1u)
+            id = total - LD_PRESENT_RING_CAP + 1u;
+        for (; id <= total; ++id) {
+            const ld_present_sample* sample =
+                &g_ld_present_ring[(id - 1u) & (LD_PRESENT_RING_CAP - 1u)];
+            if (sample->present_id == id)
+                ld_present_write_row(f, sample);
+        }
+        g_ld_present_written = total;
+        fflush(f);
+    }
+    ReleaseSRWLockExclusive(&g_ld_present_stream_lock);
 }
 

diff --git a/libs/video/rsx_vc_ways.h b/libs/video/rsx_vc_ways.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_vc_ways.h
@@ -0,0 +1,49 @@
+/* rsx_vc_ways.h - set-associative slot choice for the live draw's draw payload cache (KZ2 patch 6074, LD_VC_WAYS).
+ *
+ * Patch 2047's cache (rsx_live_draw.c, ld_vc_*) is direct-mapped: 16384 slots, one key per slot, and a new key
+ * evicts whatever its slot holds. An entry is filled only at the second sight of its key, so two keys that share a
+ * slot and both come every frame evict each other every frame and are never filled, and a key that comes once (a
+ * ring offset of per-frame geometry) evicts a filled entry that then needs two more sights. With LD_VC_WAYS=N
+ * (power of two, 1..RSX_VCW_MAX) the slots form sets of N ways; a key may sit in any way of its set, and a new key
+ * takes an empty way, else the least recently used one. N = 1 is the old placement exactly (set base = the old
+ * slot index). Only placement changes: a hit still needs the full key compare and every source check of 2047.
+ *
+ * Pure functions, no D3D12: used by rsx_live_draw.c and by the host test tools/runtime/test_vc_ways.sh.
+ */
+#ifndef RSX_VC_WAYS_H
+#define RSX_VC_WAYS_H
+
+#include <stdint.h>
+
+#define RSX_VCW_MAX 16u
+
+typedef struct { uint8_t state; uint64_t tick; } rsx_vcw_way;   /* state 0 = empty; tick = last access */
+
+/* LD_VC_WAYS value -> ways: the largest power of two <= v, within 1..RSX_VCW_MAX. */
+static inline uint32_t rsx_vcw_clamp(long v)
+{
+    uint32_t w = 1;
+    if (v > (long)RSX_VCW_MAX) v = (long)RSX_VCW_MAX;
+    while ((long)(w * 2u) <= v) w *= 2u;
+    return w;
+}
+
+/* First slot of the key's set. slots and ways are powers of two, ways <= slots. ways = 1: (h ^ h >> 32) & (slots-1),
+ * patch 2047's slot. */
+static inline uint32_t rsx_vcw_set_base(uint64_t h, uint32_t slots, uint32_t ways)
+{
+    return (uint32_t)((h ^ (h >> 32)) & (uint64_t)(slots - 1u)) & ~(ways - 1u);
+}
+
+/* The way a new key replaces: the first empty way, else the one with the oldest tick (the first of equals). */
+static inline uint32_t rsx_vcw_victim(const rsx_vcw_way* w, uint32_t ways)
+{
+    uint32_t v = 0;
+    for (uint32_t i = 0; i < ways; i++) {
+        if (!w[i].state) return i;
+        if (w[i].tick < w[v].tick) v = i;
+    }
+    return v;
+}
+
+#endif

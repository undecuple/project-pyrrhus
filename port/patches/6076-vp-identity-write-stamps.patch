diff --git a/libs/video/rsx_vp_gen.h b/libs/video/rsx_vp_gen.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_vp_gen.h
@@ -0,0 +1,69 @@
+/* rsx_vp_gen.h - the vertex program's identity from write generations (KZ2 patch 6076, LD_VP_GEN).
+ *
+ * The transform program store (rsx_dispatch.vp, 544 instructions) is host memory that only rsx_dispatch.c writes:
+ * the upload method window (NV4097_SET_TRANSFORM_PROGRAM), rsx_dispatch_seed_transform_program and
+ * rsx_dispatch_init. Each of them stamps the 16-instruction blocks whose words changed with a new value of one
+ * global, monotonic 64-bit clock (rsx_dsp_vp_clock). A program's length (up to its END instruction), FNV hash and
+ * TXL unit mask depend only on the words from its start slot to its END, so an entry computed when the clock read C
+ * is still exact while no block of [start, start + instrs) carries a stamp above C. Nothing is guessed: a write of
+ * an equal word leaves the stamp alone, any other write moves it past every entry that covers it.
+ * Before patch 6076 the live draw compared the whole program (up to 8.5 KB) byte for byte against a one-entry memo
+ * on every draw and rehashed it whenever the previous draw used another program.
+ *
+ * Pure functions, no D3D12: used by rsx_live_draw.c and by the host test tools/runtime/test_vp_gen.sh.
+ */
+#ifndef RSX_VP_GEN_H
+#define RSX_VP_GEN_H
+
+#include <stdint.h>
+
+#define RSX_VPG_BLOCK 16u      /* instructions per stamped block */
+#define RSX_VPG_SLOTS 16u      /* memo entries (programs by start slot) */
+
+typedef struct {
+    uint32_t start, instrs, txl;   /* instrs 0 = empty entry */
+    uint64_t clock, h;
+} rsx_vpg_entry;
+
+typedef struct {
+    rsx_vpg_entry e[RSX_VPG_SLOTS];
+    uint32_t next;
+    uint64_t hits, puts, stale;
+} rsx_vpg_memo;
+
+/* 1 = no block of [start, start + instrs) was stamped after `clock`. */
+static inline int rsx_vpg_clean(const uint64_t* blk, uint32_t nblk, uint32_t start, uint32_t instrs, uint64_t clock)
+{
+    if (!instrs) return 0;
+    const uint32_t b0 = start / RSX_VPG_BLOCK, b1 = (start + instrs - 1u) / RSX_VPG_BLOCK;
+    if (b1 >= nblk) return 0;
+    for (uint32_t b = b0; b <= b1; b++)
+        if (blk[b] > clock) return 0;
+    return 1;
+}
+
+/* The still-exact entry for the program at `start`, else NULL. */
+static inline const rsx_vpg_entry* rsx_vpg_find(rsx_vpg_memo* m, const uint64_t* blk, uint32_t nblk, uint32_t start)
+{
+    for (uint32_t i = 0; i < RSX_VPG_SLOTS; i++) {
+        const rsx_vpg_entry* e = &m->e[i];
+        if (!e->instrs || e->start != start) continue;
+        if (rsx_vpg_clean(blk, nblk, start, e->instrs, e->clock)) { m->hits++; return e; }
+        m->stale++;
+        return NULL;   /* one entry per start: a stale one is replaced by the next put */
+    }
+    return NULL;
+}
+
+/* Record the program at `start` as computed while the clock read `clock`. */
+static inline void rsx_vpg_put(rsx_vpg_memo* m, uint32_t start, uint32_t instrs, uint32_t txl, uint64_t h, uint64_t clock)
+{
+    rsx_vpg_entry* e = 0;
+    for (uint32_t i = 0; i < RSX_VPG_SLOTS && !e; i++)
+        if (m->e[i].instrs && m->e[i].start == start) e = &m->e[i];
+    if (!e) { e = &m->e[m->next]; m->next = (m->next + 1u) % RSX_VPG_SLOTS; }
+    e->start = start; e->instrs = instrs; e->txl = txl; e->h = h; e->clock = clock;
+    m->puts++;
+}
+
+#endif

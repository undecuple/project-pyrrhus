KZ2 patch 6077: LD_TEX_WW, the texture write watch. Default on (2026-11-10); LD_TEX_WW=0 off, =verify
decides as on but still hashes every texture the watch calls clean and counts a changed hash as [tex-ww-bad].

Root cause (rounds 85-86, [tex-hash] in b-walk's heavy view: 11-22 MB hashed per frame, tex-hash 1.6-1.8 ms/f): the
walker hashes cached textures because recompiled PPU stores into guest memory have no write signal. Patch 2033's
page bitmap covers the tracked writers (NV0039/NV3089/NV308A, surface write-backs, SPU DMA puts, the gv ring, file
reads), so the hash, the quiet span (LD_TEX_HASH_SPAN) and the clean rule's periodic net (LD_TEX_CLEAN, up to 30
frames late for an untracked writer) stand in for the missing one.

The OS write watch is the signal for every writer at once. port/kz2/main.cpp reserves guest memory with
MEM_WRITE_WATCH unless LD_TEX_WW=0 (one reservation, vm_base + guest address; no guest page is mapped twice), and
GetWriteWatch reports each 4 KB page written since its last reset, whoever wrote it: stores of any thread, interlocked
stores, ReadFile buffered and unbuffered (tools/runtime/ww_probe.sh checks each under Proton; costs there: 0.6 us per
query of a clean 40-page span, 0.4 us per first store after a reset). The GPU never writes guest memory (no heap is
opened on it). rsx_tex_ww.h keeps the bookkeeping: a collect queries a span with reset (at most 4,096 pages per call:
a full address array stops the reset where it filled) and stamps the written pages with a clock; an entry is armed
after a collect and before its bytes are read; it is clean while no page of its span carries a newer stamp. The
stamps keep a write that another entry's collect reset (shared pages). A clean entry keeps its cached decode, exactly
as if its hash had come back unchanged; any other decision hashes, arming first when the last hash found the texture
unchanged (quiet >= LD_TEX_WW_QUIET, default 1), so a texture rewritten every frame does not re-protect its pages
each frame. A clean decision stands for the rest of the frame, as a hash does through last_hash_frame (the old
rules' once-per-frame validation; a query at every bind cost ~1 s per 256 frames in the first s1 run). Without a host pointer, or if a query fails, the old rules decide. A missing write watch (LD_TEX_WW set
too late, or another host) prints "[tex-ww] off" and changes nothing. The collect time counts as tex-hash in
[perf-walk2]; [tex-ww] per 256 frames with RSX_PERF (decisions, clean, written, armed, unarmed, fail, bad, queries,
pages, ms).

Own design. Upstream ps3recomp #727 (tekulvw, page write watch through page protection and a vectored handler) was
read for the idea in an earlier change; nothing of it is used (MIT either way). Tests: tools/runtime/test_tex_ww.sh (directed
cases, a 400,000-step stress over overlapping spans with 0 false cleans; negative control TEST_NEG=1: per-entry
queries without stamps give false cleans).

diff --git a/libs/video/rsx_tex_ww.h b/libs/video/rsx_tex_ww.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_tex_ww.h
@@ -0,0 +1,95 @@
+/* KZ2 patch 6077: the texture write watch (LD_TEX_WW), the pure part.
+ *
+ * A cached texture is valid while no byte of its guest span was written since the bytes it was decoded from were
+ * read. The OS's write watch (VirtualAlloc MEM_WRITE_WATCH + GetWriteWatch) reports every page written since that
+ * page's last reset, whoever wrote it: recompiled PPU stores, HLE code, SPU DMA puts, surface write-backs, and the
+ * kernel itself (ReadFile into guest memory; checked under Proton by tools/runtime/ww_probe.sh). This header keeps the
+ * bookkeeping that turns per-range queries into a per-entry answer when several entries share pages:
+ *
+ *   - ld_ww_collect(range): GetWriteWatch(WRITE_WATCH_FLAG_RESET) over the range, at most LD_WW_BATCH pages per call
+ *     (a full address array would stop the reset where it filled); every reported page gets stamp = a new value of a
+ *     clock that advances only when a collect reports pages;
+ *   - ld_ww_arm(entry): right after a collect over the entry's range and BEFORE its bytes are read: entry.seq = clock;
+ *   - ld_ww_clean(entry): after a collect over the entry's range: no page of the range has a stamp newer than
+ *     entry.seq, so no write reached it since it was armed.
+ * A collect for one entry resets pages another entry shares; the stamps keep that write for the other entry, which is
+ * why a per-entry "query since my own reset" alone is wrong (the negative control in tools/runtime/test_tex_ww.c).
+ * Walker-only (one thread): the clock and the stamps need no atomics; the OS query is thread-safe against writers.
+ * Host test: tools/runtime/test_tex_ww.sh. */
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+
+#define LD_WW_PAGE_SHIFT 12u
+#define LD_WW_PAGE ((uintptr_t)1 << LD_WW_PAGE_SHIFT)
+#define LD_WW_PAGES (1u << 20)   /* 4 GB of guest address space in 4 KB pages */
+#ifndef LD_WW_BATCH
+#define LD_WW_BATCH 4096u        /* pages per query = the address array's length (tests make it small) */
+#endif
+
+/* GetWriteWatch(WRITE_WATCH_FLAG_RESET, base, size, addrs, count, ...): 0 on success, *count in/out. */
+typedef int (*ld_ww_query_fn)(void* base, size_t size, void** addrs, uintptr_t* count);
+
+typedef struct { uint64_t seq; uintptr_t lo; } ld_ww_arm_t;   /* seq 0 = not armed; lo = host address armed */
+
+typedef struct {
+    uint64_t* stamp;    /* LD_WW_PAGES entries, by (host - base) >> 12 */
+    uint64_t clock;     /* starts at 1 (0 means "never armed") */
+    uintptr_t base;     /* host address of guest address 0 */
+    ld_ww_query_fn query;
+    void* addrs[LD_WW_BATCH];
+    uint64_t calls, pages, fails;
+} ld_ww_state;
+
+static inline void ld_ww_init(ld_ww_state* st, uint64_t* stamp, uintptr_t base, ld_ww_query_fn q)
+{
+    st->stamp = stamp; st->clock = 1; st->base = base; st->query = q;
+    st->calls = st->pages = st->fails = 0;
+}
+
+/* Is [lo, lo+size) inside the watched guest space? */
+static inline int ld_ww_in_range(const ld_ww_state* st, uintptr_t lo, uint32_t size)
+{
+    return size && lo >= st->base && lo - st->base + size <= ((uint64_t)LD_WW_PAGES << LD_WW_PAGE_SHIFT);
+}
+
+/* Collect the writes to [lo, lo+size) into the stamps and reset the pages. 0 = the query failed (the caller hashes). */
+static inline int ld_ww_collect(ld_ww_state* st, uintptr_t lo, uint32_t size)
+{
+    if (!ld_ww_in_range(st, lo, size)) return 0;
+    uintptr_t a = lo & ~(LD_WW_PAGE - 1u);
+    const uintptr_t end = (lo + size + LD_WW_PAGE - 1u) & ~(LD_WW_PAGE - 1u);
+    int bumped = 0;
+    while (a < end) {
+        const uintptr_t n = end - a < ((uintptr_t)LD_WW_BATCH << LD_WW_PAGE_SHIFT)
+                                ? end - a : ((uintptr_t)LD_WW_BATCH << LD_WW_PAGE_SHIFT);
+        uintptr_t cnt = LD_WW_BATCH;
+        st->calls++;
+        if (st->query((void*)a, (size_t)n, st->addrs, &cnt) != 0 || cnt > LD_WW_BATCH) { st->fails++; return 0; }
+        if (cnt && !bumped) { st->clock++; bumped = 1; }
+        for (uintptr_t i = 0; i < cnt; i++) {
+            const uintptr_t p = (uintptr_t)st->addrs[i];
+            if (p < a || p >= a + n) { st->fails++; return 0; }   /* not ours: never trust the answer */
+            st->stamp[(p - st->base) >> LD_WW_PAGE_SHIFT] = st->clock;
+        }
+        st->pages += cnt;
+        a += n;
+    }
+    return 1;
+}
+
+/* After a collect over [lo, lo+size): arm the entry (its bytes are read after this). */
+static inline void ld_ww_arm(const ld_ww_state* st, ld_ww_arm_t* e, uintptr_t lo)
+{
+    e->seq = st->clock; e->lo = lo;
+}
+
+/* After a collect over [lo, lo+size): was the entry armed for this range, and has no write reached it since? */
+static inline int ld_ww_clean(const ld_ww_state* st, const ld_ww_arm_t* e, uintptr_t lo, uint32_t size)
+{
+    if (!e->seq || e->lo != lo || !ld_ww_in_range(st, lo, size)) return 0;
+    const uintptr_t p0 = (lo - st->base) >> LD_WW_PAGE_SHIFT, p1 = (lo - st->base + size - 1u) >> LD_WW_PAGE_SHIFT;
+    for (uintptr_t p = p0; p <= p1; p++)
+        if (st->stamp[p] > e->seq) return 0;
+    return 1;
+}

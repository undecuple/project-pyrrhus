+/* KZ2 patch 6077: LD_TEX_WW, the texture write watch. Default on (2026-11-10); LD_TEX_WW=0 off,
+ * LD_TEX_WW=verify decides as on but hashes every texture the watch calls clean and counts a changed hash as bad.
+ * Root cause: the walker hashes cached textures (an earlier change/86 b-walk heavy view: 11-22 MB per frame, tex-hash 1.6-1.8
+ * ms/f) because recompiled PPU stores into guest memory have no write signal; the tracked writers (patch 2033's page
+ * bitmap) miss them, so the hash, or the quiet span (LD_TEX_HASH_SPAN) and the clean rule's periodic net (LD_TEX_CLEAN,
+ * up to 30 frames late), stand in. The OS write watch is that signal for every writer at once: port/kz2/main.cpp
+ * reserves guest memory with MEM_WRITE_WATCH unless LD_TEX_WW=0, and GetWriteWatch reports each 4 KB page written
+ * since its last reset, whoever wrote it (user-mode stores of any thread, interlocked stores, ReadFile buffered or
+ * unbuffered: tools/runtime/ww_probe.sh, under Proton). Decision for a location 0/1 texture with a span:
+ *   - collect its span (rsx_tex_ww.h: query with reset, written pages stamped with a clock); armed and no page newer
+ *     than its arm: clean, the cached decode stays (exact: nothing wrote those bytes since they were read);
+ *   - otherwise hash, and arm first (the hash reads after the collect) if its last hash found it unchanged
+ *     (quiet >= LD_TEX_WW_QUIET, default 1), so a texture rewritten every frame does not re-protect its pages each
+ *     frame; such a one hashes every frame, as before.
+ * A clean decision stands for the rest of the frame (later binds of the entry in the same frame do not query again),
+ * as a hash's does through last_hash_frame: the once-per-frame validation of the old rules, at a query's cost (an earlier change
+ * s1 queried at every bind: 544 k queries per 256 frames, ~1 s). The old rules (span, clean, net) are not consulted for these textures; without a host pointer or when a query fails
+ * the old rule decides. The collect time is part of tex-hash in [perf-walk2]; [tex-ww] per 256 frames (RSX_PERF). */
+static ld_ww_state g_ld_ww;
+static int g_ld_ww_mode = -1;   /* 0 off, 1 on, 2 verify */
+static u32 g_ld_ww_pending;     /* verify: the decision in flight was called clean by the watch */
+static struct { u64 decisions, clean, written, armed, unarmed, fail, bad, qpc, repeat; } g_ld_wws;
+static int ld_ww_query_os(void* base, size_t size, void** addrs, uintptr_t* count)
+{
+    ULONG_PTR c = (ULONG_PTR)*count; ULONG gran = 0;
+    if (GetWriteWatch(WRITE_WATCH_FLAG_RESET, base, (SIZE_T)size, addrs, &c, &gran) != 0) return 1;
+    *count = (uintptr_t)c;
+    return 0;
+}
+static u32 ld_ww_quiet(void)
+{
+    static long q = -1;
+    if (q < 0) { const char* e = getenv("LD_TEX_WW_QUIET"); q = e ? atol(e) : 1; if (q < 0) q = 0; }
+    return (u32)q;
+}
+static int ld_ww_mode(void)
+{
+    if (g_ld_ww_mode < 0) {
+        const char* e = getenv("LD_TEX_WW");
+        int m = (e && e[0] == '0') ? 0 : (e && strcmp(e, "verify") == 0) ? 2 : 1;
+        if (m) {
+            extern uint8_t* vm_base;
+            void* a[1]; ULONG_PTR c = 1; ULONG gran = 0;
+            uint64_t* st = vm_base ? (uint64_t*)calloc(LD_WW_PAGES, sizeof(uint64_t)) : NULL;
+            /* the guest reservation must carry MEM_WRITE_WATCH (port/kz2/main.cpp: unless LD_TEX_WW=0) */
+            if (!st || GetWriteWatch(0, vm_base, 0x10000, a, &c, &gran) != 0) {
+                fprintf(stderr, "[tex-ww] off: guest memory is not write-watched (err=%lu); the hash rules decide\n",
+                        (unsigned long)GetLastError());
+                free(st);
+                m = 0;
+            } else {
+                ld_ww_init(&g_ld_ww, st, (uintptr_t)vm_base, ld_ww_query_os);
+                fprintf(stderr, "[tex-ww] %s, arm at quiet >= %u\n", m == 2 ? "verify" : "on", ld_ww_quiet());
+            }
+        }
+        g_ld_ww_mode = m;
+    }
+    return g_ld_ww_mode;
+}
+/* 0 = keep the cached decode, 1 = hash, -1 = no answer (the old rules decide). */
+static int ld_ww_due(u32 location, u32 offset, u32 span, u32 quiet, u32* written, u32* skip_frame, ld_ww_arm_t* ww)
+{
+    const u8* hp = guest_ptr(location, offset, span);
+    if (!hp) { ww->seq = 0; return -1; }
+    const uintptr_t lo = (uintptr_t)hp;
+    /* Checked clean earlier this frame: the decision stands for the frame, as a hash's does (last_hash_frame). */
+    if (ww->seq && ww->lo == lo && *skip_frame == g_ld_frames) { g_ld_wws.repeat++; return 0; }
+    const long long t0 = rsx_perf_enabled() ? rsx_perf_now() : 0;
+    const int ok = ld_ww_collect(&g_ld_ww, lo, span);
+    if (t0) {
+        const long long dt = rsx_perf_now() - t0;
+        g_ld_wws.qpc += (u64)dt;
+        if (rsx_perf_walk_on()) rsx_perf_add(RSX_PERF_W_TEX_HASH_T, dt);
+    }
+    g_ld_wws.decisions++;
+    if (!ok) { g_ld_wws.fail++; ww->seq = 0; return -1; }
+    if (ld_ww_clean(&g_ld_ww, ww, lo, span)) {
+        g_ld_wws.clean++;
+        *written = 0;   /* a tracked flag (64 KB pages) under a clean span: a neighbour's write, or one before the arm */
+        if (g_ld_ww_mode == 2) { g_ld_ww_pending = 1; return 1; }
+        if (*skip_frame != g_ld_frames) { *skip_frame = g_ld_frames; g_ld_th.skipped++; }
+        return 0;
+    }
+    if (ww->seq) { g_ld_wws.written++; *written = 1; }   /* a write the watch saw: a tracked change */
+    if (quiet >= ld_ww_quiet()) { ld_ww_arm(&g_ld_ww, ww, lo); g_ld_wws.armed++; }
+    else { ww->seq = 0; g_ld_wws.unarmed++; }
+    return 1;
+}

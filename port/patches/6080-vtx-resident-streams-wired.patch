+    if (!g_vr.n_blocks) { g_vr.fail++; return 0; }   /* no pool: the CPU path */
+    const u64 fv = g.fence_value;
+    u64 done = g.fence->lpVtbl->GetCompletedValue(g.fence);
+    if (done > fv) done = fv;   /* all ones = device removed: nothing counts as complete beyond what was signalled */
+    const u32 frame = (u32)(fv + 1u), completed = (u32)done;   /* stamped again at the record (vr_stamp) */

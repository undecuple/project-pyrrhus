+/* KZ2 patch 6082: vblank ticks against guest vblank-handler calls. The ticker marks a pending bit
+ * and the handler runs when a guest thread next pumps, so two ticks before one pump give one call; on the PS3 the
+ * handler runs once per vblank. Killzone 2's handler (1.29 0x48F40) counts down from 2 and writes label 0x49 = 1 at
+ * zero, and the frame end acquires label 0x49 == 1 (1.29 0x486A8..0x486CC): a 30 Hz gate that a lost call slows.
+ * Counted always (two atomics per tick / call); GCM_ACQ_STATS=1 prints them in 6081's [acq] line.
+ * GCM_VBLANK_EACH=1 (off by default until measured): one call per tick, at most 4 per pump (the rest counted lost). */
+static volatile u32 s_vb_ticks, s_vb_taken, s_vb_calls, s_vb_lost;
+/* KZ2 patch 6082: the acquire a drain stopped on (GCM_SEMA_ACQUIRE=1 only; 0 = none): label EA and wanted value. The
+ * frame thread then waits on its wake event instead of a plain 4 ms sleep, and the pump kicks it once a guest handler
+ * it ran has met the label (KZ2's vblank handler writes the frame gate's label 0x49), so the walker resumes at the
+ * write, as the RSX does, not up to 4 ms later. */
+static volatile u32 s_acq_wait_la, s_acq_wait_v;
+static void gcm_walker_kick(void);
+static int gcm_vblank_each(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("GCM_VBLANK_EACH"); on = e && atoi(e) != 0; }
+    return on;
+}
 

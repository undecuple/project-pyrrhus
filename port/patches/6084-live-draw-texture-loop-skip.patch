+/* rsx_tex_skip.h - KZ2 patch 6084: skip the live draw's 16-unit texture resolution when nothing it
+ * reads has changed since the draw that recorded it (LD_TEX_SKIP=1; =verify runs the loop anyway and compares).
+ *
+ * The walker's texture loop (rsx_live_draw.c, after the LD_UNITS block) decodes each of the 16 units from its 9 raw
+ * registers (0x1A00 + u*0x20 .. +0x1C and SIZE1 0x1840 + u*4: they fully determine rsx_dsp_texture), skips the units
+ * the fragment program does not use (patch 2045's unit mask), then resolves each: sampler key and slot (linear scan of
+ * the sampler cache), zeta-alias kind, the colour-surface scan, the zeta scan, and at last texture_srv_slot. An earlier change
+ * measured 56 % of heavy-view draws with all 16 units' registers unchanged from the draw before.
+ *
+ * A memo of the previous draw's resolution is reused when ALL of these hold:
+ *   - the 16 x 9 raw words are equal and the fragment program's unit mask is the same;
+ *   - the colour-surface and zeta generations are the same (bumped wherever a surface or a zeta gets a location,
+ *     offset or size) and the device is the same;
+ *   - the recording draw resolved every bound unit on the plain texture path, and no colour surface and no zeta sat at
+ *     any bound unit's address (so the surface scan, the feedback copy, the zeta snapshot and the window paths cannot
+ *     apply to any target, depth state or snapshot state while the generations stand).
+ * On a reuse the decoded units, the unit mask and the sampler slots (the sampler cache is append-only, so a key's
+ * slot never changes) come from the memo, and texture_srv_slot still runs for every bound unit: content coherence
+ * (write watch, per-frame hash, re-decode, LRU) is exactly as with the skip off.
+ *
+ * Pure C, no D3D12: rsx_live_draw.c and the host test tools/runtime/test_tex_skip.sh use it. */
+#ifndef RSX_TEX_SKIP_H
+#define RSX_TEX_SKIP_H
+#include <stdint.h>
+#include <string.h>
+
+#define LD_TSK_UNITS 16u
+#define LD_TSK_WORDS 9u
+
+typedef struct ld_tsk_memo {
+    int       valid;
+    const void* dev;                         /* the device the slots belong to */
+    uint32_t  fp_units;                      /* the fragment program's used-unit mask at record time */
+    uint32_t  surf_gen, zgen;                /* colour-surface and zeta generations at record time */
+    uint32_t  raw[LD_TSK_UNITS][LD_TSK_WORDS];
+    uint32_t  mask;                          /* units bound (texture_mask) */
+    uint32_t  smp[LD_TSK_UNITS];             /* sampler slots of the bound units */
+    uint64_t  hits, misses, unrecordable, verify_bad;
+} ld_tsk_memo;
+
+/* The per-draw switch: mode = LD_TEX_SKIP (0 off, 1 on, 2 verify); gated_off = a diagnostic that can change at run
+ * time (the zeta probe's gate, the a010 probe, the upload check, the alias-size log) is on for this draw. Such a draw
+ * runs the full loop unrecorded and keeps no units, so the memo it would leave stale is dropped here. */
+static inline int ld_tsk_begin(ld_tsk_memo* m, int mode, int gated_off)
+{
+    if (mode && gated_off) { m->valid = 0; return 0; }
+    return mode;
+}
+
+/* verify: 1 = the memo's decoded units equal the ones the full loop decoded, for every bound unit */
+static inline int ld_tsk_units_same(const void* memo_units, const void* fresh_units, uint32_t unit_size, uint32_t mask)
+{
+    const unsigned char* a = (const unsigned char*)memo_units; const unsigned char* b = (const unsigned char*)fresh_units;
+    for (uint32_t u = 0; u < LD_TSK_UNITS; u++)
+        if (((mask >> u) & 1u) && memcmp(a + (size_t)u * unit_size, b + (size_t)u * unit_size, unit_size) != 0) return 0;
+    return 1;
+}
+
+/* 1 = the memo applies to this draw */
+static inline int ld_tsk_match(const ld_tsk_memo* m, const uint32_t raw[LD_TSK_UNITS][LD_TSK_WORDS], uint32_t fp_units,
+                               uint32_t surf_gen, uint32_t zgen, const void* dev)
+{
+    return m->valid && m->dev == dev && m->fp_units == fp_units && m->surf_gen == surf_gen && m->zgen == zgen &&
+           memcmp(m->raw, raw, sizeof m->raw) == 0;
+}
+
+/* Record the draw just resolved. plain = every bound unit took the plain texture path and no colour surface or zeta
+ * sits at any bound unit's address; otherwise the memo is dropped (nothing reusable). */
+static inline void ld_tsk_record(ld_tsk_memo* m, const uint32_t raw[LD_TSK_UNITS][LD_TSK_WORDS], uint32_t fp_units,
+                                 uint32_t surf_gen, uint32_t zgen, const void* dev, int plain, uint32_t mask,
+                                 const uint32_t smp[LD_TSK_UNITS])
+{
+    if (!plain) { m->valid = 0; m->unrecordable++; return; }
+    memcpy(m->raw, raw, sizeof m->raw);
+    m->fp_units = fp_units; m->surf_gen = surf_gen; m->zgen = zgen; m->dev = dev; m->mask = mask;
+    for (uint32_t u = 0; u < LD_TSK_UNITS; u++) m->smp[u] = ((mask >> u) & 1u) ? smp[u] : 0u;
+    m->valid = 1;
+}
+
+/* verify: 1 = the memo's answer equals what the full loop resolved (mask, sampler slots of bound units, all plain) */
+static inline int ld_tsk_same(const ld_tsk_memo* m, uint32_t mask, const uint32_t smp[LD_TSK_UNITS], int plain)
+{
+    if (!plain || m->mask != mask) return 0;
+    for (uint32_t u = 0; u < LD_TSK_UNITS; u++)
+        if (((mask >> u) & 1u) && m->smp[u] != smp[u]) return 0;
+    return 1;
+}
+#endif

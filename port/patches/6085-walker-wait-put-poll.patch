+ * off by default). A drain pass walks up to the put it read at its start (s_wp_seen_put), and the sleep after it is
+ * a flat `ms` (4, port/kz2 main.cpp frame_clock) unless a park or an acquire wait is armed, so commands written
+ * during or just after a pass waited for the sleep to end, on the thread that bounds the frame. Measured
+ * in the Corinth Sands firefight (KZ3_PROF on rsx:frame): 26.6 % of the frame thread's samples under this wait, 11.2 %
+ * in the plain Sleep. With the switch the wait runs in <n> us slices (a high-resolution waitable timer together
+ * with the wake event; 0 = yield-spin) and returns 2 as soon as the control register's put differs from the one the
+ * last pass started from, or the armed park word differs from the word the walker stopped on (s_park_watch_w, however
+ * it was written; patch 7014's kick sees only writes that take the notify path). The acquire label (6082) is checked
+ * each slice too. Counters: cellGcm_walker_poll_counts (the port's [walker-poll] line). Upstream candidate. */
+static int gcm_park_watch_on(void);   /* patch 7014, below */
+static volatile u32 s_wp_seen_put;
+static volatile u32 s_park_watch_w;   /* tentative; defined with the park watch (patch 7014) below */
+static volatile u32 s_wp_n_put, s_wp_n_park;
+static int gcm_walker_poll_us(void)
+{
+    static int us = -2;
+    if (us == -2) { const char* e = getenv("KZ2_WALKER_POLL_US"); us = (e && *e) ? atoi(e) : -1; if (us > 4000) us = 4000; }
+    return us;
+}
+/* 1 = the put moved since the last pass began, 2 = the armed park word changed, 0 = nothing new.
+ * The park word is compared only while 7014's park watch is on: its arm is what stores s_park_watch_w, so with
+ * KZ2_PARK_WATCH=0 (or an off phase of KZ2_PARK_WATCH_TOGGLE) the stored word is stale, never equals the parked
+ * JUMP, and the test would end every slice at once. A park armed in an off phase and still parked when the watch
+ * turns on ends one slice early; the next pass re-arms it with the current word. */
+static int gcm_walker_work_pending(void)
+{
+    if (vm_read32(GCM_CONTROL_GUEST_ADDR + 0) != __atomic_load_n(&s_wp_seen_put, __ATOMIC_RELAXED)) return 1;
+    const u32 pe = __atomic_load_n(&s_park_wake_ea, __ATOMIC_ACQUIRE);
+    if (pe && gcm_park_watch_on() && vm_read32(pe) != __atomic_load_n(&s_park_watch_w, __ATOMIC_RELAXED)) return 2;
+    return 0;
+}

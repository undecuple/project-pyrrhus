+
+/* KZ2 patch 6086 (guest-validate, LD_GV_WW): one step for a consumer that keeps something derived from the bytes of
+ * [lo, lo+size) (the band hashes of a live surface) and wants to know whether to derive it again. Collects the range,
+ * then: 1 = nothing wrote the range since the entry was armed and the caller's own key (`same`: the geometry the
+ * derived data was made with) is unchanged, so the derived data still stands; 0 = derive again, the entry is armed
+ * now, BEFORE the caller reads the bytes, so a write that lands during the read is seen by the next call. A failed
+ * query disarms the entry and returns 0 (the caller derives again, as without the watch). */
+static inline int ld_ww_skip_or_arm(ld_ww_state* st, ld_ww_arm_t* e, uintptr_t lo, uint32_t size, int same)
+{
+    if (!ld_ww_collect(st, lo, size)) { e->seq = 0; return 0; }
+    if (same && ld_ww_clean(st, e, lo, size)) return 1;
+    ld_ww_arm(st, e, lo);
+    return 0;
+}

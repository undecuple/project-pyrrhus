KZ2 patch 6088: native macOS runtime portability.

Written for the Pyrrhus native Mac bring-up; no game code or RPCS3 code used.
Licence: MIT (project LICENSE).

- cellAudio and the SPURS LF queue include the toolkit's win32_compat.h instead of
  windows.h (on Windows it includes windows.h, so Windows builds see the same
  declarations); lv2_register.c includes ps3_evcv.h for its cross-platform wait.
- cellPad loads SDL3 as libSDL3.0.dylib on macOS (PS3RECOMP_SDL3_LIBRARY overrides),
  and off Windows the keyboard-remap menu command is a stub that says it is
  unavailable instead of an unresolved symbol.
- sys_event.c declares its semaphore-dump start flag only where it is used (Windows).
- cellSpurs.c gives Mach-O weak empty defaults for two optional port diagnostics.
Covered by the native build test (tools/runtime/test_macos_build.py); Windows code
paths are unchanged.

diff --git a/libs/audio/cellAudio.c b/libs/audio/cellAudio.c
--- a/libs/audio/cellAudio.c
+++ b/libs/audio/cellAudio.c
@@ -16,2 +16,3 @@
 #include "cellAudio.h"
+#include "../../runtime/platform/win32_compat.h" /* QPC diagnostics on POSIX too */
 #include "../../runtime/ppu/ppu_memory.h"   /* vm_base, vm_read64, vm_write32 */
diff --git a/libs/input/cellPad.c b/libs/input/cellPad.c
--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -958,5 +958,12 @@
 #else
-        void* m = dlopen("libSDL3.so.0", RTLD_NOW | RTLD_LOCAL);
+        #if defined(__APPLE__)
+# ifndef PS3RECOMP_SDL3_LIBRARY
+#  define PS3RECOMP_SDL3_LIBRARY "libSDL3.0.dylib"
+# endif
+        const char* lib = PS3RECOMP_SDL3_LIBRARY;
+#else
+        const char* lib = "libSDL3.so.0";
+#endif
+        void* m = dlopen(lib, RTLD_NOW | RTLD_LOCAL);
         #define PAD_SDL_SYM(n) (void (*)(void))dlsym(m, n)
-        const char* lib = "libSDL3.so.0";
 #endif
@@ -1159,2 +1166,13 @@
 }
+
+#ifndef _WIN32
+/* Keyboard remapping currently relies on the Windows key-capture backend.
+ * Report that limitation to the menu instead of leaving an unresolved symbol. */
+int pad_kb_ui_cmd(const char* cmd, char* out, size_t n)
+{
+    (void)cmd;
+    if (out && n) snprintf(out, n, "Keyboard remapping is unavailable on this platform; use a gamepad.");
+    return 0;
+}
+#endif
 

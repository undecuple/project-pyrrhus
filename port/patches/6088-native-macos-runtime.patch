diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -2028,4 +2028,11 @@
 /* The jm wait-loop classifier lives in the port (port/spu/kz3_fiber_stall.c); weak so the runtime links without it. */
+#ifdef __APPLE__
+/* Mach-O executables need definitions for optional port diagnostics. Strong
+ * port definitions can override these empty weak defaults. */
+__attribute__((weak)) int kz3_jm_pc_class(uint32_t pc) { (void)pc; return 0; }
+__attribute__((weak)) const char* kz3_jm_pc_class_name(int cls) { (void)cls; return ""; }
+#else
 extern int kz3_jm_pc_class(uint32_t pc) __attribute__((weak));
 extern const char* kz3_jm_pc_class_name(int cls) __attribute__((weak));
+#endif
 static void kz3_spurs_report_stuck_run(int j, int kt, u32 rw, u64 d, const char* tag)

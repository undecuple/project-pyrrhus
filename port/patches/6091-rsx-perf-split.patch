+/* KZ2 patch 6091 (RSX_PERF_SPLIT=1): exclusive walker buckets. A walk-owned clock charges every tick of one walk to
+ * exactly one bucket; the instrumented regions switch it (stack: enter/leave, flat: base). Off (the default):
+ * g_rsx_split_on is 0 and every site is one load and a not-taken branch. The buckets (RSX_SPB_*) and the clock's
+ * arithmetic are in rsx_perf_split.h. */
+#include "rsx_perf_split.h"
+extern volatile int g_rsx_split_on;
+extern volatile long long g_rsx_split_w_busy;    /* async-PSO worker ticks (compile + create), added by the workers */
+extern volatile double g_rsx_split_gpu_busy_ms, g_rsx_split_gpu_win_ms;   /* last GPU-busy window (RSX_PERF_GPU poller) */
+void rsx_split_enter(int b);   /* walker thread inside a walk only; anything else is ignored */
+void rsx_split_leave(void);
+void rsx_split_base(int b);    /* set the base bucket and drop any open enters (a skipped leave cannot leak) */
+#define LDS_IN(b)  do { if (g_rsx_split_on) rsx_split_enter(b); } while (0)
+#define LDS_OUT()  do { if (g_rsx_split_on) rsx_split_leave(); } while (0)
 extern volatile int g_rsx_perf_walk_on;    /* patch 6068: the flag itself, set by cellGcmSys.c's [perf] ticker */
 static inline int rsx_perf_walk_on(void) { return g_rsx_perf_walk_on; }   /* patch 2029: inside the RSX_PERF_PROF window */
 void      rsx_live_draw_perf_dump(void);       /* patch 2045: [perf-redecode] when the window closes */
diff --git a/libs/video/rsx_perf_split.h b/libs/video/rsx_perf_split.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_perf_split.h
@@ -0,0 +1,84 @@
+/* KZ2 patch 6091 (RSX_PERF_SPLIT=1): the exclusive-bucket clock behind [perf-split], as plain functions of a struct and a
+ * timestamp so the host test (tools/runtime/perf/test_perf_split_clock.sh) runs the same arithmetic the walker does.
+ * cellGcmSys.c owns the one instance, gates every call on the owner thread and passes rsx_perf_now().
+ *
+ * One walk at a time owns the clock (s_gcm_fifo_lock). Every clock read charges the ticks since the last read to the
+ * current bucket, so the buckets add up to (end - begin) + the lock wait (PARK) exactly. enter/leave nest (a stack of
+ * RSX_SPLIT_DEPTH, deeper enters are counted but fall back to OTHER on leave); base sets the bucket and drops any open
+ * enters (a skipped leave cannot leak past the next method boundary).
+ *
+ * Cost counters (after KZ3 patch 2203's [perf-split-cost], Project Helghast, same author and licence): commands and
+ * words walked through the method region, and the clock reads the split itself made, so a run can see what the split
+ * costs. They are plain adds on the owner's struct, published at the walk end. */
+#ifndef RSX_PERF_SPLIT_H
+#define RSX_PERF_SPLIT_H
+#include <stdio.h>
+#include <string.h>
+
+enum { RSX_SPB_OTHER = 0, RSX_SPB_DECODE, RSX_SPB_TEX, RSX_SPB_PSO, RSX_SPB_DESC, RSX_SPB_VPLAN, RSX_SPB_FILL,
+       RSX_SPB_REC, RSX_SPB_WB, RSX_SPB_RBWAIT, RSX_SPB_SUBMIT, RSX_SPB_PARK, RSX_SPB_BAR, RSX_SPB_N };
+#define RSX_SPLIT_DEPTH 16
+
+typedef struct rsx_split_clk {
+    int active, depth, cur;
+    unsigned char stk[RSX_SPLIT_DEPTH];
+    long long last, lockwait, acc[RSX_SPB_N];
+    unsigned long long words, cmds, reads;   /* this walk's cost counters */
+} rsx_split_clk;
+
+static inline void rsx_split_clk_charge(rsx_split_clk* c, long long now)
+{
+    c->acc[c->cur] += now - c->last;
+    c->last = now;
+    c->reads++;
+}
+static inline void rsx_split_clk_enter(rsx_split_clk* c, int b, long long now)
+{
+    rsx_split_clk_charge(c, now);
+    if (c->depth < RSX_SPLIT_DEPTH) c->stk[c->depth] = (unsigned char)c->cur;
+    c->depth++; c->cur = b;
+}
+static inline void rsx_split_clk_leave(rsx_split_clk* c, long long now)   /* an unmatched leave reads no clock */
+{
+    if (c->depth <= 0) return;
+    rsx_split_clk_charge(c, now);
+    c->depth--; c->cur = c->depth < RSX_SPLIT_DEPTH ? c->stk[c->depth] : RSX_SPB_OTHER;
+}
+static inline void rsx_split_clk_base(rsx_split_clk* c, int b, long long now)
+{
+    rsx_split_clk_charge(c, now);
+    c->depth = 0; c->cur = b;
+}
+/* t0: before the lock acquire; now: after it. The lock wait goes to PARK at the end. */
+static inline void rsx_split_clk_begin(rsx_split_clk* c, long long t0, long long now)
+{
+    memset(c, 0, sizeof *c);
+    c->lockwait = now - t0; c->last = now; c->cur = RSX_SPB_OTHER; c->reads = 1;
+    c->active = 1;
+}
+static inline void rsx_split_clk_end(rsx_split_clk* c, long long now)
+{
+    rsx_split_clk_charge(c, now);
+    c->acc[RSX_SPB_PARK] += c->lockwait;
+    c->active = 0;
+}
+static inline void rsx_split_clk_cmd(rsx_split_clk* c, unsigned words)   /* one method command of `words` data words */
+{
+    c->cmds++; c->words += words;
+}
+static inline long long rsx_split_clk_total(const rsx_split_clk* c)
+{
+    long long s = 0;
+    for (int i = 0; i < RSX_SPB_N; i++) s += c->acc[i];
+    return s;
+}
+/* [perf-split-cost]: per flip over the period, what the split costs in calls: method commands and their data words, and
+ * the clock reads the split made (two per command for the decode boundary, one per enter/leave/base, two per walk). */
+static inline int rsx_split_fmt_cost(char* out, size_t n, double t, long long flips, unsigned long long words,
+                                     unsigned long long cmds, unsigned long long reads)
+{
+    const double f = flips > 0 ? (double)flips : 1.0;
+    return snprintf(out, n, "[perf-split-cost] t=%.0fs flips=%lld words=%.0f commands=%.0f reads=%.0f\n", t, flips,
+                    (double)words / f, (double)cmds / f, (double)reads / f);
+}
+#endif

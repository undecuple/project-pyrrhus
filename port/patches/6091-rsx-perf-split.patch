+/* KZ2 patch 6091: the exclusive-bucket clock behind [perf-split] (arithmetic in rsx_perf_split.h). One walk at a time
+ * owns it (s_gcm_fifo_lock): the walk's own ticks land in the owner's local accumulators and are published at walk end
+ * together with the lock wait (PARK), so the published buckets add up to what RSX_PERF_WALK_T counts for the same walks.
+ * The existing gross timers (METH, DRAW, PSO, TEX... which nest through ld_flush) stay as they are; this clock is only
+ * the exclusive view of the same regions. Only the owner thread may move it: other threads' enters are ignored. */
+static rsx_split_clk s_sp;
+static unsigned long s_sp_tid;
+static volatile long long g_sp_pub[RSX_SPB_N];      /* published ticks per bucket, read by the reporter */
+static volatile unsigned long long g_sp_words, g_sp_cmds, g_sp_reads;   /* published cost counters ([perf-split-cost]) */
+static int rsx_split_mine(void) { return s_sp.active && s_sp_tid == (unsigned long)GetCurrentThreadId(); }
+void rsx_split_enter(int b)
+{
+    if (rsx_split_mine()) rsx_split_clk_enter(&s_sp, b, rsx_perf_now());
+}
+void rsx_split_leave(void)
+{
+    if (rsx_split_mine() && s_sp.depth > 0) rsx_split_clk_leave(&s_sp, rsx_perf_now());
+}
+void rsx_split_base(int b)
+{
+    if (rsx_split_mine()) rsx_split_clk_base(&s_sp, b, rsx_perf_now());
+}
+static void rsx_split_walk_begin(long long t0)       /* the fifo lock is held */
+{
+    s_sp_tid = (unsigned long)GetCurrentThreadId();
+    rsx_split_clk_begin(&s_sp, t0, rsx_perf_now());
+}
+static void rsx_split_walk_end(void)                 /* the fifo lock is still held */
+{
+    rsx_split_clk_end(&s_sp, rsx_perf_now());
+    for (int i = 0; i < RSX_SPB_N; i++) __atomic_fetch_add(&g_sp_pub[i], s_sp.acc[i], __ATOMIC_RELAXED);
+    __atomic_fetch_add(&g_sp_words, s_sp.words, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&g_sp_cmds, s_sp.cmds, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&g_sp_reads, s_sp.reads, __ATOMIC_RELAXED);
+}

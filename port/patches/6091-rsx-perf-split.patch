+/* KZ2 patch 6091: the [perf-split] and [perf-split-w] lines (two lines, newline-terminated, never past `n`). Values are
+ * ms per flip over the period: walk is RSX_PERF_WALK_T, the buckets are the clock's (sp[], ticks, indexed by
+ * RSX_SPB_*), pso includes the walker's wait on the async build workers (BAR, also shown as bar= on the -w line),
+ * other is the clock's OTHER bucket (walk minus every bucket named on the line). gpu is the RSX_PERF_GPU poller's
+ * last busy window scaled to this period, "na" when that poller has not published one. */
+static void gcm_split_line(char* out, size_t n, double t, long long flips, double wall_ms, double walk_ms,
+                           const long long* sp, long long wbusy, double tk, double gpu_busy_ms, double gpu_win_ms)
+{
+    const double f = flips > 0 ? (double)flips : 1.0;
+    char gpu[24];
+    if (gpu_win_ms > 0) snprintf(gpu, sizeof gpu, "%.2f", gpu_busy_ms / gpu_win_ms * wall_ms / f);
+    else snprintf(gpu, sizeof gpu, "na");
+    #define SPMS(b) ((double)sp[b] * tk / f)
+    int o = snprintf(out, n, "[perf-split] t=%.0fs flips=%lld frame=%.2f walk=%.2f decode=%.2f tex=%.2f pso=%.2f desc=%.2f"
+                     " vplan=%.2f fill=%.2f rec=%.2f wb=%.2f rbwait=%.2f submit=%.2f park=%.2f other=%.2f gpu=%s\n",
+                     t, flips, wall_ms / f, walk_ms / f, SPMS(RSX_SPB_DECODE), SPMS(RSX_SPB_TEX),
+                     SPMS(RSX_SPB_PSO) + SPMS(RSX_SPB_BAR), SPMS(RSX_SPB_DESC), SPMS(RSX_SPB_VPLAN), SPMS(RSX_SPB_FILL),
+                     SPMS(RSX_SPB_REC), SPMS(RSX_SPB_WB), SPMS(RSX_SPB_RBWAIT), SPMS(RSX_SPB_SUBMIT), SPMS(RSX_SPB_PARK),
+                     SPMS(RSX_SPB_OTHER), gpu);
+    if (o < 0 || (size_t)o >= n) { if (n) out[n - 1] = 0; return; }
+    snprintf(out + o, n - (size_t)o, "[perf-split-w] t=%.0fs flips=%lld busy=%.2f bar=%.2f\n", t, flips,
+             (double)wbusy * tk / f, SPMS(RSX_SPB_BAR));
+    #undef SPMS
+}

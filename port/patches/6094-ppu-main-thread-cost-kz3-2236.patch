+    }
+    const DWORD idx = s_ppu_tramp_idx;
+    if (idx == TLS_OUT_OF_INDEXES) return p;
+    if (TlsGetValue(idx) != (void*)p) { TlsSetValue(idx, (void*)p); InterlockedIncrement(&s_ppu_tramp_threads); }

+    void (**p)(void*) = &g_trampoline_fn;
+    /* lossy relaxed count (no locked add: with the slot off every access comes here) */
+    __atomic_store_n(&s_ppu_tramp_slow_calls, __atomic_load_n(&s_ppu_tramp_slow_calls, __ATOMIC_RELAXED) + 1, __ATOMIC_RELAXED);
+    if (s_ppu_tramp_state != 2) {
+        if (InterlockedCompareExchange(&s_ppu_tramp_state, 1, 0) == 0) {
+            const char* e = getenv("KZ2_TRAMP_TEB");
+            DWORD idx = (e && e[0] == '0') ? TLS_OUT_OF_INDEXES : TlsAlloc();
+            if (idx != TLS_OUT_OF_INDEXES && idx >= 64) { TlsFree(idx); idx = TLS_OUT_OF_INDEXES; }  /* expansion slots: no */
+            s_ppu_tramp_idx = idx;

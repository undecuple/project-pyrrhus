+ * (its emulated-TLS storage), so both paths reach the same per-thread object. KZ2_TRAMP_TEB=0: no slot (every
+ * access comes here and returns &g_trampoline_fn, the old storage through one more call). Defined in every MinGW
+ * x86-64 build, used only by a lifted tree built with the option. */
+#if defined(_WIN32) && defined(__GNUC__) && !defined(_MSC_VER) && defined(__x86_64__)
+extern "C" unsigned g_ppu_tramp_slot = 0;
+static volatile long s_ppu_tramp_state = 0;   /* 0 undecided, 1 deciding, 2 decided */
+static DWORD s_ppu_tramp_idx = TLS_OUT_OF_INDEXES;
+static unsigned long long s_ppu_tramp_slow_calls = 0;   /* [ppu-tls] counters (KZ3 2236) */
+static volatile long s_ppu_tramp_threads = 0;
+extern "C" void (**ppu_tramp_ref_slow(void))(void*)

+/* KZ2 patch 6095 (fps-why 2026-11-24 R5): ps3_indirect_call and its impl tested about fifteen
+ * getenv-cached switches on every indirect call (a load and a branch each, 4.1 % of ppu-main's samples with the
+ * rest of the diagnostics). None is set in play. One flag, decided at the first indirect call (after main has applied
+ * kz2.ini to the environment, as each switch was), now says whether any of them is set; when none is, the impl skips
+ * every diagnostic block, which with its switch unset did nothing. When one is set, every block runs exactly as
+ * before and still tests its own switch. Bit-exact: the same work, in the same order, whenever a switch is set; the
+ * same skipped work when none is. The list must name every getenv of ps3_indirect_call_entry and
+ * ps3_indirect_call_impl_at outside the cold addr == 0 path (PS3_NULL_CALL, PPU_OPD_RECOVER); the host test checks
+ * that against the source. ASSUMPTION (as patch 7003): nothing sets these variables after the first indirect call. */
+static const char* const s_icall_diag_env[] = {
+    "PPU_CSCHECK", "PS3_ICALL_GATE", "BCTRL_RING", "PS3_BREADCRUMB", "PPU_TOCWATCH", "PS3_CALLTRACE",
+    "PS3_CALLTRACE_LR", "PS3_CALLTRACE_TO", "PS3_CALLTRACE_FROM", "PS3_CALLTRACE_R5", "FLOW_FORCE_RTCFG",
+    "SPURS_TRACE", "PS3_PRX_CALLTRACE", "PPU_TOCFIX", "PPU_RETWATCH",
+};
+static int s_icall_diag = -1;   /* -1 undecided, 0 no switch set, 1 armed */
+static __attribute__((noinline, cold)) int ppu_icall_diag_decide(void)
+{
+    int armed = 0;
+    for (const char* n : s_icall_diag_env) if (getenv(n)) armed = 1;
+    ppu_cost_log_start();   /* patch 6094's counters, read at the first indirect call as before */
+    __atomic_store_n(&s_icall_diag, armed, __ATOMIC_RELAXED);
+    return armed;
+}
+static inline int ppu_icall_diag_armed(void)
+{
+    const int d = __atomic_load_n(&s_icall_diag, __ATOMIC_RELAXED);
+    return __builtin_expect(d < 0, 0) ? ppu_icall_diag_decide() : d;
+}

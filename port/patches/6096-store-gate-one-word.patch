@@ -228,9 +229,15 @@ PPU_ACC_INL int vm_mm_ok(const ppu_mm* m, uint32_t ea, uint32_t n)
 }
 PPU_ACC_INL int vm_mm_st_ok(const ppu_mm* m, uint32_t ea, uint32_t n)
 {
+#if defined(PPU_ST_GATE_WORD) && PPU_ST_GATE_WORD   /* KZ2 patch 6096 (KZ2_PPU_CMODEL_SMALL): one load for both */
+    if (!__builtin_expect(vm_mm_in(m->st_span, ea, n), 1) ||
+        __builtin_expect(g_ppu_st_gate != 0, 0))

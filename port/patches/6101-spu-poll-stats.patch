+/* ---- KZ2 patch 6101 begin: SPU poll counters (KZ2_SPU_POLL_STATS=1) ---- */
+/* KZ2 patch 6101: step 0 of the SPU poll backoff work (measure first). KZ2_SPU_POLL_STATS=1 counts, process-wide,
+ * the policy-module poll answers (cellSpursModulePoll at SPURS_PM_SELECT_WORKLOAD_LS: all of them, and the plain
+ * "no contention, keep running" answer) and the GETLLARs (all; the ones on the same line as this thread's previous
+ * GETLLAR; and those whose 128 bytes are also unchanged since that read: the re-reads a backoff would park), and
+ * prints one [spu-poll] line every 10 s with the rates. Off (default): one cached flag test at each point, nothing
+ * counted, nothing printed. Counters only, no behaviour change. */
+static int g_kz2_pps_on = -1;
+static volatile long long g_kz2_pps_pm, g_kz2_pps_pm_cont, g_kz2_pps_ll, g_kz2_pps_ll_same, g_kz2_pps_ll_unch;
+static volatile uint64_t g_kz2_pps_t0;
+static int kz2_pps_init(void)
+{
+    const char* e = getenv("KZ2_SPU_POLL_STATS");
+    int on = (e && e[0] == '1') ? 1 : 0;
+    if (on) { g_kz2_pps_t0 = spu_host_ns(); fprintf(stderr, "[spu-poll] counters on (KZ2_SPU_POLL_STATS=1)\n"); }
+    g_kz2_pps_on = on;
+    return on;
+}
+static inline int kz2_pps_on(void) { int v = g_kz2_pps_on; return v >= 0 ? v : kz2_pps_init(); }
+static void kz2_pps_tick(void)
+{
+    const uint64_t now = spu_host_ns(), t0 = g_kz2_pps_t0;
+    if (now - t0 < 10000000000ull) return;
+    if (!__sync_bool_compare_and_swap(&g_kz2_pps_t0, t0, now)) return;   /* one thread prints */
+    const double s = (double)(now - t0) / 1e9;
+    const long long pm = __sync_lock_test_and_set(&g_kz2_pps_pm, 0), pc = __sync_lock_test_and_set(&g_kz2_pps_pm_cont, 0);
+    const long long ll = __sync_lock_test_and_set(&g_kz2_pps_ll, 0), ls_ = __sync_lock_test_and_set(&g_kz2_pps_ll_same, 0);
+    const long long lu = __sync_lock_test_and_set(&g_kz2_pps_ll_unch, 0);
+    fprintf(stderr, "[spu-poll] %.1f s: pm-poll %.0f/s (continue %.0f/s) getllar %.0f/s same-line %.0f/s unchanged %.0f/s\n",
+            s, pm / s, pc / s, ll / s, ls_ / s, lu / s);
+}
+/* ---- KZ2 patch 6101 end ---- */
+

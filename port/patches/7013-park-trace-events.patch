KZ2 patch 7013 (diagnostic): GCM park events for patch 1085's trace hook (KZ2_FRAME_TRACE,
port/kz2/spu/kz2_frame_trace.c; tools/spu/park_trace.py): 42 = the walker stopped on a park (site = IO offset),
41 = an SPU put covered the park word (site = its EA, on the SPU's host thread), 43 = the walker went past the park. kz2_park_ea_peek() gives the armed park EA to the trace's sampler (44 = the word changed).
A park without a 41 was patched by a PPU store or before patch 6038's arm. Off: one load of the hook pointer.

--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -1103,6 +1103,21 @@
  * and cellGcm_walker_wait is the frame thread's sleep. A PPU store that patches a park is not seen: that wait still
  * ends at its timeout, as before. KZ2_PARK_WAKE=0 = off (the frame thread sleeps as before). */
 static volatile u32 s_park_wake_ea = 0;
+/* KZ2 patch 7013 (diagnostic): park events for patch 1085's trace hook (KZ2_FRAME_TRACE,
+ * port/kz2/spu/kz2_frame_trace.c): 42 = the walker stopped on a park (site = its IO offset), 41 = an SPU put covered
+ * the park word (site = its EA; on the SPU's host thread, so the job is the one running there), 43 = the walker
+ * went past the park (site = IO offset). A park with no 41 was patched by a PPU store (or before the arm). Off: one
+ * load of the hook pointer. */
+uint32_t kz2_park_ea_peek(void);   /* KZ2 patch 7013: the armed park word's EA (0 = none), for the trace's sampler */
+uint32_t kz2_park_ea_peek(void) { return __atomic_load_n(&s_park_wake_ea, __ATOMIC_ACQUIRE); }
+static inline void kz2_park_trace(int kind, u32 site)
+{
+    extern void (*g_kz3_wtrace)(const char*, int, uint32_t, uint64_t, uint64_t);
+    if (__builtin_expect(g_kz3_wtrace != 0, 0)) {
+        extern uint64_t kz3_wacct_now(void); extern void kz3_wacct_trace(int, uint32_t, uint64_t, uint64_t);
+        const uint64_t n = kz3_wacct_now(); kz3_wacct_trace(kind, site, n, n);
+    }
+}
 #ifdef _WIN32
 static HANDLE s_walker_wake;   /* auto-reset; created by cellGcm_walker_wait's first call */
 #endif

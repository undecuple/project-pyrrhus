+/* KZ2 patch 7014: see spu_coherency.h. Off (0): one relaxed load per notify. */
+volatile uint32_t g_spu_coh_kick_line = 0;
+void (*volatile g_spu_coh_kick_fn)(uint32_t line) = 0;
+static inline void spu_coh_kick_check(uint32_t line)
+{
+    if (__builtin_expect(__atomic_load_n(&g_spu_coh_kick_line, __ATOMIC_RELAXED) == line, 0) && line) {
+        void (*f)(uint32_t) = __atomic_load_n(&g_spu_coh_kick_fn, __ATOMIC_ACQUIRE);
+        if (f) f(line);
+    }
+}
 static void spu_coh_wake_watches(uint32_t line)

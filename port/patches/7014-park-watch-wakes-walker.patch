+ * writer takes the notify path) calls g_spu_coh_kick_fn(line) after the bytes have landed. The GCM walker sets it to
+ * the line of the park word it waits at (libs/video/cellGcmSys.c, KZ2_PARK_WATCH). */
+extern volatile uint32_t g_spu_coh_kick_line;
+extern void (*volatile g_spu_coh_kick_fn)(uint32_t line);

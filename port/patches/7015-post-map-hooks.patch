KZ2 patch 7015 (diagnostic): hooks for KZ2_POST_MAP (port/kz2/spu/kz2_post_map.c, tools/spu/post_map.py),
the map of the SPU post chain's data flow: g_kz2_pmap_dma is called for every SPU DMA GET (after the copy) and PUT
(before it) with the SPU context; g_kz2_pmap_surf for the live-draw walker's guest-surface events (first GPU write since
the surface's last write-back, write-back, texture bind, flip, guest sync point with its caller). Both pointers live in
runtime/diag/kz2_pmap_hooks.c (walker) and runtime/spu/spu_coherency.c (DMA), null unless KZ2_POST_MAP is set: one load per DMA and per event.
diff --git a/libs/video/rsx_live_draw.c b/libs/video/rsx_live_draw.c
--- a/libs/video/rsx_live_draw.c
+++ b/libs/video/rsx_live_draw.c
@@ -703,6 +703,16 @@
  * record) and nogpu (the record was never drawn to). Local surfaces count too (the sync-point write-back
  * of patch 2017 covers main memory only). Off: the SPU read hook is not even installed (cellGcmSys.c). */
 static int g_ld_pwd = -1;
+/* KZ2 patch 7015 (diagnostic): KZ2_POST_MAP (port/kz2/spu/kz2_post_map.c) sees the GPU writes, write-backs,
+ * texture binds and flips of guest surfaces. kind 0 = first GPU write since the surface's last write-back, 1 = write-back,
+ * 2 = texture bind (w/h/pitch of the texture; pitch = span), 3 = flip, 4 = guest sync point (offset = caller). Null = off. */
+extern void (*g_kz2_pmap_surf)(int kind, u32 location, u32 offset, u32 w, u32 h, u32 pitch, u32 texel);   /* kz2_pmap_hooks.c */
+static void ld_pmap_surf(int kind, u32 i)
+{
+    const surface_t* sf = &g.surfaces[i];
+    const u32 texel = sf->fmt == DXGI_FORMAT_R16G16B16A16_FLOAT ? 8u : 4u;
+    g_kz2_pmap_surf(kind, sf->location, sf->offset, sf->w, sf->h, sf->pitch ? sf->pitch : sf->w * texel, texel);
+}
 static volatile LONG g_ld_pwd_get[MAX_SURFACES][4];
 static u32 g_ld_pwd_gpu[MAX_SURFACES], g_ld_pwd_wb[MAX_SURFACES];
 static u32 g_ld_pwd_gpu_life[MAX_SURFACES], g_ld_pwd_wb_life[MAX_SURFACES], g_ld_pwd_key[MAX_SURFACES];
@@ -725,6 +735,7 @@
 }
 static void ld_pwd_note_writeback(u32 i)
 {
+    if (__builtin_expect(g_kz2_pmap_surf != 0, 0)) ld_pmap_surf(1, i);   /* KZ2 patch 7015 */
     if (!ld_pwd_enabled()) return;
     ld_pwd_rekey(i); g_ld_pwd_wb[i]++; g_ld_pwd_wb_life[i]++;
 }
@@ -747,6 +758,7 @@
 }
 static void ld_pwd_flip(void)
 {
+    if (__builtin_expect(g_kz2_pmap_surf != 0, 0)) g_kz2_pmap_surf(3, 0, 0, 0, 0, 0, 0);   /* KZ2 patch 7015 */
     if (!ld_pwd_enabled() || ++g_ld_pwd_frames % (u32)g_ld_pwd) return;
     for (u32 i = 0; i < MAX_SURFACES && i < g.n_surfaces; i++) {
         LONG c[4];
@@ -769,6 +781,8 @@

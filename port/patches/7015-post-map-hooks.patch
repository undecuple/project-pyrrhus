diff --git a/runtime/diag/kz2_pmap_hooks.c b/runtime/diag/kz2_pmap_hooks.c
new file mode 100644
--- /dev/null
+++ b/runtime/diag/kz2_pmap_hooks.c
@@ -0,0 +1,7 @@
+/* KZ2 patch 7015 (diagnostic): the walker hook KZ2_POST_MAP (port/kz2/spu/kz2_post_map.c) installs to
+ * map the SPU post chain's data flow: the GCM walker's guest-surface events (live draw: first GPU write since a
+ * write-back, write-back, texture bind, flip, guest sync point). Null = off: one load per event. The DMA hook,
+ * g_kz2_pmap_dma, is in runtime/spu/spu_coherency.c. */
+#include <stdint.h>
+void (*g_kz2_pmap_surf)(int kind, uint32_t location, uint32_t offset, uint32_t w, uint32_t h, uint32_t pitch,
+                        uint32_t texel) = 0;
diff --git a/runtime/spu/spu_coherency.c b/runtime/spu/spu_coherency.c
--- a/runtime/spu/spu_coherency.c
+++ b/runtime/spu/spu_coherency.c
@@ -629,4 +629,9 @@
 /* KZ3 patch 2084: the same for DMA GETs, installed only by the renderer's LD_POST_WB_DIAG diagnostic. */
 void (*g_spu_guest_read_hook)(uint32_t ea, uint32_t size) = 0;
 void spu_set_guest_read_hook(void (*hook)(uint32_t ea, uint32_t size)) { g_spu_guest_read_hook = hook; }
+/* KZ2 patch 7015 (diagnostic): KZ2_POST_MAP's DMA hook (port/kz2/spu/kz2_post_map.c), called for every
+ * GET after its copy and every PUT before it (spu_dma.h); here, with the other DMA hooks, so that every link of
+ * spu_dma.h has it. Null = off. */
+struct spu_context;
+void (*g_kz2_pmap_dma)(struct spu_context* spu, int put, uint32_t lsa, uint32_t ea, uint32_t size) = 0;
 void spu_set_guest_write_hook(void (*hook)(uint32_t ea, uint32_t size)) { g_spu_guest_write_hook = hook; }

 {
     const u32 remap = t->remap & 0xFFFF;
+    if (__builtin_expect(g_kz2_pmap_surf != 0, 0))   /* KZ2 patch 7015 */
+        g_kz2_pmap_surf(2, t->location, t->offset, t->width, t->height, texture_source_span(t), t->format);
     static int refresh_enabled = -1;
     if (refresh_enabled < 0)
         refresh_enabled = getenv("RSX_NO_TEX_REFRESH") ? 0 : 1;
@@ -18031,6 +18047,8 @@
 
 u32 rsx_live_draw_before_guest_sync(void)
 {
+    if (__builtin_expect(g_kz2_pmap_surf != 0, 0))   /* KZ2 patch 7015: offset = the caller */
+        g_kz2_pmap_surf(4, 0, (u32)((uintptr_t)__builtin_return_address(0) - (uintptr_t)GetModuleHandleA(NULL)), 0, 0, 0, 0);
     static int en = -1;

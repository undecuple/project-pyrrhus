 {
     if (target >= MAX_SURFACES) return;
+    if (__builtin_expect(g_kz2_pmap_surf != 0, 0) && target < g.n_surfaces && !g.surfaces[target].gv_gpu_dirty)
+        ld_pmap_surf(0, target);   /* KZ2 patch 7015: the first GPU write since the last write-back */
     g.surfaces[target].gv_pending = 1;
     g.surfaces[target].gv_dirty = 0;
     g.surfaces[target].gv_gpu_dirty = 1;
@@ -5639,6 +5653,8 @@

KZ2 patch 7016 (diagnostic, off by default): the same-run A/B phase and KZ2_POST_SKIP's runtime hooks.

g_kz2_ab_phase (runtime/spu/spu_coherency.c, with the other SPU hooks, so that every link of spu_dma.h and every
host-test link that has the switches has it): port/kz2/spu/kz2_ab_toggle.c's KZ2_AB_TOGGLE=<s> thread sets it every
<s> seconds (odd = on); a runtime switch whose environment value is "t" follows it (patches 7017-7019).
KZ2_POST_SKIP (diagnostic, wrong picture: the upper bound of moving the SPU post chain to the GPU): while
g_kz2_post_skip is set, an SPU DMA GET or PUT whose EA lies in [g_kz2_post_skip_lo, g_kz2_post_skip_hi) (the post
chain's arena: every post-chain DMA of 128 bytes or more, and nothing else's) copies nothing and completes;
rsx_live_draw_before_guest_sync leaves the surfaces there (S640, S320) out of its write-back; kz2_native_jobs.c's
Gfx.Post gates return at once. A plain return at the jobs' entry (KZ3 patch 1043's overlay skip) hangs the WWS job
list (the job's crt0 calls the policy module's job API; tried in kz2-spu31-post1), so the jobs themselves still run
their bookkeeping. Off = one load per DMA and per surface at the sync point.

diff --git a/libs/video/rsx_live_draw.c b/libs/video/rsx_live_draw.c
--- a/libs/video/rsx_live_draw.c
+++ b/libs/video/rsx_live_draw.c
@@ -18045,6 +18045,19 @@ static void ld_fake_post(u32 i)
     }
 }
 
+/* KZ2 patch 7016 (diagnostic): KZ2_POST_SKIP leaves the post chain's input surfaces (EA in
+ * [g_kz2_post_skip_lo, hi), spu_coherency.c) out of the sync point's write-back while its jobs are skipped. */
+static inline int ld_post_skip_wb(const surface_t* sf)
+{
+    extern volatile int g_kz2_post_skip; extern uint32_t g_kz2_post_skip_lo, g_kz2_post_skip_hi;
+    extern volatile long g_kz2_post_skip_wb_n;
+    if (__builtin_expect(!g_kz2_post_skip, 1)) return 0;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    const u32 ea = cellGcmResolveLocated(sf->location == 0u, sf->offset);
+    if (ea < g_kz2_post_skip_lo || ea >= g_kz2_post_skip_hi) return 0;
+    __atomic_fetch_add(&g_kz2_post_skip_wb_n, 1, __ATOMIC_RELAXED);
+    return 1;
+}
 u32 rsx_live_draw_before_guest_sync(void)
 {
     if (__builtin_expect(g_kz2_pmap_surf != 0, 0))   /* KZ2 patch 7015: offset = the caller */
@@ -18055,7 +18068,8 @@ u32 rsx_live_draw_before_guest_sync(void)
     u32 idx[64], n = 0, nlocal = 0;
     for (u32 i = 0; i < g.n_surfaces && n < 64; i++)
         if (g.surfaces[i].tex && g.surfaces[i].gv_gpu_dirty &&
-            (g.surfaces[i].location == 1u || ld_local_wb_wanted(&g.surfaces[i])))   /* KZ2 patch 6008 */
+            (g.surfaces[i].location == 1u || ld_local_wb_wanted(&g.surfaces[i])) &&   /* KZ2 patch 6008 */
+            !ld_post_skip_wb(&g.surfaces[i]))   /* KZ2 patch 7016 */
             { idx[n++] = i; if (g.surfaces[i].location == 0u) nlocal++; }
     if (!n) return 0;
     LDW_T0(wb_t0);

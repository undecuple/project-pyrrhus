  * spu_dma.h has it. Null = off. */
 struct spu_context;
 void (*g_kz2_pmap_dma)(struct spu_context* spu, int put, uint32_t lsa, uint32_t ea, uint32_t size) = 0;
+/* KZ2 patch 7016: the same-run A/B phase of port/kz2/spu/kz2_ab_toggle.c (KZ2_AB_TOGGLE=<s>): odd = on.
+ * A runtime switch whose environment value is "t" follows it (patches 7017-7019); 0 while no toggle runs.
+ * KZ2_POST_SKIP (diagnostic, wrong picture; kz2_ab_toggle.c sets these): while g_kz2_post_skip is set, SPU DMA whose
+ * EA lies in [g_kz2_post_skip_lo, hi) (the SPU post chain's arena) copies nothing (spu_dma.h), the walker's sync point
+ * does not write back the surfaces there (rsx_live_draw.c) and the Gfx.Post native gates return at once
+ * (kz2_native_jobs.c). Here, with the other DMA hooks, so that every link of spu_dma.h has them. */
+volatile int g_kz2_ab_phase = 0;
+volatile int g_kz2_post_skip = 0;
+uint32_t g_kz2_post_skip_lo = 0, g_kz2_post_skip_hi = 0;
+volatile long g_kz2_post_skip_dma_n = 0, g_kz2_post_skip_wb_n = 0;
 void spu_set_guest_write_hook(void (*hook)(uint32_t ea, uint32_t size)) { g_spu_guest_write_hook = hook; }

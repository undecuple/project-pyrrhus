-        if (_xm) _xr = spu__xr_fixv(_xr, _xa, _xb, _xm, op, 0); memcpy(&(r), &_xr, 16); } \
+        memcpy(&_xb, &(b), 16); if ((g_kz3_spu_xrq & 1) && g_kz3_spu_xr) _xr = spu__xrq(_xr, _xa, _xb, &_xm, op); \
+        if (_xm) { \
+            if (SPU_XRV_ON()) { /* KZ2 patch 7021 */ \
+                const __m128 _one = _mm_set1_ps(1.0f), _sg = _mm_castsi128_ps(_mm_set1_epi32((int)0x80000000u)); \
+                const __m128 _xn = (op) == SPU_XR_FM ? spu__xrv_fm(_xr, _xa, _xb, _xm) \
+                    : spu__xrv_fma(_xr, _xa, _one, (op) == SPU_XR_FS ? _mm_xor_ps(_xb, _sg) : _xb, _xm); \
+                _xr = (g_kz3_spu_xrq & 4) ? spu__xrv_check(_xn, spu__xr_fixv(_xr, _xa, _xb, _xm, op, 0), _xa, _xb, _xb, _xm, op) : _xn; \
+            } else _xr = spu__xr_fixv(_xr, _xa, _xb, _xm, op, 0); } \

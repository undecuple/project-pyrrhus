+/* KZ2 patch 7021: exact exponent-255 lanes in vector form. The 1071 lane code (spu__fa_lane,
+ * spu__fm_lane, spu__fma_lane: PR #287's) computes the exact sum or product and truncates it to 24 bits, saturating at
+ * +-Smax above 2^129 and giving +0 below 2^-126; an exponent-0 operand is zero. The same value from double arithmetic,
+ * four lanes per call: each word becomes the double with the same value (exponent 255 is just 2^128 here, exponent 0
+ * is +0; every single is exact in double, the range is far inside double's), the product p = a * b is exact (24 x 24
+ * bits), s = p + c and its rounding error e come from TwoSum (exact in round-to-nearest without overflow, whatever the
+ * gap), so the exact sum is s + e with |e| <= half an ulp of s. Truncated to 24 bits that is s with its low 29 mantissa
+ * bits cleared, one single ulp less (an integer -1 on the single's bits, which also steps down a binade from a power of
+ * two) when those bits are zero and e is non-zero with the other sign; |s| >= 2^129 saturates (also s = 2^129 minus a
+ * little: Smax either way), |s| < 2^-126 or a result exponent 0 gives +0, and so does s = 0. fa = a * 1 + b,
+ * fs = a * 1 + (b with its sign flipped), fm = a * b + 0, fma/fms/fnms with the sign flips of spu__fma_lane. Used
+ * only where the 1071 recompute ran (the lanes of m, with g_kz3_spu_xr on), only with bit 1 of g_kz3_spu_xrq
+ * (on by default since an earlier change; KZ2_SPU_XRV=0 = off, "t" = the same-run toggle) and only with the KZ3_SPU_XRSTATS / FMASTATS
+ * probes off, so the probes count the same lanes either way. Same bits as the 1071/1089 paths:
+ * tools/spu/test_spu_xrv.sh (every exponent-255 word against fixed partners, and wide random cases). KZ2's VertexJob
+ * normalising a zero-length vector (its squared length splatted to all four lanes, rsqrt estimate of 0 through fi,
+ * fm, fnms, fma; the product with the zero vector is 0) and UpdateJob's divide by a zero denominator (frest of 0, then
+ * fcgt on -Smax) send whole vectors here: an earlier change. */
+static inline __attribute__((always_inline)) __m128d spu__xrv_d(__m128i w) {   /* words 0 and 1 as exact doubles */
+    const __m128i W = _mm_cvtepu32_epi64(w);
+    const __m128i mag = _mm_slli_epi64(_mm_and_si128(W, _mm_set1_epi64x(0x7FFFFFFFll)), 29);
+    const __m128i sgn = _mm_slli_epi64(_mm_and_si128(W, _mm_set1_epi64x(0x80000000ll)), 32);
+    const __m128i d = _mm_or_si128(_mm_add_epi64(mag, _mm_set1_epi64x(896ll << 52)), sgn);
+    const __m128i z = _mm_cmpeq_epi64(_mm_and_si128(W, _mm_set1_epi64x(0x7F800000ll)), _mm_setzero_si128());
+    return _mm_castsi128_pd(_mm_andnot_si128(z, d));
+}
+static inline __attribute__((always_inline)) __m128i spu__xrv_half(__m128i a, __m128i b, __m128i c, int add) {
+    const __m128d p = _mm_mul_pd(spu__xrv_d(a), spu__xrv_d(b));
+    __m128d s = p;   /* fm (add = 0): the product is exact, nothing to add */
+    __m128i D, q, A;
+    if (add) {
+        const __m128d C = spu__xrv_d(c);
+        s = _mm_add_pd(p, C);
+        const __m128d bb = _mm_sub_pd(s, p);
+        const __m128d e = _mm_add_pd(_mm_sub_pd(p, _mm_sub_pd(s, bb)), _mm_sub_pd(C, bb));   /* TwoSum: s + e = p + C */
+        D = _mm_castpd_si128(s);
+        A = _mm_and_si128(D, _mm_set1_epi64x(0x7FFFFFFFFFFFFFFFll));
+        q = _mm_sub_epi64(_mm_srli_epi64(A, 29), _mm_set1_epi64x(896ll << 23));
+        const __m128i low0 = _mm_cmpeq_epi64(_mm_and_si128(D, _mm_set1_epi64x(0x1FFFFFFFll)), _mm_setzero_si128());
+        const __m128i opp = _mm_castpd_si128(_mm_cmplt_pd(_mm_mul_pd(e, s), _mm_setzero_pd()));   /* e != 0, other sign */
+        q = _mm_add_epi64(q, _mm_and_si128(low0, opp));                                            /* -1 where both */
+    } else {
+        D = _mm_castpd_si128(s);
+        A = _mm_and_si128(D, _mm_set1_epi64x(0x7FFFFFFFFFFFFFFFll));
+        q = _mm_sub_epi64(_mm_srli_epi64(A, 29), _mm_set1_epi64x(896ll << 23));
+    }
+    const __m128d as = _mm_castsi128_pd(A);
+    const __m128i tiny = _mm_castpd_si128(_mm_cmplt_pd(as, _mm_set1_pd(0x1p-126)));
+    const __m128i sat = _mm_castpd_si128(_mm_cmpge_pd(as, _mm_set1_pd(0x1p129)));
+    q = _mm_andnot_si128(tiny, q);
+    q = _mm_or_si128(_mm_andnot_si128(sat, q), _mm_and_si128(sat, _mm_set1_epi64x(0x7FFFFFFFll)));
+    return _mm_or_si128(q, _mm_and_si128(_mm_srli_epi64(D, 32), _mm_set1_epi64x(0x80000000ll)));   /* sign in bit 31 */
+}
+/* a * b + c (add = 1) or a * b (add = 0) on the lanes of m (bit i = word i), exact as above; the other lanes of r kept. */
+static inline __attribute__((always_inline)) __m128 spu__xrv_core(__m128 r, __m128 a, __m128 b, __m128 c, unsigned m, int add) {
+    const __m128i A = _mm_castps_si128(a), B = _mm_castps_si128(b), C = _mm_castps_si128(c);
+    const __m128i lo = spu__xrv_half(A, B, C, add);
+    const __m128i hi = spu__xrv_half(_mm_srli_si128(A, 8), _mm_srli_si128(B, 8), _mm_srli_si128(C, 8), add);
+    __m128i v = _mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(lo), _mm_castsi128_ps(hi), _MM_SHUFFLE(2, 0, 2, 0)));
+    const __m128i E = _mm_set1_epi32(0x7F800000);
+    v = _mm_andnot_si128(_mm_cmpeq_epi32(_mm_and_si128(v, E), _mm_setzero_si128()), v);        /* exponent 0 -> +0 */
+    const __m128i bit = _mm_setr_epi32(1, 2, 4, 8);
+    const __m128i sel = _mm_cmpeq_epi32(_mm_and_si128(_mm_set1_epi32((int)m), bit), bit);
+    return _mm_castsi128_ps(_mm_blendv_epi8(_mm_castps_si128(r), v, sel));
+}
+SPU_XR_COLD __m128 spu__xrv_fma(__m128 r, __m128 a, __m128 b, __m128 c, unsigned m) { return spu__xrv_core(r, a, b, c, m, 1); }
+SPU_XR_COLD __m128 spu__xrv_fm(__m128 r, __m128 a, __m128 b, unsigned m) { return spu__xrv_core(r, a, b, a, m, 0); }
+/* The compares on the lanes of m: spu__sf_key (exponent 0 = 0, else sign-magnitude as a signed integer, which fits
+ * int32) or spu__sf_mag, compared as integers. Inline: a few integer operations. */
+static inline __attribute__((always_inline)) __m128i spu__xrv_key(__m128i w, int mag) {
+    __m128i k = _mm_and_si128(w, _mm_set1_epi32(0x7FFFFFFF));
+    k = _mm_andnot_si128(_mm_cmpeq_epi32(_mm_and_si128(w, _mm_set1_epi32(0x7F800000)), _mm_setzero_si128()), k);
+    if (mag) return k;
+    const __m128i n = _mm_srai_epi32(w, 31);
+    return _mm_sub_epi32(_mm_xor_si128(k, n), n);
+}
+static inline __attribute__((always_inline)) u128 spu__xrv_cmp(u128 r, u128 a, u128 b, unsigned m, int op) {
+    __m128i R, A, B; memcpy(&R, &r, 16); memcpy(&A, &a, 16); memcpy(&B, &b, 16);
+    const int mag = op == SPU_XR_FCMEQ || op == SPU_XR_FCMGT;
+    const __m128i ka = spu__xrv_key(A, mag), kb = spu__xrv_key(B, mag);
+    const __m128i v = (op == SPU_XR_FCEQ || op == SPU_XR_FCMEQ) ? _mm_cmpeq_epi32(ka, kb) : _mm_cmpgt_epi32(ka, kb);
+    const __m128i bit = _mm_setr_epi32(1, 2, 4, 8);
+    R = _mm_blendv_epi8(R, v, _mm_cmpeq_epi32(_mm_and_si128(_mm_set1_epi32((int)m), bit), bit));
+    memcpy(&r, &R, 16); return r;
+}
+/* KZ2_SPU_XRV=c (diagnostic, bit 2 of g_kz3_spu_xrq): every vector that takes a 7021 path also runs the old one and
+ * keeps the old result; patch 1088's note (spu_drain.c) counts the vectors (op | 0x80) and logs the lanes that differ
+ * (op | 0xC0, with the new value as r): "[spu-xrv-check]" lines. The game's own operands, live. */
+SPU_XR_COLD __m128 spu__xrv_check(__m128 n, __m128 o, __m128 a, __m128 b, __m128 c, unsigned m, int op) {
+    u128 N, O, A, B, C; memcpy(&N, &n, 16); memcpy(&O, &o, 16); memcpy(&A, &a, 16); memcpy(&B, &b, 16); memcpy(&C, &c, 16);
+    unsigned d = 0;
+    for (int i = 0; i < 4; i++) d |= (unsigned)(N._u32[i] != O._u32[i]) << i;
+    kz3_spu_xr_note(op | 0x80, m, A._u32, B._u32, C._u32, N._u32, __builtin_return_address(0));
+    if (d) kz3_spu_xr_note(op | 0xC0, d, A._u32, B._u32, C._u32, N._u32, __builtin_return_address(0));
+    return o;
+}
+SPU_XR_COLD u128 spu__xrv_checku(u128 n, u128 o, u128 a, u128 b, u128 c, unsigned m, int op) {
+    __m128 N, O, A, B, C; memcpy(&N, &n, 16); memcpy(&O, &o, 16); memcpy(&A, &a, 16); memcpy(&B, &b, 16); memcpy(&C, &c, 16);
+    const __m128 r = spu__xrv_check(N, O, A, B, C, m, op);
+    u128 R; memcpy(&R, &r, 16); return R;
+}

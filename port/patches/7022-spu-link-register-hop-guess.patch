+/* KZ2 patch 7022: a guess the lifter took from a link register (`brsl rX` + `ai rX, rX, K`: the
+ * job libraries' interrupt-window idiom `brsl $r2, .+4 ; ai $r2, $r2, 8 ; bid|bie $r2`, 24 sites in
+ * Gfx.Particles.UpdateJob, 11 in VertexJob). The same test and tail call as SPU_IB_GUESS; KZ2_SPU_PCGUESS=1 turns
+ * them on (default off until measured), so a same-exe A/B compares them alone. Off: these hops go through
+ * spu_ib_direct's lookup as before. */
+extern int g_kz2_pcguess;                  /* spu_drain.c spu_hop_init */
+#define SPU_IB_GUESS_PC(ctx, G, F) if (g_kz2_pcguess > 0) { SPU_IB_GUESS(ctx, G, F) }
 /* SPU_IB_HOP with lift-time guesses (GUESSES = SPU_IB_GUESS(...) ...), tried after the bracket-return test */
 #define SPU_IB_HOP_G(ctx, T, GUESSES) do {                                                       \
         (ctx)->pc = (T);                                                                         \
